project Dmi is

   for Source_Dirs use ("src", "sim", "test/src");
   for Object_Dir use "obj";
   for Main use ("dmi.adb", "dmi_test.adb", "evc_sim.adb");

   package Ide is
      for Vcs_Kind use "git";
   end Ide;

   package Builder is
      for Switches ("ada") use ("-g", "-s");
   end Builder;

   package Compiler is
      for Switches ("ada") use ("-gnatVa", "-gnatwa", "-g");
   end Compiler;

   package Linker is
      for Switches ("ada") use ("-g");
   end Linker;

end Dmi;

