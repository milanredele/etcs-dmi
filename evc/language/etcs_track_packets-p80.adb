      E1.Q_MAMODE := To_Q_MAMODE (V);
   end Decode_D_MAMODE_Item;

   --  One item of D_MAMODE_List
   procedure Encode_D_MAMODE_Item
     (E1 : D_MAMODE_Item;
      W  : in out Writer)
     --  a contract, so that it is proved once, not inlined
     with Post => True
