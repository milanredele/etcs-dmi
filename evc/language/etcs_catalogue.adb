   ----------
   -- Skip --
   ----------

   procedure Skip (Direction : Direction_T;
                   R         : in out Reader;
                   OK        : out Boolean)
   is
      Start  : constant Natural := Position (R);
      V      : Interfaces.Unsigned_64;
      Length : Natural;
   begin
      Read (R, 8, V);                --  NID_PACKET
      if Direction = Track_To_Train then
         Read (R, 2, V);             --  Q_DIR
      end if;
      Read (R, 13, V);               --  L_PACKET
      Length := Natural (V);
      OK := not Failed (R)
        and then Length >= Header_Bits (Direction)
        and then Length <= Limit (R) - Start;
      if OK then
         Seek (R, Start + Length);
         OK := not Failed (R);
      end if;
   end Skip;

