   ----------
   -- Kind --
   ----------

   function Kind (Direction : Direction_T; NID : Natural)
     return Packet_Kind_T
   is
   begin
      case Direction is
         when Track_To_Train =>
            case NID is
               when 0 => return Track_P0;
               when 2 => return Track_P2;
               when 3 => return Track_P3;
               when 5 => return Track_P5;
               when 12 => return Track_P12;
               when 15 => return Track_P15;
               when 21 => return Track_P21;
               when 27 => return Track_P27;
               when 41 => return Track_P41;
               when 44 => return Track_P44;
               when 65 => return Track_P65;
               when 73 => return Track_P73;
               when 136 => return Track_P136;
               when 255 => return Track_P255;
               when others => return Unknown;
            end case;
         when Train_To_Track =>
            case NID is
               when 0 => return Train_P0;
               when 1 => return Train_P1;
               when 2 => return Train_P2;
               when 4 => return Train_P4;
               when 5 => return Train_P5;
               when 44 => return Train_P44;
               when others => return Unknown;
            end case;
      end case;
   end Kind;

   -------------
   -- Sent_By --
   -------------

   function Sent_By (Kind : Known_Kind_T) return Senders_T is
   begin
      case Kind is
         when Track_P0 =>
            return (True, False, False, False);
         when Track_P2 =>
            return (True, False, False, False);
         when Track_P3 =>
            return (True, False, True, False);
         when Track_P5 =>
            return (True, True, True, True);
         when Track_P12 =>
            return (True, True, False, True);
         when Track_P15 =>
            return (False, False, True, False);
         when Track_P21 =>
            return (True, True, True, True);
         when Track_P27 =>
            return (True, True, True, True);
         when Track_P41 =>
            return (True, True, True, True);
         when Track_P44 =>
            return (True, True, True, True);
         when Track_P65 =>
            return (True, True, True, True);
         when Track_P73 =>
            return (True, False, True, False);
         when Track_P136 =>
            return (True, True, False, True);
         when Track_P255 =>
            return (True, True, False, False);
         when Train_P0 =>
            return (False, False, True, True);
         when Train_P1 =>
            return (False, False, True, True);
         when Train_P2 =>
            return (False, False, True, True);
