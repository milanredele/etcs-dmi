            Read (R, 14, V);
            E1.NID_BG := To_NID_BG (V);
            Read (R, 1, V);
            E1.Q_LINKORIENTATION := To_Q_LINKORIENTATION (V);
            Read (R, 2, V);
            E1.Q_LINKREACTION := To_Q_LINKREACTION (V);
            Read (R, 6, V);
