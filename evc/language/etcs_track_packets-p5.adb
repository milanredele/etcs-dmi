      Read (R, 2, V);
      P.Q_DIR := To_Q_DIR (V);
      Read (R, 13, V);
      P.L_PACKET := To_L_PACKET (V);
      Read (R, 2, V);
      P.Q_SCALE := To_Q_SCALE (V);
      Read (R, 15, V);
      P.D_LINK := To_D_LINK (V);
      Read (R, 1, V);
      P.Q_NEWCOUNTRY := To_Q_NEWCOUNTRY (V);
