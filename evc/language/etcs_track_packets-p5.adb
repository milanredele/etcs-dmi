      P.Q_LINKORIENTATION := To_Q_LINKORIENTATION (V);
      Read (R, 2, V);
      P.Q_LINKREACTION := To_Q_LINKREACTION (V);
      Read (R, 6, V);
      P.Q_LOCACC := To_Q_LOCACC (V);
      Read (R, 5, V);
      P.N_ITER := To_N_ITER (V);
      for I1 in 1 .. Natural (P.N_ITER) loop
         declare
            E1 : D_LINK_Item renames P.D_LINK_List (I1);
         begin
            Read (R, 15, V);
            E1.D_LINK := To_D_LINK (V);
            Read (R, 1, V);
            E1.Q_NEWCOUNTRY := To_Q_NEWCOUNTRY (V);
            E1.Has_NID_C := E1.Q_NEWCOUNTRY = 1;
            if E1.Has_NID_C then
               Read (R, 10, V);
               E1.NID_C := To_NID_C (V);
