      Write (W, 2, Code (P.Q_SCALE));
      Write (W, 15, Code (P.D_GRADIENT));
      Write (W, 1, Code (P.Q_GDIR));
      Write (W, 8, Code (P.G_A));
      Write (W, 5, Code (P.N_ITER));
