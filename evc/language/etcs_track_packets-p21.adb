   procedure Decode (R  : in out Reader;
                     P  : out Packet_T;
                     OK : out Boolean)
   is
      Start : constant Natural := Position (R);
      V     : Unsigned_64;
   begin
      P := (others => <>);
      Read (R, 8, V);
      P.NID_PACKET := To_NID_PACKET (V);
      Read (R, 2, V);
      P.Q_DIR := To_Q_DIR (V);
      Read (R, 13, V);
      P.L_PACKET := To_L_PACKET (V);
      Read (R, 2, V);
      P.Q_SCALE := To_Q_SCALE (V);
      Read (R, 15, V);
