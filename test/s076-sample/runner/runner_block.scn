# Hand-written sequence for obj/evc_s076_run: the first steps of
# runner_pass.scn, then a radio message, an input of level 2 (phase
# E5): the runner reports the sequence blocked at step 10 and does
# not run step 11.
sequence runner_block
meta version 4.0.0 ; sv 30 ; feature 9000003
step 1 1 0.00 N/A NP I SIM N/A NP
  text: the on-board is switched on
input SIM power on
step 2 2 0.00 N/A NP O JRU N/A SB
  text: the mode Stand By is recorded
expect JRU record ALL M_MODE=6
step 3 3 0.00 N/A SB I TIU N/A SB
  text: the desk of cab A is opened
input TIU cab A active
step 4 4 0.00 N/A SB O DMI N/A SB
  text: the DMI shows Stand By
expect DMI mode-symbol displayed Stand-By
step 5 5 0.00 N/A SB O DMI N/A SB
  text: the DMI asks for the driver identity
expect DMI window displayed Driver-ID
step 6 6 0.00 N/A SB I DMI N/A SB
  text: the driver types an identity
input DMI enter Driver-ID
step 7 7 0.00 N/A SB O DMI N/A SB
  text: the DMI asks for the level
expect DMI window displayed Level
step 8 8 0.00 N/A SB I DMI L1 SB
  text: the driver chooses level 1
input DMI select Level-1
step 9 9 0.00 L1 SB O JRU L1 SB
  text: level 1 is recorded
expect JRU record ALL M_LEVEL=2
step 10 10 0.00 L1 SB I RTM L1 SB
  text: a radio message arrives (no session: phase E5)
input RTM message 24
step 11 11 0.00 L1 SB O DMI L1 SB
  text: never judged: the sequence is blocked at step 10
expect DMI mode-symbol displayed Stand-By
