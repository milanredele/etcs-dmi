sub Sub-step1
efs: Kernel.Level.Value.Value <- LevelEnum.L2
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S2.ExitState
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S3
expect efs: Kernel.Level.DataState == DataStateEnum.Valid
step Level is L3
sub Sub-step1
efs: Kernel.Level.Value.Value <- LevelEnum.L3
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S2.ExitState
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S3
