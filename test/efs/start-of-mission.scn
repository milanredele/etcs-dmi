sub SubStep2
efs: Testing.InitializeTerminals()
case Both level and position are valid
clause E4 done 5.4.3.2 D2 ; efs Entry 5.4.3.2.D2.1
step Valid level & position
sub Sub-step1
efs: Kernel.Level.DataState <- DataStateEnum.Valid
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.D3
case Invalid level
clause E4 done 5.4.3.2 D2 ; efs Entry 5.4.3.2.D2.2
step Valid level & position
sub Sub-step1
efs: Kernel.Level.DataState <- DataStateEnum.Invalid
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S2
case Invalid position
clause E4 done 5.4.3.2 D2 ; efs Entry 5.4.3.2.D2.2
step Valid level & position
sub Sub-step1
efs: Kernel.Level.DataState <- DataStateEnum.Valid
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
efs: BTM.LRBG.PreviousBaliseGroups <- []
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S2
case Invalid level and position
clause E4 done 5.4.3.2 D2 ; efs Entry 5.4.3.2.D2.2
step Valid level & position
sub Sub-step1
efs: Kernel.Level.DataState <- DataStateEnum.Invalid
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S2
case Invalid position, check Level & RBC Id or Phone number state change
clause - absent Entry 5.4.3.3.6 ; efs Entry 5.4.3.3.6
step Valid level
sub Sub-step1
efs: Kernel.Level.DataState <- DataStateEnum.Valid
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
expect efs: Kernel.Level.DataState == DataStateEnum.Invalid
