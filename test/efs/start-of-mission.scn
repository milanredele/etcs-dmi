efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.NoProcedure
sub SubStep2
efs: Testing.InitializeTerminals()
case Propose Non Leading in S20
clause - absent Entry 5.4.3.3.19 ; efs Entry 5.4.3.3.19
clause E4 done 5.4.5.3 f) ; efs 5.4.5.3.f
step Non leading is proposed in S20
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S20
efs: Testing.SetSBMode(False)
set train.data_state valid
efs: TIU.NonLeadingPermitted <- True
expect efs: DMI.MasterDMI().In_NonLeadingRequest.InputInformation.RequestStatus == RequestEnum.Request
step Driver elects to go in non leading mode, valid position
sub Go to state S20
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S20
efs: Testing.SetSBMode( HandleModeChange => False )
sub Train data is valid
efs: DMI.MasterDMI().In_NonLeadingRequest.ProvideDriverResponse()
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
efs: TIU.NonLeadingPermitted <- True
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.NoProcedure
expect efs: Kernel.TrainPosition.Position.DataState == DataStateEnum.Valid
expect efs: DMI.MasterDMI().In_NonLeadingRequest.InputInformation.RequestStatus == RequestEnum.Disabled
step Driver elects to go in non leading mode, invalid position
sub Go to state S20
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S20
efs: Testing.SetSBMode( HandleModeChange => False )
sub Train data is invalid
efs: DMI.MasterDMI().In_NonLeadingRequest.ProvideDriverResponse()
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: BTM.LRBG.PreviousBaliseGroups <- []
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.NoProcedure
expect efs: Kernel.TrainPosition.Position.DataState == DataStateEnum.Unknown
expect efs: DMI.MasterDMI().In_NonLeadingRequest.InputInformation.RequestStatus == RequestEnum.Disabled
