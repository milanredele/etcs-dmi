end init
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.NoProcedure
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
set nv D_NVSTFF 450.0
sub SubStep2
efs: Testing.InitializeTerminals()
case Request acknowledgement for SR mode, valid train position
clause E4 done 5.4.3.2 S24 ; efs Entry 5.4.3.2.S24
clause E4 done 5.4.3.2 S24 ; efs Entry 5.4.3.2.S24.1
clause - absent 5.4.6.1 ; efs 5.4.6.1
step Ack SR, valid train position
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S24
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
efs: Testing.SetSBMode(False)
expect efs: DMI.MasterDMI().In_AcknOfSRMode.InputInformation.RequestStatus == RequestEnum.Request
expect efs: Kernel.MissionIsOngoing == False
step Receive ack, keep train position valid
sub Sub-step1
efs: DMI.MasterDMI().In_AcknOfSRMode.ProvideDriverResponse()
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.NoProcedure
expect efs: Kernel.Mode == ModeEnum.SR
expect efs: DMI.MasterDMI().In_AcknOfSRMode.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: Kernel.TrainPosition.Position.DataState == DataStateEnum.Valid
expect efs: Kernel.MissionIsOngoing
case Request acknowledgement for SR mode, invalid train position
clause E4 done 5.4.3.2 S24 ; efs Entry 5.4.3.2.S24
clause E4 done 5.4.3.2 S24 ; efs Entry 5.4.3.2.S24.1
clause E4 done 5.4.3.2 S24 ; efs Entry 5.4.3.2.S24.2
clause - absent 5.4.6.1 ; efs 5.4.6.1
clause - absent Entry 5.4.3.3.18 ; efs Entry 5.4.3.3.18
step Ack SR, invalid train position
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedureSM.StartOfMission.S24
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: Testing.SetSBMode(False)
efs: Kernel.MissionIsOngoing <- False
efs: BTM.LRBG.PreviousBaliseGroups <- []
sub Sub-step2
expect efs: DMI.MasterDMI().In_AcknOfSRMode.InputInformation.RequestStatus == RequestEnum.Request @ deadline=2
step Receive ack, set train position as unknown
sub Sub-step1
efs: DMI.MasterDMI().In_AcknOfSRMode.ProvideDriverResponse()
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.NoProcedure
expect efs: Kernel.Mode == ModeEnum.SR
expect efs: DMI.MasterDMI().In_AcknOfSRMode.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: Kernel.TrainPosition.Position.DataState == DataStateEnum.Unknown
expect efs: Kernel.MissionIsOngoing
