expect efs: DMI.MasterDMI().In_NonLeadingRequest.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: Kernel.TrainPosition.Position.DataState == DataStateEnum.Unknown
step Driver selects SH (E12), Level NTC
