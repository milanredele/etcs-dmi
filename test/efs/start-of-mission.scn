efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.ContactData.DataState <- DataStateEnum.Invalid
efs: Kernel.Level.DataState <- DataStateEnum.Invalid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
