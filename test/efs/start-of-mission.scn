efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.NoProcedure
case Propose to re-enter train running number in S10
clause E4 done 5.4.5.3 c) ; efs 5.4.5.3.c
step Re-enter train running number is proposed in S10
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S10
efs: Testing.SetSBMode(False)
efs: Kernel.TrainRunningNumber.Value <- '5645'
efs: Kernel.TrainRunningNumber.DataState <- DataStateEnum.Valid
efs: DMI.MasterDMI().In_TrainRunningNumber.InputInformation.RequestStatus <- RequestEnum.Disabled
expect efs: DMI.MasterDMI().In_TrainRunningNumberEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
step Driver elects to re-enter train running number => train running number screen is displayed
sub Sub-step1
efs: DMI.MasterDMI().In_TrainRunningNumberEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_TrainRunningNumber.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
expect efs: DMI.MasterDMI().In_TrainRunningNumberEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_TrainRunningNumber.DriverAction.Enter == True
expect efs: DMI.MasterDMI().In_TrainRunningNumber.DriverAction.ReValidate == False
expect efs: DMI.MasterDMI().In_TrainRunningNumber.Number == '5645'
step Driver enters the train running number information
sub Sub-step1
efs: DMI.MasterDMI().In_TrainRunningNumber.ProvideDriverResponse ( aNumber => '1234' )
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedureSM.StartOfMission.S10
expect efs: Kernel.TrainRunningNumber.Value == '1234'
expect efs: DMI.MasterDMI().In_TrainRunningNumber.InputInformation.RequestStatus == RequestEnum.Disabled
step We are still in S10
sub Sub-step1
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S10
case Propose to re-enter train running number in S20
clause E4 done 5.4.5.3 c) ; efs 5.4.5.3.c
step Re-enter train running number is proposed in S20
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S20
efs: Testing.SetSBMode(False)
efs: Kernel.TrainRunningNumber.Value <- '5645'
