efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.NoProcedure
sub SubStep2
efs: Testing.InitializeTerminals()
case Offer selection of SH, NL or Data Entry
clause E4 partial 5.4.3.2 S10 ; efs Entry 5.4.3.2.S10
step Offer possibility to select SH, NL or Data Entry
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S10
efs: TIU.NonLeadingPermitted <- True
expect efs: DMI.MasterDMI().In_TrainDataEntryRequest.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_ShuntingRequest.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_NonLeadingRequest.InputInformation.RequestStatus == RequestEnum.Request
expect efs: Kernel.MissionIsOngoing == False
case Driver selects SH
clause E4 partial 5.4.3.2 S10 ; efs Entry 5.4.3.2.S10.1
clause - absent Entry 5.4.3.3.18 ; efs Entry 5.4.3.3.18
step Driver selects SH (E12), Level 0
