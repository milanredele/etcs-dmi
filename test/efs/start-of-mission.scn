efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
expect efs: Kernel.Level.DataState == DataStateEnum.Unknown
step Unknown RBC phone number
sub Sub-step1
efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.ContactData.DataState <- DataStateEnum.Unknown
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.ContactData.DataState== DataStateEnum.Unknown
