case Inform failure of the Radio Network registration
clause E4 done 5.4.3.2 A29 ; efs Entry 5.4.3.2.A29
step In S3, driver selected to Reenter Network Id
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
efs: DMI.MasterDMI().In_RBCContactInformation.DriversSelectedAction <- DMI.RBCContactActionEnum.ReenterNetworkId
efs: DMI.MasterDMI().In_RBCContactInformation.InputInformation.RequestStatus <- Default.RequestEnum.Response
step Network Ids received
sub SubStep1
efs: EURORADIO.RBCConnection.Contact.AvailableNetworks.RequestState <- RequestEnum.Response
step No network available
sub SubStep1
efs: EURORADIO.RBCConnection.Contact.AvailableNetworks.Networks <- []
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.A29
step Display request and move to S10
sub SubStep1
expect efs: DMI.MasterDMI(). Out_RadioNetworkRegistrationFailed.OutputInformation.DisplayRequested
