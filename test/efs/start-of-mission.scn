efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.NoProcedure
case Request level if unknown or invalid
clause E4 done 5.4.3.2 S2 ; efs Entry 5.4.3.2.S2.2
clause E4 done 5.4.3.2 S2 ; efs Entry 5.4.3.2.S2.1
step Request level : Unknown level
sub Sub-step1 - Level entry is proposed
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedureSM.StartOfMission.S2
efs: Kernel.Level.DataState <- DataStateEnum.Unknown
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevelEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Sub-step2 - The driver enters the level
efs: DMI.MasterDMI().In_ErtmsEtcsLevelEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.Level.Value == LevelEnum.Unknown
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.DriverAction.Enter == True
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.DriverAction.ReValidate == False
step Request level : Invalid level
sub Sub-step1 - Level entry is proposed
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedureSM.StartOfMission.S2
efs: Kernel.Level.Value.Value <- LevelEnum.L1
efs: Kernel.Level.DataState <- DataStateEnum.Invalid
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevelEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Sub-step1 - The driver validates the level
efs: DMI.MasterDMI().In_ErtmsEtcsLevelEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.Level.Value == LevelEnum.L1
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.DriverAction.Enter == True
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.DriverAction.ReValidate == True
step Do not request level : Valid level
sub Sub-step1
efs: Kernel.Level.DataState <- DataStateEnum.Valid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S2.OfferLevelSelection
efs: Kernel.Level.Value.Value <- LevelEnum.L1
efs: DMI.MasterDMI().In_ErtmsEtcsLevel.InputInformation.RequestStatus <- RequestEnum.Disabled
expect efs: DMI.MasterDMI().In_ErtmsEtcsLevel.InputInformation.RequestStatus == RequestEnum.Disabled
case Selected level is L2 or L3
clause - absent Entry 5.4.3.3.8 ; efs Entry 5.4.3.3.8
clause - absent Entry 5.4.3.3.9 ; efs Entry 5.4.3.3.9
clause E4 done 5.4.3.2 S2 ; efs Entry 5.4.3.2.S2.3
