efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.NoProcedure
case Initial state: data entry proposed
clause E4 done 5.4.3.2 S1 ; efs Entry 5.4.3.2.S1.1
clause E4 done 5.4.3.2 S1 ; efs Entry 5.4.3.2.S1.2
clause E4 done 5.4.3.2 S1 ; efs Entry 5.4.3.2.S1.3
step Data entry is proposed
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S1
efs: Kernel.DriverId <- Kernel.DriverIdStruct{ Value => '12345', DataState => DataStateEnum.Valid }
expect efs: DMI.MasterDMI().In_DriverIdEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
expect efs: DMI.MasterDMI().In_VirtualBaliseCoverEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
expect efs: DMI.MasterDMI().In_TrainRunningNumberEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
case Entry of unknown driver id
clause E4 done 5.4.3.2 S1 ; efs Entry 5.4.3.2.S1.1
clause - absent Entry 5.4.3.3.2 ; efs Entry 5.4.3.3.2
step Driver id is unknown
sub Sub-step1
efs: Kernel.DriverId.DataState <- DataStateEnum.Unknown
efs: Kernel.DriverId.Value <- 'Hans'
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S1
step Driver asks to enter the driver id
sub Sub-step1
efs: DMI.MasterDMI().In_DriverIdEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_DriverId.DriverAction.Enter == True
expect efs: DMI.MasterDMI().In_DriverId.DriverAction.ReValidate == False
expect efs: DMI.MasterDMI().In_DriverId.Id == ''
expect efs: DMI.MasterDMI().In_DriverId.InputInformation.RequestStatus == RequestEnum.Request
step Drivers enters the data => driver id is validated and stored on board, the procedure goes to D2
sub Sub-step1
efs: DMI.MasterDMI().In_DriverId.ProvideDriverResponse ( anId => 'Fred' )
expect efs: Kernel.DriverId.DataState == DataStateEnum.Valid
expect efs: Kernel.DriverId.Value == 'Fred'
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.D2 @ deadline=1
expect efs: DMI.MasterDMI().In_TrainRunningNumber.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_DriverId.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_VirtualBaliseCover.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
case Entry of invalid driver id
clause E4 done 5.4.3.2 S1 ; efs Entry 5.4.3.2.S1.1
clause - absent Entry 5.4.3.3.3 ; efs Entry 5.4.3.3.3
step Driver id is invalid
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S1
efs: Kernel.DriverId.DataState <- DataStateEnum.Invalid
efs: Kernel.DriverId.Value <- 'Hans'
step Driver asks to enter the driver id
sub Sub-step1
efs: DMI.MasterDMI().In_DriverIdEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_DriverId.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
expect efs: DMI.MasterDMI().In_DriverId.DriverAction.Enter == True @ deadline=1
expect efs: DMI.MasterDMI().In_DriverId.Id == 'Hans' @ deadline=1
expect efs: DMI.MasterDMI().In_DriverId.DriverAction.ReValidate == True @ deadline=1
step Drivers enters the data => driver id is validated and stored on board, the procedure goes to D2
sub Sub-step1
efs: DMI.MasterDMI().In_DriverId.ProvideDriverResponse ( anId => 'Fred' )
expect efs: Kernel.DriverId.DataState == DataStateEnum.Valid
expect efs: Kernel.DriverId.Value == 'Fred'
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.D2 @ deadline=1
expect efs: DMI.MasterDMI().In_TrainRunningNumber.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_VirtualBaliseCover.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_DriverId.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
case Entry of unknown train running number
clause E4 done 5.4.3.2 S1 ; efs Entry 5.4.3.2.S1.2
clause - absent Entry 5.4.3.3.4 ; efs Entry 5.4.3.3.4
step Train running number is unknown
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedureSM.StartOfMission.S1
efs: Kernel.TrainRunningNumber.DataState <- DataStateEnum.Unknown
efs: Kernel.TrainRunningNumber.Value <- '1234'
step Driver asks to enter the train running number
sub Sub-step1
efs: DMI.MasterDMI().In_TrainRunningNumberEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_VirtualBaliseCoverEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_DriverIdEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_TrainRunningNumber.DriverAction.Enter == True
expect efs: DMI.MasterDMI().In_TrainRunningNumber.DriverAction.ReValidate == False
expect efs: DMI.MasterDMI().In_TrainRunningNumber.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_TrainRunningNumber.Number == ''
step Drivers enters the data => train running number is validated and stored on board, the procedure goes back to the initial state
sub Sub-step1
efs: DMI.MasterDMI().In_TrainRunningNumber.ProvideDriverResponse ( aNumber => '4567' )
expect efs: Kernel.TrainRunningNumber.DataState == DataStateEnum.Valid
expect efs: Kernel.TrainRunningNumber.Value == '4567'
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S1.AskToEnterValues @ deadline=1
case Entry of invalid train running number
clause E4 done 5.4.3.2 S1 ; efs Entry 5.4.3.2.S1.2
clause - absent Entry 5.4.3.3.5 ; efs Entry 5.4.3.3.5
step Train running number is invalid
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S1
efs: Kernel.TrainRunningNumber.DataState <- DataStateEnum.Invalid
efs: Kernel.TrainRunningNumber.Value <- '1234'
step Driver asks to enter the train running number
sub Sub-step1
efs: DMI.MasterDMI().In_TrainRunningNumberEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_VirtualBaliseCoverEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_DriverIdEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_TrainRunningNumber.DriverAction.Enter == True
expect efs: DMI.MasterDMI().In_TrainRunningNumber.DriverAction.ReValidate == True
expect efs: DMI.MasterDMI().In_TrainRunningNumber.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_TrainRunningNumber.Number == '1234'
step Drivers enters the data => train running number is validated and stored on board, the procedure goes back to the initial state
sub Sub-step1
efs: DMI.MasterDMI().In_TrainRunningNumber.ProvideDriverResponse ( aNumber => '4567' )
expect efs: Kernel.TrainRunningNumber.DataState == DataStateEnum.Valid
expect efs: Kernel.TrainRunningNumber.Value == '4567'
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S1.AskToEnterValues @ deadline=1
case Entry of virtual balise cover
clause E4 done 5.4.3.2 S1 ; efs Entry 5.4.3.2.S1.3
step Virtual balise cover entry is proposed
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedureSM.StartOfMission.S1
expect efs: DMI.MasterDMI().In_VirtualBaliseCoverEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
step Driver asks to enter the virtual balise cover
sub Sub-step1
efs: DMI.MasterDMI().In_VirtualBaliseCoverEntryRequest.ProvideDriverResponse(DMI.IN.VirtualBaliseCover.VBCRequestEnum.Add)
expect efs: DMI.MasterDMI().In_DriverIdEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_VirtualBaliseCover.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_VirtualBaliseCover.VirtualBaliseCovers == [] @ deadline=1
expect efs: DMI.MasterDMI().In_TrainRunningNumberEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
step Drivers enters the data => virtual balise cover is stored on board, the procedure goes back to the initial state
sub Sub-step1
efs: DMI.MasterDMI().In_VirtualBaliseCover.ProvideDriverResponse ( marker => Kernel.VirtualBaliseCover.VBCMarkerStruct { Marker => 23, Area => 85 } )
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S1.AskToEnterValues @ deadline=1
expect efs: THERE_IS vbc IN Kernel.VirtualBaliseCover.VirtualBaliseCovers.VBCs | vbc.Marker == Kernel.VirtualBaliseCover.VBCMarkerStruct{ Marker => 23, Area => 85 } @ deadline=1
