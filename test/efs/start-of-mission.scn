case Propose to re-enter driver id in S10
clause E4 done 5.4.5.3 b) ; efs 5.4.5.3.b
step Re-enter driver id is proposed in S10
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S10
efs: Testing.SetSBMode(False)
efs: Kernel.DriverId.Value <- 'Paul'
efs: Kernel.DriverId.DataState <- DataStateEnum.Valid
efs: DMI.MasterDMI().In_DriverId.InputInformation.RequestStatus <- RequestEnum.Disabled
expect efs: DMI.MasterDMI().In_DriverIdEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
step Driver elects to re-enter the driver id => driver id screen is displayed
sub Sub-step1
efs: DMI.MasterDMI().In_DriverIdEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_DriverId.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_DriverId.Id == 'Paul'
expect efs: DMI.MasterDMI().In_DriverId.DriverAction.ReValidate == False
expect efs: DMI.MasterDMI().In_DriverId.DriverAction.Enter == True
step Driver elects to re-enter driver id
sub Sub-step1
efs: DMI.MasterDMI().In_DriverId.ProvideDriverResponse ( anId => 'Jacques' )
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S10
expect efs: Kernel.DriverId.Value == 'Jacques'
expect efs: DMI.MasterDMI().In_DriverId.InputInformation.RequestStatus == RequestEnum.Disabled
step We are still in S10
sub Sub-step1
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S10
