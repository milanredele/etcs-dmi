step Wrong version number
sub Wrong version number received
efs: EURORADIO.RBCConnection.CurrentRBCConnection().SessionManagementData.SystemVersion.Value <- VersionManagement.SystemVersionEnum.Unknown
efs: EURORADIO.RBCConnection.CurrentRBCConnection().SessionManagementData.SystemVersion.DataState <- DataStateEnum.Valid
case Handle RBC connection failure
clause E4 done 5.4.3.2 A32 ; efs Entry 5.4.3.2.A32.2.1
step Handle failure
sub State change due to connection failure
expect efs: Kernel.ActiveProcedure in [Kernel.ActiveProcedureSM.StartOfMission.A32] @ deadline=1
