sub Sub-step1
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.DataState <- DataStateEnum.Valid
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.D2
expect efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.DataState == DataStateEnum.Invalid
step Unknown level
sub Sub-step1
efs: Kernel.Level.DataState <- DataStateEnum.Unknown
