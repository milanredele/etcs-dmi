efs: Kernel.Level.Value.Value <- LevelEnum.L0
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: BTM.LRBG.PreviousBaliseGroups <- []
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.ShuntingInitiatedByDriver
expect efs: DMI.MasterDMI().In_TrainData.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: DMI.MasterDMI().In_NonLeadingRequest.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: Kernel.TrainPosition.Position.DataState == DataStateEnum.Unknown
step Driver selects SH (E12), Level 1
sub Sub-step1 - Set HandleModeChange and Mode
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedureSM.StartOfMission.S10.DriverSelectionRequested
efs: Testing.SetSBMode(False)
