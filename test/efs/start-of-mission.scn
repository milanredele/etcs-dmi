set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.NoProcedure
sub SubStep2
efs: Testing.InitializeTerminals()
case Request acknowledgement for SN mode, valid train position
clause E4 done 5.4.3.2 S22 ; efs Entry 5.4.3.2.S22
clause E4 done 5.4.3.2 S22 ; efs Entry 5.4.3.2.S22.1
clause - absent 5.4.6.1 ; efs 5.4.6.1
step Ack SN, valid train position
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S22
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
efs: Testing.SetSBMode(False)
expect efs: DMI.MasterDMI().In_AcknOfSNMode.InputInformation.RequestStatus == RequestEnum.Request
expect efs: Kernel.MissionIsOngoing == False
step Receive ack, keep train position valid
sub Sub-step1
efs: DMI.MasterDMI().In_AcknOfSNMode.ProvideDriverResponse()
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.NoProcedure
expect efs: Kernel.Mode == ModeEnum.SN
expect efs: DMI.MasterDMI().In_AcknOfSNMode.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: Kernel.TrainPosition.Position.DataState == DataStateEnum.Valid
expect efs: Kernel.MissionIsOngoing
case Request acknowledgement for SN mode, invalid train position
clause E4 done 5.4.3.2 S22 ; efs Entry 5.4.3.2.S22
clause E4 done 5.4.3.2 S22 ; efs Entry 5.4.3.2.S22.2
clause E4 done 5.4.3.2 S22 ; efs Entry 5.4.3.2.S22.1
clause - absent 5.4.6.1 ; efs 5.4.6.1
clause - absent Entry 5.4.3.3.18 ; efs Entry 5.4.3.3.18
step Ack SN, invalid train position
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S22
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Invalid
efs: Testing.SetSBMode(False)
efs: Kernel.MissionIsOngoing <- False
efs: BTM.LRBG.PreviousBaliseGroups <- []
expect efs: DMI.MasterDMI().In_AcknOfSNMode.InputInformation.RequestStatus == RequestEnum.Request @ deadline=2
step Receive ack, set train position as unknown
sub Sub-step1
efs: DMI.MasterDMI().In_AcknOfSNMode.ProvideDriverResponse()
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.NoProcedure
expect efs: Kernel.Mode == ModeEnum.SN
expect efs: DMI.MasterDMI().In_AcknOfSNMode.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: Kernel.TrainPosition.Position.DataState == DataStateEnum.Unknown
expect efs: Kernel.MissionIsOngoing
