efs: Kernel.DriverId.DataState <- DataStateEnum.Valid
case First SRC request fails
clause E5 partial 3.5.3.4 ; efs 3.5.3.4
clause E5 partial 3.5.3.7 a) ; efs 3.5.3.7.a
clause - absent 3.5.3.7.a.1 ; efs 3.5.3.7.a.1
step SRC request management
sub Request sent
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().CommunicationSession in [EURORADIO.RBCConnection.RBCStruct.CommunicationSessionStateSM.Establishing.WaitForSetUp] @ deadline=10
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.ConnectionState in [EURORADIO.RBCConnection.SafeRadioConnection.SafeRadioConnectionStruct.ConnectionStateSM.Requesting] @ deadline=10
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.SAConnect.Request == EURORADIO.RBCConnection.SafeRadioConnection.SRCRequestEnum.SA_CONNECT_Request @ deadline=10
sub Answers a failure
efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.SAConnect.Indication <- EURORADIO.RBCConnection.SafeRadioConnection.SRCIndicationEnum.SA_DISCONNECT_Indication
case Second SRC request fails
clause E5 partial 3.5.3.7 a) ; efs 3.5.3.7.a
clause - absent 3.5.3.7.a.1 ; efs 3.5.3.7.a.1
step SRC request management
sub Request sent
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().CommunicationSession in [EURORADIO.RBCConnection.RBCStruct.CommunicationSessionStateSM.Establishing.WaitForSetUp] @ deadline=10
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.ConnectionState in [EURORADIO.RBCConnection.SafeRadioConnection.SafeRadioConnectionStruct.ConnectionStateSM.Requesting] @ deadline=10
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.SAConnect.Request == EURORADIO.RBCConnection.SafeRadioConnection.SRCRequestEnum.SA_CONNECT_Request @ deadline=10
sub Answer a failure
efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.SAConnect.Indication <- EURORADIO.RBCConnection.SafeRadioConnection.SRCIndicationEnum.SA_DISCONNECT_Indication
case Third SRC request fails
clause E5 partial 3.5.3.7 a) ; efs 3.5.3.7.a
clause - absent 3.5.3.7.a.1 ; efs 3.5.3.7.a.1
step SRC request management
sub Request sent
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().CommunicationSession in [EURORADIO.RBCConnection.RBCStruct.CommunicationSessionStateSM.Establishing.WaitForSetUp] @ deadline=10
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.ConnectionState in [EURORADIO.RBCConnection.SafeRadioConnection.SafeRadioConnectionStruct.ConnectionStateSM.Requesting] @ deadline=10
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.SAConnect.Request == EURORADIO.RBCConnection.SafeRadioConnection.SRCRequestEnum.SA_CONNECT_Request @ deadline=1
sub Answers a failure
efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.SAConnect.Indication <- EURORADIO.RBCConnection.SafeRadioConnection.SRCIndicationEnum.SA_DISCONNECT_Indication
case Handle RBC connection failure
clause E4 done 5.4.3.2 A32 ; efs Entry 5.4.3.2.A32.2.1
step Handle failure
sub State change due to connection failure
expect efs: Kernel.ActiveProcedure in [Kernel.ActiveProcedureSM.StartOfMission.A32] @ deadline=1
