efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.NoProcedure
efs: EURORADIO.Terminal.DefaultRadioNetworkId<- ''
case Offer possibility to ReEnter the Radio Network ID
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.1
step Offer possibility to reenter Radio Network ID
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
expect efs: DMI.MasterDMI().In_RBCContactInformation.ProposedActions == [ DMI.RBCContactActionEnum.ReenterNetworkId ]
expect efs: DMI.MasterDMI().In_RBCContactInformation.InputInformation.RequestStatus == RequestEnum.Request
case Driver Elects to Re-Enter Radio Network ID
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.1
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.1.1
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.1.2
clause - absent Entry 5.4.3.3.10 ; efs Entry 5.4.3.3.10
step Retrieve list of allowed networks
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
efs: DMI.MasterDMI().In_RBCContactInformation.ProvideDriverResponse ( aDriversSelectedAction => DMI.RBCContactActionEnum.ReenterNetworkId, anRBCContactInformation => EURORADIO.RBCConnection.Contact.RBCContactStruct{}, aNetworkId => 'NetworkId' )
expect efs: EURORADIO.RBCConnection.Contact.AvailableNetworks.RequestState == RequestEnum.Request
step Allow driver to select a Radio network ID from the non empty list
sub Sub-step1
efs: EURORADIO.RBCConnection.Contact.AvailableNetworks.Networks <- ['1234', '4562']
efs: EURORADIO.RBCConnection.Contact.AvailableNetworks.RequestState <- RequestEnum.Response
expect efs: EURORADIO.RBCConnection.Contact.AvailableNetworks.RequestState == RequestEnum.Disabled
expect efs: DMI.MasterDMI().In_RBCContactInformation.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_RBCContactInformation.ProposedActions == [ DMI.RBCContactActionEnum.SelectNetworkId ]
expect efs: DMI.MasterDMI().In_RBCContactInformation.AvailableNetworks == ['1234', '4562']
step When driver selects a network ID, register to the network
sub Sub-step1
efs: DMI.MasterDMI().In_RBCContactInformation.InputInformation.RequestStatus <- RequestEnum.Response
efs: DMI.MasterDMI().In_RBCContactInformation.NetworkId <- '4562'
efs: DMI.MasterDMI().In_RBCContactInformation.DriversSelectedAction <- DMI.RBCContactActionEnum.SelectNetworkId
expect efs: EURORADIO.Terminal.CurrentTerminal().RegistrationState in EURORADIO.Terminal.TerminalStruct.RegistrationStateSM.NotRegistered @ deadline=2
expect efs: EURORADIO.Terminal.CurrentTerminal().NetworkIdToRegister == '4562' @ deadline=2
step Mobile terminal registered
sub SubStep1
expect efs: EURORADIO.Terminal.CurrentTerminal().RegistrationState in EURORADIO.Terminal.TerminalStruct.RegistrationStateSM.Registering @ deadline=2
sub Sub-step2
efs: EURORADIO.Terminal.CurrentTerminal().RegistrationRequestState.RequestState <- Default.RequestEnum.Response
efs: EURORADIO.Terminal.CurrentTerminal().RegistrationRequestState.Response <- True
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.S3 @ deadline=1
expect efs: EURORADIO.Terminal.CurrentTerminal().RegistrationState in EURORADIO.Terminal.TerminalStruct.RegistrationStateSM.Registered @ deadline=0.5
step The list of Radio Network Ids is empty
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
efs: EURORADIO.RBCConnection.Contact.AvailableNetworks.Networks <- []
efs: EURORADIO.RBCConnection.Contact.AvailableNetworks.RequestState <- RequestEnum.Response
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.A29
case One mobile terminal registerd on network
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.2
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.2.1
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.2.2
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.2.3
step Status of RBC ID/Phone number is invalid
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
efs: EURORADIO.Terminal.Terminal1.RegistrationState <- EURORADIO.Terminal.TerminalStruct.RegistrationStateSM.Registered
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.Id.Id <- 6543
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.PhoneNumber <- '5742'
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.DataState <- Default.DataStateEnum.Invalid
expect efs: DMI.MasterDMI().In_RBCContactInformation.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_RBCContactInformation.ProposedActions == [ DMI.RBCContactActionEnum.RevalidateContactInfo, DMI.RBCContactActionEnum.UseEireneShortNumber, DMI.RBCContactActionEnum.UseLastStoredNumber, DMI.RBCContactActionEnum.EnterContactInfo, DMI.RBCContactActionEnum.ReenterNetworkId ]
expect efs: DMI.MasterDMI().In_RBCContactInformation.RBCContactInformation.Id.Id == 6543
expect efs: DMI.MasterDMI().In_RBCContactInformation.RBCContactInformation.PhoneNumber == '5742'
step Status of RBC ID/Phone number is valid
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
efs: EURORADIO.Terminal.Terminal1.RegistrationState <- EURORADIO.Terminal.TerminalStruct.RegistrationStateSM.Registered
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.Id.Id <- 7654
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.PhoneNumber <- '6574'
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.DataState <- DataStateEnum.Valid
expect efs: DMI.MasterDMI().In_RBCContactInformation.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_RBCContactInformation.ProposedActions == [ DMI.RBCContactActionEnum.ReenterNetworkId, DMI.RBCContactActionEnum.UseEireneShortNumber ]
expect efs: DMI.MasterDMI().In_RBCContactInformation.RBCContactInformation.Id.Id == 7654
expect efs: DMI.MasterDMI().In_RBCContactInformation.RBCContactInformation.PhoneNumber == '6574'
step Status of RBC ID/Phone number is unknown
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
efs: EURORADIO.Terminal.Terminal1.RegistrationState <- EURORADIO.Terminal.TerminalStruct.RegistrationStateSM.Registered
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.Id.Id <- 6541
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.PhoneNumber <- '5741'
efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.DataState <- DataStateEnum.Unknown
expect efs: DMI.MasterDMI().In_RBCContactInformation.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_RBCContactInformation.ProposedActions == [ DMI.RBCContactActionEnum.ReenterNetworkId, DMI.RBCContactActionEnum.EnterContactInfo, DMI.RBCContactActionEnum.UseEireneShortNumber ]
expect efs: DMI.MasterDMI().In_RBCContactInformation.RBCContactInformation == EMPTY
case At the end, go to A31
clause E4 partial 5.4.3.2 S3 ; efs Entry 5.4.3.2.S3.3
clause - absent Entry 5.4.3.3.11 ; efs Entry 5.4.3.3.11
clause - absent Entry 5.4.3.3.12 ; efs Entry 5.4.3.3.12
step After driver responds, go to A31
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
efs: DMI.MasterDMI().In_RBCContactInformation.ProvideDriverResponse ( aDriversSelectedAction => DMI.RBCContactActionEnum.EnterContactInfo, anRBCContactInformation => EURORADIO.RBCConnection.Contact.RBCContactStruct{}, aNetworkId => '' )
expect efs: DMI.MasterDMI().In_RBCContactInformation.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.A31 @ deadline=1
step In case of change, apply them in EURORADIO
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S3
efs: DMI.MasterDMI().In_RBCContactInformation.ProvideDriverResponse ( aDriversSelectedAction => DMI.RBCContactActionEnum.EnterContactInfo, anRBCContactInformation => EURORADIO.RBCConnection.Contact.RBCContactStruct { Id => EURORADIO.RBCConnection.Contact.RBCIdStruct { Country => 15, Id => 6656 }, PhoneNumber => '2398' }, aNetworkId => 'NetworkId' )
expect efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.Id.Id == 6656
expect efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.PhoneNumber == '2398'
expect efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.DataState == DataStateEnum.Valid @ deadline=1
expect efs: EURORADIO.RBCConnection.Contact.LastKnownRBC.Id.Country == 15 @ deadline=1
