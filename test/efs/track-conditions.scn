frame Track conditions
sequence New LRBG and delete TC
case New LRBG
clause E4 todo A.3.6.1.1 ; efs 3.A3.6.1.1
clause E4 todo A.3.6.2.1 ; efs 3.A3.6.2.1
clause - absent 3.6.4.3 ; efs 3.6.4.3
clause - absent 3.6.4.3 a) ; efs 3.6.4.3.a
clause - absent 3.13.1.4 ; efs 3.13.1.4
step Setup
sub Initialize
efs: Testing.InitializeTestEnvironment( aTrainPosition => 0.0, aMode => Default.ModeEnum.FS )
sub Setup
set track_conditions air_tightness@150.0+200.0
set train.length 100.0
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 100.0, BaliseGroupIdentifier => 1337, CountryIdentifier => 0 }, BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 150.0, BaliseGroupIdentifier => 1338, CountryIdentifier => 0 }, BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 200.0, BaliseGroupIdentifier => 1339, CountryIdentifier => 0 }] )
taint track
efs: Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses <- [Kernel.TrackDescription.TrackConditions.BigMetalMasses.BigMetalMassesInformationStruct{ Location => 150.0, Length => 200.0 }]
step Distance remains relative to LRBG
sub Update distance
set odo.position 100.0
sub Verify TC location
expect efs: (FIRST X IN Kernel.TrackDescription.TrackConditions.General.TCProfile).Location == 150.0 @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses).Location == 150.0 @ deadline=1
step New LRBG before TC
sub First balise
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=0 NID_C=0 NID_BG=1337 Q_LINK=1
sub Second balise
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=0 NID_C=0 NID_BG=1337 Q_LINK=1
sub Verify TC location
expect efs: (FIRST X IN Kernel.TrackDescription.TrackConditions.General.TCProfile).Location == 50.0 @ deadline=1
expect efs: BTM.LRBG.LRBG().NID_BG == 1337 @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses).Location == 50.0 @ deadline=1
step Update distance
sub SubStep1
set odo.position 250.0
step New LRBG within TC area
sub SubStep1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=0 NID_C=0 NID_BG=1338 Q_LINK=1
sub SubStep2
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=0 NID_C=0 NID_BG=1338 Q_LINK=1
sub SubStep3
expect efs: (FIRST X IN Kernel.TrackDescription.TrackConditions.General.TCProfile).Location == -100.0 @ deadline=1
expect efs: BTM.LRBG.LRBG().NID_BG == 1338 @ deadline=1
expect efs: COUNT X IN Kernel.TrackDescription.TrackConditions.General.TCProfile == 1 @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses).Location == -100.0 @ deadline=1
expect efs: COUNT X IN Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses == 1 @ deadline=1
step Update distance
sub SubStep1
set odo.position 449.0
step TC not deleted
sub SubStep1
expect efs: (FIRST X IN Kernel.TrackDescription.TrackConditions.General.TCProfile).Location + (FIRST X IN Kernel.TrackDescription.TrackConditions.General.TCProfile).Length - Kernel.TrainPosition.RearEndPosition ( DistanceIntervalEnum.Min ) == 1.0 @ deadline=1
expect efs: COUNT X IN Kernel.TrackDescription.TrackConditions.General.TCProfile == 1 @ deadline=1
step Update distance
sub SubStep1
set odo.position 450.0
step New LRBG after TC, general TC deleted
sub SubStep1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=0 NID_C=0 NID_BG=1339 Q_LINK=1
sub SubStep2
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=0 NID_C=0 NID_BG=1339 Q_LINK=1
sub SubStep3
expect efs: BTM.LRBG.LRBG().NID_BG == 1339 @ deadline=1
expect efs: Kernel.TrackDescription.TrackConditions.General.TCProfile == [] @ deadline=1
expect efs: COUNT X IN Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses == 1 @ deadline=1
step Update distance
sub SubStep1
set odo.position 749.0
step BMM condition not deleted
sub SubStep1
expect efs: (FIRST X IN Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses).Location + (FIRST X IN Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses).Length - Kernel.TrainPosition.RearEndPosition ( DistanceIntervalEnum.Min ) + Kernel.DistanceToKeepInfoInTheRear == 1.0 @ deadline=1
expect efs: COUNT X IN Kernel.TrackDescription.TrackConditions.BigMetalMasses.TCBigMetalMasses == 1 @ deadline=1
step Update distance
sub SubStep1
set odo.position 750.0
step BMM condition deleted
