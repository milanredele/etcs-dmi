set train.data_state valid
efs: Kernel.Level <- Kernel.LevelData{ Value => LevelDataStruct{ NTC => NID_NTC.NOT_APPLICABLE, Value => LevelEnum.L1 }, DataState => DataStateEnum.Valid }
expect efs: Kernel.MA.ModeProfile.Profile != [] @ deadline=1
expect efs: (FIRST X IN Kernel.MA.ModeProfile.Profile).Mode == ModeEnum.ModeProfile.SH @ deadline=1
