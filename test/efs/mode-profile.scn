step Level and PreviousMode received
sub Sub-step1
efs: Testing.SetSRMode(False)
set odo.accuracy D_ura=12.0 D_ora=14.0 V_ora=0.0 V_ura=0.0
expect efs: Kernel.Mode == ModeEnum.SR @ deadline=1
step LS ModeProfile and MA received
sub Sub-step1
taint ma
efs: INSERT Kernel.MA.ModeProfile.ModeProfileStruct { Location=>130.0, Length=>200.0, Speed=>100.0, Mode=>ModeEnum.ModeProfile.LS } IN Kernel.MA.ModeProfile.Profile
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct { TargetSpeed => 0.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 1000.0, TimeOut => Kernel.MA.MATimers.TimeOutStruct { TimeOut => Timer.TimerStruct{ StartTime => BaseTypes.Time.NA, Duration => 10.0 }, Distance => 1000.0 } }], EndSection =>Kernel.MA.EndSectionStruct { EndSectionTimeOut => Kernel.MA.MATimers.TimeOutStruct { TimeOut => Timer.TimerStruct{ StartTime => BaseTypes.Time.NA, Duration => 5.0 }, Distance => 1000.0 }, DangerPoint => Kernel.MA.SvL.DangerPointStruct { Distance =>10.0, ReleaseSpeed => 0.0 }, Overlap => Kernel.MA.SvL.OverlapStruct { Distance => 0.0, TimerDistance => 0.0, ReleaseSpeed => 0.0, TimeOut => EMPTY } }, TargetSpeedTimeOut => 0.0 }
expect efs: Kernel.Mode == ModeEnum.SR @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition( PointOfInterest=>DistanceIntervalEnum.Min ) == 75.0 @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition( PointOfInterest=>DistanceIntervalEnum.Max ) == 122.0 @ deadline=1
step Max SafeFrontEnd Before LS ModeProfile
sub Sub-step1
expect efs: Kernel.Mode != ModeEnum.LS @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition( PointOfInterest=>DistanceIntervalEnum.Max ) == 122.0 @ blocking=FALSE
step Beginning of LS Mode Profile
sub Sub-step1
set odo.position 108.0
expect efs: Kernel.Mode == ModeEnum.LS @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition( PointOfInterest=>DistanceIntervalEnum.Max ) == 130.0 @ blocking=FALSE
step Max SafeFrontEnd After LS ModeProfile
sub Sub-step1
set odo.position 120.0
expect efs: Kernel.Mode == ModeEnum.LS @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition( PointOfInterest=>DistanceIntervalEnum.Max ) == 142.0 @ blocking=FALSE
step Min SafeFrontEnd Before Exit LSModeProfile
sub Sub-step1
set odo.position 345.0
expect efs: Kernel.Mode == ModeEnum.LS @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition( PointOfInterest=>DistanceIntervalEnum.Min ) == 320.0 @ blocking=FALSE
step Min SafeFrontEnd After Exit LS ModeProfile
sub Sub-step1
set odo.position 356.0
expect efs: Kernel.Mode != ModeEnum.LS @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition( PointOfInterest=>DistanceIntervalEnum.Min ) == 331.0 @ blocking=FALSE
