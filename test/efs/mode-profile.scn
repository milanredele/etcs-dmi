sub Add mode profile
taint ma
efs: Kernel.MA.ModeProfile.Profile <- [Kernel.MA.ModeProfile.ModeProfileStruct{ Location => 200.0, Mode => ModeEnum.ModeProfile.OS, Speed => 50.0, Length => 500.0, AcknLength => 200.0, SupervisionQualifier => Messages.Q_MAMODE.as_both_the_EOA_and_SvL__instead_of_the_EOA_and_SvL_given_by_the_MA }]
step Acknowledge OS mode
sub Acknowledgement request of OS mode is displayed
expect efs: DMI.MasterDMI().In_AcknOfOSMode.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Driver acknowledges OS mode
efs: DMI.MasterDMI().In_AcknOfOSMode.InputInformation.RequestStatus <- Default.RequestEnum.Response
expect efs: Kernel.Mode == ModeEnum.OS @ deadline=1
step Remain in OS
sub Mode stays OS
expect efs: Kernel.Mode == ModeEnum.OS @ deadline=1
sub After moving a little, mode is still OS
set odo.speed 20.0
set odo.position 50.0
expect efs: Kernel.Mode == ModeEnum.OS @ deadline=1
