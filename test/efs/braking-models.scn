sequence Track condition conversion to brake condition
case No overlaping brake conditions
step Setup
sub Initialize
efs: Testing.InitializeTestEnvironment( aTrainPosition => 0.0, aMode => Default.ModeEnum.FS )
sub Setup
set train.length 100.0
set track_conditions magnetic_shoe@0.0+100.0 regenerative@300.0+100.0
set odo.accuracy D_ura=10.0 D_ora=10.0 V_ora=0.0 V_ura=0.0
step Check single track condition
sub TCToBrakeCondition
expect efs: Kernel.TrainData.BrakingParameters.TCToBrakeCondition( aTCProfile => Kernel.TrainData.BrakingParameters.MapBrakeConditions(), aCondition => FIRST X IN Kernel.TrainData.BrakingParameters.MapBrakeConditions() ) == [Kernel.TrainData.BrakingParameters.BrakeConditionStruct{ Distance => -20.0, Length => 241.0, SwitchOffEddyCurrentBrakeForEB => Boolean.False, SwitchOffEddyCurrentBrakeForSB => Boolean.False, SwitchOffMagneticShoeBrake => Boolean.True, SwitchOffRegenerativeBrake => Boolean.False }] @ deadline=1
expect efs: Kernel.TrainData.BrakingParameters.MapBrakeConditions() == [Kernel.TrackDescription.TrackConditions.General.TrackConditionInformationStruct{ Location => -20.0, Value => Kernel.TrackDescription.TrackConditions.General.TrackConditionEnum.SwitchOffMagneticShoeBrake, Length => 241.0 }, Kernel.TrackDescription.TrackConditions.General.TrackConditionInformationStruct{ Location => 280.0, Value => Kernel.TrackDescription.TrackConditions.General.TrackConditionEnum.SwitchOffRegenerativeBrake, Length => 241.0 }] @ deadline=1
case Overlaping brake conditions
