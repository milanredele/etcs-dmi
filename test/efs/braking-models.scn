sequence Track condition profile conversion to brake condition profile
case No overlapping brake conditions
step Setup
sub Initialize
efs: Testing.InitializeTestEnvironment( aTrainPosition => 0.0, aMode => Default.ModeEnum.FS )
sub Setup
set track_conditions magnetic_shoe@0.0+100.0 air_tightness@50.0+100.0 regenerative@300.0+100.0
set train.length 100.0
set odo.accuracy D_ura=10.0 D_ora=10.0 V_ora=0.0 V_ura=0.0
step Check brake profile
sub BrakeConditionsProfile
expect efs: Kernel.TrainData.BrakingParameters.BrakeConditionsProfile() == [Kernel.TrainData.BrakingParameters.BrakeConditionStruct{ Distance => -20.0, Length => 241.0, SwitchOffEddyCurrentBrakeForEB => Boolean.False, SwitchOffEddyCurrentBrakeForSB => Boolean.False, SwitchOffMagneticShoeBrake => Boolean.True, SwitchOffRegenerativeBrake => Boolean.False }, Kernel.TrainData.BrakingParameters.BrakeConditionStruct{ Distance => 280.0, Length => 241.0, SwitchOffEddyCurrentBrakeForEB => Boolean.False, SwitchOffEddyCurrentBrakeForSB => Boolean.False, SwitchOffMagneticShoeBrake => Boolean.False, SwitchOffRegenerativeBrake => Boolean.True }] @ deadline=1
case Overlaping brake conditions
step Setup
sub Setup
set track_conditions magnetic_shoe@0.0+100.0 regenerative@20.0+29.0 eddy_current_eb@110.0+100.0 regenerative@300.0+100.0
step BrakeConditionsProfile
sub Check
expect efs: THERE_IS X IN Kernel.TrainData.BrakingParameters.BrakeConditionsProfile() | X == Kernel.TrainData.BrakingParameters.BrakeConditionStruct{ Distance => -20.0, Length => 20.0, SwitchOffEddyCurrentBrakeForEB => Boolean.False, SwitchOffEddyCurrentBrakeForSB => Boolean.False, SwitchOffMagneticShoeBrake => Boolean.True, SwitchOffRegenerativeBrake => Boolean.False } @ deadline=1
expect efs: (COUNT X IN Kernel.TrainData.BrakingParameters.BrakeConditionsProfile() | X == Kernel.TrainData.BrakingParameters.BrakeConditionStruct{ Distance => -20.0, Length => 20.0, SwitchOffEddyCurrentBrakeForEB => Boolean.False, SwitchOffEddyCurrentBrakeForSB => Boolean.False, SwitchOffMagneticShoeBrake => Boolean.True, SwitchOffRegenerativeBrake => Boolean.False }) == 1 @ deadline=1
