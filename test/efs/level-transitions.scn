set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
step Receive Level Transition Order for Level 1
sub Sub-step1
taint track nv ma
efs: BTM.Message.SystemVersion2 <- Messages.EUROBALISE.Message { Q_UPDOWN => Messages.Q_UPDOWN.Up_link_telegram, M_VERSION => Messages.M_VERSION.Version_2_0__introduced_in_SRS_3_0_0, Q_MEDIA => Messages.Q_MEDIA.Balise, N_PIG => 0, N_TOTAL => Messages.N_TOTAL._2_balises_in_groupC, M_DUP => Messages.M_DUP.No_duplicates, M_MCOUNT => Messages.M_MCOUNT.The_telegram_fits_with_all_telegrams_of_the_same_balise_group, NID_C => 85, NID_BG => 12345, Q_LINK => Messages.Q_LINK.Unlinked, Sequence1 => [ Messages.EUROBALISE.SubStructure1 { TRACK_TO_TRAIN => Messages.PACKET.TRACK_TO_TRAIN.Message { LEVEL_TRANSITION_ORDER => Messages.PACKET.TRACK_TO_TRAIN.LEVEL_TRANSITION_ORDER.Message { NID_PACKET => 41, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, D_LEVELTR => 1400, M_LEVELTR => Messages.M_LEVELTR.Level_1, NID_NTC => 0, L_ACKLEVELTR => 0, N_ITER => 0 } } }, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY ], BitField => '' }
set odo.position 500.0
sub Sub-step2
telegram balise Q_UPDOWN=1 M_VERSION=16 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=12345 Q_LINK=0
sub Sub-step3 - Check MA
expect efs: Kernel.MA.MA.TargetSpeed == 0.0 @ deadline=1
expect efs: (LAST section IN Kernel.MA.MA.Sections).Length == 4500.0 @ deadline=1
step Level transition to L2, retain L1 MA
sub Sub-step1
set odo.position 1901.0
expect efs: Kernel.Level.Value.Value == LevelEnum.L1 @ deadline=1
sub Sub-step2 - Check MA is retained
expect efs: (LAST section IN Kernel.MA.MA.Sections).Length == 4500.0 @ deadline=1
expect efs: Kernel.MA.MA.TargetSpeed == 0.0 @ deadline=1
