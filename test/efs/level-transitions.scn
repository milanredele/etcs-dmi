efs: BTM.Message.SystemVersion2 <- Messages.EUROBALISE.Message { Q_UPDOWN => Messages.Q_UPDOWN.Up_link_telegram, M_VERSION => Messages.M_VERSION.Version_1_0__introduced_in_SRS_1_2_0_and_re_used_in_SRSs_2_0_0__2_2_2__2_3_0, Q_MEDIA => Messages.Q_MEDIA.Balise, N_PIG => 0, N_TOTAL => Messages.N_TOTAL._2_balises_in_groupC, M_DUP => Messages.M_DUP.No_duplicates, M_MCOUNT => Messages.M_MCOUNT.The_telegram_fits_with_all_telegrams_of_the_same_balise_group, NID_C => 85, NID_BG => 12345, Q_LINK => Messages.Q_LINK.Unlinked, Sequence1 => [ Messages.EUROBALISE.SubStructure1 { TRACK_TO_TRAIN => Messages.PACKET.TRACK_TO_TRAIN.Message { LEVEL_TRANSITION_ORDER => Messages.PACKET.TRACK_TO_TRAIN.LEVEL_TRANSITION_ORDER.Message { NID_PACKET => 41, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, D_LEVELTR => 1400, M_LEVELTR => Messages.M_LEVELTR.Level_2, NID_NTC => 0, L_ACKLEVELTR => 0, N_ITER => 0 } } }, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY ], BitField => '' }
