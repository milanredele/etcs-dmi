efs: EURORADIO.Messages.PositionReport.PositionReportParameters.Values.DistanceInterval <- 1000.0
taint track nv ma
efs: EURORADIO.Messages.PositionReport.PositionReportParameters.Values.SpecialMoment <- EURORADIO.Messages.PositionReport.PositionReportSpecialMoment.LRBG
taint track nv ma
efs: EURORADIO.Messages.PositionReport.PositionReportParameters.Values.SpecialLocations <- [EURORADIO.Messages.PositionReport.PositionReportSpecialLocation{Distance=>1040.0,TrainEnd=>EURORADIO.Messages.TrainData.TrainEndEnum.MinSafeRearEnd}]
