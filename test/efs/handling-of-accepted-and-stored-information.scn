step m) Step2 -  Inconsistency in a BG marked as linked and no linking is used onboard and the train is at standstill
case Situation k
clause - absent Condition 3.A3.4.1.3.1.35.3 ; efs Condition 3.A3.4.1.3.1.35.3
step k) Step1 - Setup
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission
set train.v_max 80.0
set train.data_state valid
efs: Testing.SetSBMode(False)
step k) Step2 - Driver closes the desk during SoM
sub Sub-step1
efs: DMI.CabOfDMI ( DMI.DMI1 ).Desk1IsActive <- False
expect efs: Kernel.TrainData.TrainData.DataState == DataStateEnum.Invalid @ deadline=1
expect efs: Kernel.TrainData.TrainData.Value.MaximumSpeed == 80.0
