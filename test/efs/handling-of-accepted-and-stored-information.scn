efs: DMI.CabOfDMI ( DMI.DMI1 ).Desk1IsActive <- False
expect efs: (FIRST X IN EURORADIO.Messages.PositionReport.PositionReportParameters.Values.SpecialLocations).TrainEnd == EURORADIO.Messages.TrainData.TrainEndEnum.MinSafeRearEnd
expect efs: EURORADIO.Messages.PositionReport.PositionReportParameters.Values.DistanceInterval == 1000.0
expect efs: EURORADIO.Messages.PositionReport.PositionReportParameters.Values.TimeInterval == 40.0
expect efs: EURORADIO.Messages.PositionReport.PositionReportParameters.Values.SpecialMoment == EURORADIO.Messages.PositionReport.PositionReportSpecialMoment.LRBG
expect efs: EURORADIO.Messages.PositionReport.PositionReportParameters.DataState == DataStateEnum.Valid
