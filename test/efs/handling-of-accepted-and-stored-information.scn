# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
case Situations a-d, f, n
clause - absent Condition 3.A3.4.1.3.1.13.1 ; efs Condition 3.A3.4.1.3.1.13.1
step a) Step1 - Setup
step a) Step2 -  Execution of a conditional emergency stop
step b) Step1 - Setup
step b) Step2 -  Reception of a shortened MA
step c) Step1 - Setup
step c) Step2 -  Stored MA is shortened due to a section time-out
step d) Step1 - Setup
step d) Step2 -  SvL is shifted due to an overlap time-out
step f) Step1 - Setup
step f) Step2 -  A cooperative MA revocation is granted by the onboard
step n) Step1 - Setup
step n) Step2 -  LOA becomes EOA and the on-board consisders an SvL
case Situations e, g-j, l, m
clause - absent Condition 3.A3.4.1.3.1.13.2 ; efs Condition 3.A3.4.1.3.1.13.2
step e) Step1 - Setup
step e) Step2 - Stored MA is shortened due to an end section time-out
step g) Step1 - Setup
step g) Step2 - Inconsistency in a BG marked as unlinked and the train is at standstill
step h) Step1 - Setup
step h) Step2 -  A linking reaction led to a SB and the train is at standstill
step i) Step1 - Setup
step i) Step2 -  Reaction due to the supervision of the safe radio connection let to a SB and the train is at standstill
step j) Step1 - Setup
step j) Step2 -  The train category, axle load category, loading gauge or traction system is changed and the train is at standstill
step l) Step1 - Setup
step l) Step2 -  RAMS related supervision functions led to a SB and the train is at standstill
step m) Step1 - Setup
step m) Step2 -  Inconsistency in a BG marked as linked and no linking is used onboard and the train is at standstill
case Situation k
clause - absent Condition 3.A3.4.1.3.1.13.3 ; efs Condition 3.A3.4.1.3.1.13.3
step k) Step1 - Setup
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission
efs: Testing.SetSBMode(False)
step k) Step2 - Driver closes the desk during SoM
sub Sub-step1
efs: DMI.CabOfDMI ( DMI.DMI1 ).Desk1IsActive <- False
