sub Sub-step2
efs: BTM.LRBG.PreviousBaliseGroups <- []
set odo.speed 42.0
case Reception of a balise group, where M_MCOUNT changes
step Reception of the first balise of the balise group
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=2 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2125 Q_LINK=1
set odo.position 25620.0
step Reception of the second balise of the balise group, change of M_MCOUNT
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=2 M_DUP=0 M_MCOUNT=27 NID_C=140 NID_BG=2125 Q_LINK=1
set odo.position 25640.0
step Reception of the third balise of the balise group
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=2 N_TOTAL=2 M_DUP=0 M_MCOUNT=27 NID_C=140 NID_BG=2125 Q_LINK=1
set odo.position 25700.0
expect efs: BTM.LRBG.PreviousBaliseGroups == []
expect efs: NOT Available ( BTM.LRBG.LRBG() )
