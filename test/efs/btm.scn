step Set up the partially received BG
sub Sub-step1
efs: BTM.CurrentBaliseGroup <- [ Messages.EUROBALISE.Message { Q_UPDOWN => Messages.Q_UPDOWN.Up_link_telegram, M_VERSION => Messages.M_VERSION.Version_1_1__introduced_in_SRS_3_0_0, Q_MEDIA => Messages.Q_MEDIA.Balise, N_PIG => 0, N_TOTAL => Messages.N_TOTAL._8_balises_in_groupC, M_DUP => Messages.M_DUP.No_duplicates, M_MCOUNT => Messages.M_MCOUNT.The_telegram_never_fits_any_message_of_the_group, NID_C => 85, NID_BG => 1234, Q_LINK => Messages.Q_LINK.Unlinked, Sequence1 => [ ], BitField => '' }, Messages.EUROBALISE.Message { Q_UPDOWN => Messages.Q_UPDOWN.Up_link_telegram, M_VERSION => Messages.M_VERSION.Version_1_1__introduced_in_SRS_3_0_0, Q_MEDIA => Messages.Q_MEDIA.Balise, N_PIG => 1, N_TOTAL => Messages.N_TOTAL._8_balises_in_groupC, M_DUP => Messages.M_DUP.No_duplicates, M_MCOUNT => Messages.M_MCOUNT.The_telegram_never_fits_any_message_of_the_group, NID_C => 85, NID_BG => 1234, Q_LINK => Messages.Q_LINK.Unlinked, Sequence1 => [ ], BitField => '' } ]
efs: BTM.MissedBalises.PrevBalisePosition <- Odometry.NominalDistance
expect efs: (COUNT X IN BTM.CurrentBaliseGroup) == 2 @ deadline=1
step Receive a much later balise in the group
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=17 Q_MEDIA=0 N_PIG=5 N_TOTAL=7 M_DUP=0 M_MCOUNT=254 NID_C=85 NID_BG=1234 Q_LINK=0
expect efs: COUNT X IN BTM.CurrentBaliseGroup == 3 @ deadline=1
expect efs: BTM.MaxDistanceTillBGEnd( BTM.BGOrientation( BTM.CurrentBaliseGroup)) == 24.0 @ deadline=1
step Miss the next balise, is added as virtual
sub Sub-step1
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + BTM.MissedBalises.MaxDistBetweenBalises + 1.0
expect efs: COUNT X IN BTM.CurrentBaliseGroup == 3 @ deadline=1
expect efs: BTM.MaxDistanceTillBGEnd( BTM.BGOrientation( BTM.CurrentBaliseGroup)) == 11.0 @ deadline=1
step Further away, BG is considered passed
sub SubStep1
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + BTM.MissedBalises.MaxDistBetweenBalises
expect efs: BTM.FullBGReceived(BTM.CurrentBaliseGroup) @ cyclephase=Verification
expect efs: BTM.MaxDistanceTillBGEnd( BTM.BGOrientation( BTM.CurrentBaliseGroup)) == - 1.0 @ deadline=1
sequence Balise reception, unlinked BG with information to do SR -> FS
case Configuration
step Setup
sub SubStep1
efs: Testing.InitializeTestEnvironment( aTrainPosition => 250.0, aMode => Default.ModeEnum.SR )
sub Delete the LRBG
efs: BTM.LRBG.PreviousBaliseGroups <- []
efs: Kernel.Level <- Kernel.LevelData{ Value => LevelDataStruct{ NTC => NID_NTC.NOT_APPLICABLE, Value => LevelEnum.L1 }, DataState => DataStateEnum.Valid }
case Receive Unlinked BG
clause - absent 3.6.4.7.2 b) ; efs 3.6.4.7.2.b
clause - absent 3.6.4.7.2 a) ; efs 3.6.4.7.2.a
clause - absent 3.6.4.7.1 ; efs 3.6.4.7.1
step Receive BG
sub Balise telegram 1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=81 NID_BG=1567 Q_LINK=0 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=12 Q_DIR=2 L_PACKET=0 Q_SCALE=1 V_MAIN=40 V_EMA=0 T_EMA=0 N_ITER=0 L_ENDSECTION=1200 Q_SECTIONTIMER=0 Q_ENDTIMER=0 Q_DANGERPOINT=0 Q_OVERLAP=0 | GRADIENT_PROFILE NID_PACKET=21 Q_DIR=2 L_PACKET=0 Q_SCALE=1 D_GRADIENT=0 Q_GDIR=0 G_A=0 N_ITER=0 | INTERNATIONAL_STATIC_SPEED_PROFILE NID_PACKET=27 Q_DIR=2 L_PACKET=0 Q_SCALE=1 D_STATIC=0 V_STATIC=20 Q_FRONT=1 N_ITER=0 N_ITER=0
sub Balise telegram 2
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=81 NID_BG=1567 Q_LINK=0
expect efs: Kernel.Mode == ModeEnum.FS @ deadline=1
sequence Duplicate balise missed, message accepted
case Initial configuration
clause E6 todo 3.16.2.4.2 ; efs 3.16.2.4.2
step Setup
sub Sub-step1 - Initialize test environment
init 100.0 FS
# the defaults of the EFS model (TrainDataValuesStruct, TIU)
set train.data_state unknown
set train.length 400.0
set train.v_max 150.0
set train.lambda na
set train.brake_position passenger_p
set train.m_rotating_nom na
set train.interface regenerative none
set train.interface eddy_current none
set train.interface magnetic_shoe none
set train.interface ep none
set train.sb_command false
set train.sb_feedback false
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.eb_models clear
set train.sb_models clear
set train.nsb clear
set train.t_brake_emergency clear
set train.t_brake_service clear
set train.kn_plus clear
set train.kn_minus clear
set tiu.active regenerative true
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active ep true
set tiu.additional true
set config.additional_brake_allowed false
set track_conditions
set gradients
set adhesion
set adhesion.driver_slippery false
set tsrs
set odo.speed 0.0
set odo.accel 0.0
set nv defaults
# the EFS test environment (Testing.InitializeTestEnvironment)
set odo.accuracy D_ura=0.0 D_ora=0.0 V_ura=0.0 V_ora=0.0
# InitializeTrainData_ERA
# efs: BTM.ActiveAntennaPosition <- 5.0
set config.additional_brake_allowed true
set train.brake_position passenger_p
set train.eb_models clear
set train.eb_model 2 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 4 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 1 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 6 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 3 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 5 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 7 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 0 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.m_rotating_nom na
set train.v_max 220.0
set train.sb_command true
set train.sb_models clear
set train.sb_model 2 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 4 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 1 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 6 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 3 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 5 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 7 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 0 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.length 197.0
# efs: Kernel.TrainData.TrainData.Value.LoadingGauge <- Messages.M_LOADINGGAUGE.G1
# efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- 2
# efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [Kernel.TrainData.TractionSystemStruct{ Voltage => Messages.M_VOLTAGE.AC_15_kV_16_7_Hz, Country => 85 }]
# InitializeBrakingParameters
set train.kdry 7 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kdry 5 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 7 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 5 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.eb_step 7 0 0.0 1.0
set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
sub Sub-step2 - Set linking
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 10.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 100.0, BaliseGroupIdentifier => 1532, CountryIdentifier => 85 }] )
step Reception of the first balise
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=2 M_DUP=1 M_MCOUNT=255 NID_C=85 NID_BG=1532 Q_LINK=1 | VIRTUAL_BALISE_COVER_ORDER NID_PACKET=6 Q_DIR=1 L_PACKET=0 Q_VBCO=1 NID_VBCMK=53 NID_C=85 T_VBC=6
expect efs: COUNT X IN BTM.CurrentBaliseGroup == 1 @ deadline=1
expect efs: Kernel.VirtualBaliseCover.VirtualBaliseCovers.VBCs == [] @ deadline=1
step No reception of the second balise, messsage still handled
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=17 Q_MEDIA=0 N_PIG=2 N_TOTAL=2 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=1532 Q_LINK=1
expect efs: THERE_IS X IN Kernel.VirtualBaliseCover.VirtualBaliseCovers.VBCs @ deadline=1
