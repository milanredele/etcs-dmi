step BTM Message + some information
sub Receive balise message
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=9618 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=12 Q_DIR=1 L_PACKET=400 Q_SCALE=0 V_MAIN=20 V_EMA=0 T_EMA=0 N_ITER=1 L_SECTION=7000 Q_SECTIONTIMER=0 L_ENDSECTION=10000 Q_SECTIONTIMER=0 Q_ENDTIMER=0 Q_DANGERPOINT=1 D_DP=12000 V_RELEASEDP=5 Q_OVERLAP=0
sub Check new MA
expect efs: Kernel.MA.MA != EMPTY @ deadline=1
expect efs: (LAST X IN Kernel.MA.MA.Sections).Length == 1000.0 @ deadline=1
expect efs: Kernel.MA.MA.TargetSpeed == 0.0 @ deadline=1
expect efs: Kernel.MA.SignallingRelatedSR.Value == 100.0 @ deadline=1
expect efs: (COUNT X IN Kernel.MA.MA.Sections) == 2 @ deadline=1
expect efs: (FIRST X IN Kernel.MA.MA.Sections).Length == 700.0 @ deadline=1
expect efs: Kernel.MA.MA.EndSection.DangerPoint.Distance == 1200.0 @ deadline=1
expect efs: Kernel.MA.MA.EndSection.DangerPoint.ReleaseSpeed == 25.0 @ deadline=1
expect efs: Kernel.SpeedAndDistanceMonitoring.ReleaseSpeedMonitoring.ReleaseSpeed() == 25.0 @ deadline=1
step BTM Message + some NEW information
sub Reset LRBG, linking and position
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9618, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Timestamp => Kernel.DateAndTime.Now(), Position => BTM.PositionStruct { OverReadingAmountOdo => 29.0, Position => 3000.0, UnderReadingAmountOdo => 35.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.position 3110.0
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 90.0, BaliseGroupIdentifier => 9619, CountryIdentifier => 140 }, BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 90.0, BaliseGroupIdentifier => 9620, CountryIdentifier => 140 }] )
expect efs: Kernel.MA.MA != EMPTY @ deadline=1
sub Receive balise message
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=9619 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=12 Q_DIR=1 L_PACKET=400 Q_SCALE=0 V_MAIN=16 V_EMA=10 T_EMA=200 N_ITER=2 L_SECTION=900 Q_SECTIONTIMER=0 L_SECTION=1100 Q_SECTIONTIMER=0 L_ENDSECTION=12000 Q_SECTIONTIMER=0 Q_ENDTIMER=0 Q_DANGERPOINT=1 D_DP=1300 V_RELEASEDP=10 Q_OVERLAP=0
sub Check new MA
expect efs: Kernel.MA.MA != EMPTY @ deadline=1
expect efs: (LAST X IN Kernel.MA.MA.Sections).Length == 1200.0 @ deadline=1
expect efs: Kernel.MA.MA.TargetSpeed == 50.0 @ deadline=1
expect efs: Kernel.MA.MA.TargetSpeedTimeOut == 200.0 @ deadline=1
expect efs: Kernel.MA.SignallingRelatedSR.Value == 80.0 @ deadline=1
expect efs: (COUNT X IN Kernel.MA.MA.Sections) == 3 @ deadline=1
expect efs: (LAST X IN Kernel.MA.MA.Sections | X != (LAST Y IN Kernel.MA.MA.Sections)).Length == 110.0 @ deadline=1
expect efs: (FIRST X IN Kernel.MA.MA.Sections).Length == 90.0 @ deadline=1
expect efs: Kernel.MA.MA.EndSection.DangerPoint.ReleaseSpeed == 50.0 @ deadline=1
expect efs: Kernel.MA.MA.EndSection.DangerPoint.Distance == 130.0 @ deadline=1
expect efs: Kernel.SpeedAndDistanceMonitoring.ReleaseSpeedMonitoring.ReleaseSpeed() == BaseTypes.Speed.NA @ deadline=1
