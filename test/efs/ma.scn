sub Set linkings
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 100.0, BaliseGroupIdentifier => 2124, CountryIdentifier => 140 }] )
step BTM.Message
sub Receive balise message
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=16 V_EMA=8 T_EMA=200 N_ITER=4 L_SECTION=120 Q_SECTIONTIMER=1 D_SECTIONTIMERSTOPLOC=20 T_SECTIONTIMER=40 L_ENDSECTION=1000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=0 D_DP=0 V_RELEASEDP=0 Q_OVERLAP=0 D_STARTOL=0 T_OL=0 D_OL=0 V_RELEASEOL=0
expect efs: THERE_IS X IN Kernel.MA.MA.Sections | ( X.Length == 120.0 AND X.TimeOut.Distance == 20.0 ) @ deadline=1
