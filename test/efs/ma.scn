sub Set up an MA
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct { TargetSpeed => 30.0, TargetSpeedTimeOut => 200.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 12345.0, TimeOut => EMPTY }], EndSection => Kernel.MA.EndSectionStruct { EndSectionTimeOut => EMPTY, DangerPoint => EMPTY, Overlap => EMPTY } }
expect efs: Kernel.MA.SvL.SvL() == EMPTY @ deadline=1
sub Set nominal orientation
taint odo
efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainOrientation <- OrientationEnum.Nominal
step Receive a new MA from a balise with a SvL
sub Pass the first balise
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5461 Q_LINK=0 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=12 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=25 V_EMA=0 T_EMA=500 N_ITER=0 L_ENDSECTION=2800 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=1 D_DP=200 V_RELEASEDP=2 Q_OVERLAP=0 D_STARTOL=0 T_OL=0 D_OL=0 V_RELEASEOL=0
sub Pass the second balise
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5461 Q_LINK=0
expect efs: ((LAST section IN Kernel.MA.MA.Sections).Length + Kernel.MA.MA.EndSection.DangerPoint.Distance) == 3095.0 @ deadline=1
expect efs: Kernel.MA.SvL.SvL().Location == 3095.0 @ deadline=1
expect efs: Kernel.MA.ShorteningHandler.IsSvL == False @ deadline=1
expect efs: Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceivedRegardlessOfSvL @ deadline=1
expect efs: NOT Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceived @ deadline=1
step Receive a new MA from a balise with a closer SvL
sub Pass the first balise
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5466 Q_LINK=0 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=12 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=25 V_EMA=0 T_EMA=150 N_ITER=0 L_ENDSECTION=800 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=1 D_DP=200 V_RELEASEDP=2 Q_OVERLAP=0 D_STARTOL=0 T_OL=0 D_OL=0 V_RELEASEOL=0
sub Pass the second balise
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5466 Q_LINK=0
expect efs: ((LAST section IN Kernel.MA.MA.Sections).Length + Kernel.MA.MA.EndSection.DangerPoint.Distance) == 1095.0 @ deadline=1
expect efs: Kernel.MA.SvL.SvL().Location == 1095.0 @ deadline=1
expect efs: Kernel.MA.ShorteningHandler.Location == 3095.0 @ deadline=1
expect efs: Kernel.MA.ShorteningHandler.IsSvL @ deadline=1
expect efs: Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceived @ deadline=1
expect efs: NOT Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceivedRegardlessOfSvL @ deadline=1
step Receive a new MA from a balise with a LOA
sub Pass the first balise
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5467 Q_LINK=0 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=12 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=25 V_EMA=6 T_EMA=150 N_ITER=0 L_ENDSECTION=250 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=0 D_DP=0 V_RELEASEDP=0 Q_OVERLAP=0 D_STARTOL=0 T_OL=0 D_OL=0 V_RELEASEOL=0
sub Pass the second balise
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5467 Q_LINK=0
expect efs: (LAST X IN Kernel.MA.MA.Sections).Length == 345.0 @ deadline=1
expect efs: Kernel.MA.SvL.SvL() == EMPTY @ deadline=1
expect efs: Kernel.MA.ShorteningHandler.Location == 1095.0 @ deadline=1
expect efs: Kernel.MA.ShorteningHandler.IsSvL @ deadline=1
expect efs: NOT Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceivedRegardlessOfSvL @ deadline=1 cyclephase=Processing
expect efs: NOT Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceived @ deadline=1 cyclephase=Processing
