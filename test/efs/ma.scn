set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
sub Set odometry accuracy
set odo.accuracy D_ura=2.0 D_ora=2.0 V_ora=0.0 V_ura=0.0
sub Check that the setup performed properly
expect efs: Kernel.MA.SvL.SvL().Location == 4500.0 @ deadline=1
expect efs: Kernel.MA.EOA.EOA().Location == 4500.0 @ deadline=1
step Accept repositioning information from linked BG with unknown ID
sub Reset linking data
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 1.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 105.0, BaliseGroupIdentifier => Messages.NID_BG.NID_UNKNOWN, CountryIdentifier => 85 }] )
sub Receive repositioning information
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5461 Q_LINK=1 | REPOSITIONING_INFORMATION NID_PACKET=16 Q_DIR=1 L_PACKET=40 Q_SCALE=1 L_SECTION=2000
sub Second balise for orientation
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5461 Q_LINK=1
expect efs: NOT Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceived @ deadline=1 cyclephase=Processing
expect efs: NOT Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceivedRegardlessOfSvL @ deadline=1 cyclephase=Processing
expect efs: Kernel.MA.EOA.EOA().Location != 4000.0 @ deadline=1 cyclephase=Processing
expect efs: Kernel.MA.EOA.EOA().Location == 2000.0 @ deadline=1 cyclephase=Processing
step Reject repositioning information from an announced BG
sub Reset linking data
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 1.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 105.0, BaliseGroupIdentifier => 5466, CountryIdentifier => 85 }] )
sub Receive repositioning information
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5466 Q_LINK=1 | REPOSITIONING_INFORMATION NID_PACKET=16 Q_DIR=1 L_PACKET=40 Q_SCALE=1 L_SECTION=200
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + 105.0
sub Second balise for orientation
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5466 Q_LINK=1
expect efs: Kernel.MA.EOA.EOA().Location == 1895.0 @ deadline=1
expect efs: NOT Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceived @ deadline=1 cyclephase=Processing
expect efs: NOT Kernel.HandlingOfAcceptedAndStoredInformation.ShortenedMaReceivedRegardlessOfSvL @ deadline=1 cyclephase=Processing
step Encounter BG holding repositioning information in another section
sub Set up an MA and linking information
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct { TargetSpeed => 0.0, Sections => [ Kernel.MA.Sections.SectionStruct{ Length => 400.0, TimeOut => EMPTY }, Kernel.MA.Sections.SectionStruct{ Length => 600.0, TimeOut => EMPTY } ], EndSection => Kernel.MA.EndSectionStruct{ EndSectionTimeOut => EMPTY, DangerPoint => EMPTY, Overlap => EMPTY } }
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 1.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 105.0, BaliseGroupIdentifier => Messages.NID_BG.NID_UNKNOWN, CountryIdentifier => 85 }] )
expect efs: Kernel.MA.EOA.EOA().Location == 1000.0 @ deadline=1
expect efs: (LAST X IN Kernel.MA.MA.Sections).Length == 600.0 @ deadline=1
sub First balise has the packet
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5461 Q_LINK=1 | REPOSITIONING_INFORMATION NID_PACKET=16 Q_DIR=1 L_PACKET=0 Q_SCALE=1 L_SECTION=600
sub Second balise
telegram balise Q_UPDOWN=0 M_VERSION=17 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5461 Q_LINK=1
expect efs: Kernel.MA.EOA.EOA().Location == 1200.0 @ deadline=1
expect efs: (FIRST X IN Kernel.MA.MA.Sections).Length == 600.0 @ deadline=1
expect efs: (LAST X IN Kernel.MA.MA.Sections).Length == 600.0 @ deadline=1
sequence Release speed
case Release speed
clause - absent 3.8.1.1 e) ; efs 3.8.1.1.e
clause - absent 3.8.1.1 ; efs 3.8.1.1
step Setup
sub Initialize test environment
init 100.0 FS
