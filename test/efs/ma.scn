sub Set linking
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 100.0, BaliseGroupIdentifier => 2124, CountryIdentifier => 140 }, BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 0.0, BaliseGroupIdentifier => 2125, CountryIdentifier => 140 }, BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 0.0, BaliseGroupIdentifier => 2126, CountryIdentifier => 140 }, BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 0.0, BaliseGroupIdentifier => 2127, CountryIdentifier => 140 }] )
step SvL Overlap
sub Receive MA + Overlap
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=16 V_EMA=0 T_EMA=200 N_ITER=0 L_ENDSECTION=1000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=0 D_DP=0 V_RELEASEDP=0 Q_OVERLAP=1 D_STARTOL=100 T_OL=40 D_OL=1150 V_RELEASEOL=6
expect efs: Kernel.MA.MA.EndSection.Overlap != EMPTY @ deadline=1
expect efs: Kernel.MA.SvL.SvL().Speed == Kernel.MA.MA.TargetSpeed @ deadline=1
expect efs: Kernel.MA.SvL.SvL() == Kernel.MA.SvL.SupervisedLocation_Overlap() @ deadline=1
expect efs: Kernel.MA.MA.EndSection.DangerPoint == EMPTY @ deadline=1
step SvL DangerPoint
sub Receive MA + Danger Point
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2125 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=16 V_EMA=0 T_EMA=200 N_ITER=0 L_ENDSECTION=1000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=1 D_DP=0 V_RELEASEDP=0 Q_OVERLAP=0 D_STARTOL=100 T_OL=40 D_OL=1150 V_RELEASEOL=6
expect efs: Kernel.MA.MA.EndSection.DangerPoint != EMPTY @ deadline=1
expect efs: Kernel.MA.SvL.SvL().Speed == Kernel.MA.MA.TargetSpeed @ deadline=1
expect efs: Kernel.MA.SvL.SvL() == Kernel.MA.SvL.SupervisedLocation_DangerPoint() @ deadline=1
expect efs: Kernel.MA.MA.EndSection.Overlap == EMPTY @ deadline=1
step SvL EOA
sub Receive MA
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2126 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=16 V_EMA=0 T_EMA=200 N_ITER=0 L_ENDSECTION=1000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=0 D_DP=0 V_RELEASEDP=0 Q_OVERLAP=0 D_STARTOL=100 T_OL=40 D_OL=1150 V_RELEASEOL=6
expect efs: Kernel.MA.SvL.SvL().Speed == Kernel.MA.MA.TargetSpeed @ deadline=1
expect efs: Kernel.MA.SvL.SvL().Location == Kernel.MA.EOA.EOA().Location @ deadline=1
expect efs: Kernel.MA.MA.EndSection.Overlap == EMPTY @ deadline=1
expect efs: Kernel.MA.MA.EndSection.DangerPoint == EMPTY @ deadline=1
case SvL is not defined
clause E3 done 3.8.4.5.2 ; efs 3.8.4.5.2
step Limit of Authority -> No SvL defined
sub Receive MA with LOA
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2127 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=16 V_EMA=8 T_EMA=200 N_ITER=0 L_ENDSECTION=1000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=0 D_DP=0 V_RELEASEDP=0 Q_OVERLAP=0 D_STARTOL=100 T_OL=40 D_OL=1150 V_RELEASEOL=6
expect efs: Kernel.MA.SvL.SvL() == EMPTY @ deadline=1
expect efs: Kernel.MA.MA.TargetSpeed != 0.0 @ deadline=1
