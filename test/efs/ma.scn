# InitializeBrakingParameters
set train.kdry 7 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kdry 5 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 7 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 5 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.eb_step 7 0 0.0 1.0
set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
sub Setup linkings
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 100.0, BaliseGroupIdentifier => 2124, CountryIdentifier => 140 }] )
step New MA received
sub Receive balise message
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=17 V_EMA=8 T_EMA=200 N_ITER=0 L_ENDSECTION=1000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=0 D_DP=0 V_RELEASEDP=0 Q_OVERLAP=0 D_STARTOL=0 T_OL=0 D_OL=0 V_RELEASEOL=0
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9630, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 13.0, Position => 5000.0, UnderReadingAmountOdo => 12.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.accuracy D_ura=15.0 D_ora=17.0 V_ora=0.0 V_ura=0.0
set odo.position 5100.0
expect efs: Kernel.MA.SignallingRelatedSpeedRestrictions ( 500.0 ) == 85.0
step New MA Level2
sub Setup
efs: Kernel.DateAndTime.CurrentTime <- 190.0
efs: Kernel.Level.Value.Value <- LevelEnum.L2
efs: Testing.InitializeEURORADIO()
expect efs: Kernel.MA.SignallingRelatedSpeedRestrictions ( 500.0 ) == 85.0
sub Receive radio message
efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message{ SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message { MOVEMENT_AUTHORITY => Messages.MESSAGE.TRACK_TO_TRAIN.MOVEMENT_AUTHORITY.Message { NID_MESSAGE => 0, L_MESSAGE => 0, T_TRAIN => 189000, M_ACK => Messages.M_ACK.No_acknowledgement_required, NID_LRBG => 9630, LEVEL_2_3_MOVEMENT_AUTHORITY => Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.Message { NID_PACKET => 15, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, V_LOA => 0, T_LOA => 0, N_ITER => 1, Sequence1 => [ Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.SubStructure1 { L_SECTION => 100, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0 } ], L_ENDSECTION => 1000, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0, Q_ENDTIMER => Messages.Q_ENDTIMER.No_End_section_timer_information, T_ENDTIMER => 0, D_ENDTIMERSTARTLOC => 0, Q_DANGERPOINT => Messages.Q_DANGERPOINT.No_danger_point_information, D_DP => 0, V_RELEASEDP => 0, Q_OVERLAP => Messages.Q_OVERLAP.No_overlap_information, D_STARTOL => 0, T_OL => 0, D_OL => 0, V_RELEASEOL => 0 }, Sequence1 => [] } }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal }
expect efs: Kernel.MA.SignallingRelatedSR.Validity == DataStateEnum.Invalid
sequence SvL
case SvL is defined
clause E3 done 3.8.4.5.1 ; efs 3.8.4.5.1
clause E3 done 3.8.4.5.1 a) ; efs 3.8.4.5.1.a
clause E3 done 3.8.4.5.1 b) ; efs 3.8.4.5.1.b
clause E3 done 3.8.4.5.1 c) ; efs 3.8.4.5.1.c
step Setup
