efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 120.0, BaliseGroupIdentifier => 2124, CountryIdentifier => 140 }] )
step New MA with Danger Point received
sub Receive balise message
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=1 L_PACKET=400 Q_SCALE=0 V_MAIN=16 V_EMA=0 T_EMA=0 N_ITER=0 L_ENDSECTION=10000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=1 D_DP=12000 V_RELEASEDP=5 Q_OVERLAP=0 D_STARTOL=0 T_OL=0 D_OL=0 V_RELEASEOL=0
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9628, NID_C => 0, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 21.0, Position => 4400.0, UnderReadingAmountOdo => 21.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.accuracy D_ura=27.0 D_ora=26.0 V_ora=0.0 V_ura=0.0
set odo.position 4520.0
expect efs: Kernel.SpeedAndDistanceMonitoring.ReleaseSpeedMonitoring.ReleaseSpeed() == 25.0
step New MA with Overlap received
sub Set level 2 and initialize RBC
efs: Testing.InitializeEURORADIO()
efs: Kernel.Level.Value.Value <- Default.LevelEnum.L2
sub Receive radio message
efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message { SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message { MOVEMENT_AUTHORITY => Messages.MESSAGE.TRACK_TO_TRAIN.MOVEMENT_AUTHORITY.Message { NID_MESSAGE => 3, L_MESSAGE => 0, T_TRAIN => 120, M_ACK => 0, NID_LRBG => 2295884, LEVEL_2_3_MOVEMENT_AUTHORITY => Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.Message { NID_PACKET => 8, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 400, Q_SCALE => Messages.Q_SCALE._10_cm_scaleC, V_LOA => 0, T_LOA => 0, N_ITER => 0, Sequence1 => [], L_ENDSECTION => 8000, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0, Q_ENDTIMER => Messages.Q_ENDTIMER.No_End_section_timer_information, T_ENDTIMER => 0, D_ENDTIMERSTARTLOC => 0, Q_DANGERPOINT => Messages.Q_DANGERPOINT.No_danger_point_information, D_DP => 0, V_RELEASEDP => 0, Q_OVERLAP => Messages.Q_OVERLAP.Overlap_information_to_follow, D_STARTOL => 10, T_OL => 70, D_OL => 500, V_RELEASEOL => 4 }, Sequence1 => [] }, SR_AUTHORISATION => EMPTY, RECOGNITION_OF_EXIT_FROM_TRIP_MODE => EMPTY, ACKNOWLEDGEMENT_OF_TRAIN_DATA => EMPTY, REQUEST_TO_SHORTEN_MA => EMPTY, CONDITIONAL_EMERGENCY_STOP => EMPTY, UNCONDITIONAL_EMERGENCY_STOP => EMPTY, REVOCATION_OF_EMERGENCY_STOP => EMPTY, GENERAL_MESSAGE => EMPTY, SH_REFUSED => EMPTY, SH_AUTHORISED => EMPTY, MA_WITH_SHIFTED_LOCATION_REFERENCE => EMPTY, TRACK_AHEAD_FREE_REQUEST => EMPTY, INFILL_MA => EMPTY, TRAIN_REJECTED => EMPTY, RIU_SYSTEM_VERSION => EMPTY, INITIATION_OF_A_COMMUNICATION_SESSION => EMPTY, ACKNOWLEDGEMENT_OF_TERMINATION_OF_A_COMMUNICATION_SESSION => EMPTY, TRAIN_ACCEPTED => EMPTY, SOM_POSITION_REPORT_CONFIRMED_BY_RBC => EMPTY, ASSIGNMENT_OF_COORDINATE_SYSTEM => EMPTY, OTHER_MESSAGE => EMPTY, BitField => '' }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal, BitField => '' }
expect efs: Kernel.SpeedAndDistanceMonitoring.ReleaseSpeedMonitoring.ReleaseSpeed() == 20.0
step New MA with Overlap and Danger Point received
sub Receive radio message
efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message { SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message { MOVEMENT_AUTHORITY => Messages.MESSAGE.TRACK_TO_TRAIN.MOVEMENT_AUTHORITY.Message { NID_MESSAGE => 3, L_MESSAGE => 0, T_TRAIN => 204, M_ACK => 0, NID_LRBG => 2295884, LEVEL_2_3_MOVEMENT_AUTHORITY => Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.Message { NID_PACKET => 8, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 400, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, V_LOA => 0, T_LOA => 0, N_ITER => 0, Sequence1 => [], L_ENDSECTION => 800, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0, Q_ENDTIMER => Messages.Q_ENDTIMER.No_End_section_timer_information, T_ENDTIMER => 0, D_ENDTIMERSTARTLOC => 0, Q_DANGERPOINT => Messages.Q_DANGERPOINT.Danger_point_information_to_follow, D_DP => 850, V_RELEASEDP => 6, Q_OVERLAP => Messages.Q_OVERLAP.Overlap_information_to_follow, D_STARTOL => 900, T_OL => 70, D_OL => 100, V_RELEASEOL => 7 }, Sequence1 => [] }, SR_AUTHORISATION => EMPTY, RECOGNITION_OF_EXIT_FROM_TRIP_MODE => EMPTY, ACKNOWLEDGEMENT_OF_TRAIN_DATA => EMPTY, REQUEST_TO_SHORTEN_MA => EMPTY, CONDITIONAL_EMERGENCY_STOP => EMPTY, UNCONDITIONAL_EMERGENCY_STOP => EMPTY, REVOCATION_OF_EMERGENCY_STOP => EMPTY, GENERAL_MESSAGE => EMPTY, SH_REFUSED => EMPTY, SH_AUTHORISED => EMPTY, MA_WITH_SHIFTED_LOCATION_REFERENCE => EMPTY, TRACK_AHEAD_FREE_REQUEST => EMPTY, INFILL_MA => EMPTY, TRAIN_REJECTED => EMPTY, RIU_SYSTEM_VERSION => EMPTY, INITIATION_OF_A_COMMUNICATION_SESSION => EMPTY, ACKNOWLEDGEMENT_OF_TERMINATION_OF_A_COMMUNICATION_SESSION => EMPTY, TRAIN_ACCEPTED => EMPTY, SOM_POSITION_REPORT_CONFIRMED_BY_RBC => EMPTY, ASSIGNMENT_OF_COORDINATE_SYSTEM => EMPTY, OTHER_MESSAGE => EMPTY, BitField => '' }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal, BitField => '' }
