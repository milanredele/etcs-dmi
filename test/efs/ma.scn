sub Sub-step2 - Set linking
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 320.0, BaliseGroupIdentifier => 2124, CountryIdentifier => 140 }] )
step New MA received in BG message, level 1
sub Sub-step 1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=1 L_PACKET=400 Q_SCALE=1 V_MAIN=16 V_EMA=8 T_EMA=200 N_ITER=4 L_SECTION=120 Q_SECTIONTIMER=1 D_SECTIONTIMERSTOPLOC=20 T_SECTIONTIMER=40 L_SECTION=140 Q_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 T_SECTIONTIMER=0 L_SECTION=100 Q_SECTIONTIMER=1 D_SECTIONTIMERSTOPLOC=25 T_SECTIONTIMER=20 L_SECTION=140 Q_SECTIONTIMER=1 D_SECTIONTIMERSTOPLOC=40 T_SECTIONTIMER=25 L_ENDSECTION=1000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=0 D_DP=0 V_RELEASEDP=0 Q_OVERLAP=0 D_STARTOL=0 T_OL=0 D_OL=0 V_RELEASEOL=0
set odo.accuracy D_ura=15.0 D_ora=20.0 V_ora=0.0 V_ura=0.0
set odo.position 4320.0
efs: BTM.LRBG.PreviousBaliseGroups <- [ BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct{ Position => BTM.PositionStruct{ Position => 4000.0, UnderReadingAmountOdo => 12.0, OverReadingAmountOdo => 11.0 }, NID_BG => 9626, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Timestamp => Kernel.DateAndTime.Now(), NID_C => 1 }, IsLRBG => Boolean.True, IsSingle => Boolean.False } ]
expect efs: Available ( Kernel.MA.MA )
expect efs: Available(Kernel.MA.MA.Sections)
step Check EOA + section info
sub Sub-step1
expect efs: Kernel.MA.EOA.EOA().Location == 1500.0
expect efs: (FIRST X IN Kernel.MA.MA.Sections).Length == 120.0
expect efs: (FIRST X IN Kernel.MA.MA.Sections).TimeOut.TimeOut.Duration == 40.0
expect efs: (FIRST X IN Kernel.MA.MA.Sections).TimeOut.Distance == 20.0
expect efs: Available ( ( FIRST X IN Kernel.MA.MA.Sections ).TimeOut )
expect efs: Kernel.MA.EOA.EOA().Speed == 40.0
step New MA received in BG message, level 2
sub SubStep1
efs: Testing.InitializeEURORADIO()
efs: Kernel.Level.Value.Value <- LevelEnum.L2
sub Sub-step2
efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message { SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message { MOVEMENT_AUTHORITY => Messages.MESSAGE.TRACK_TO_TRAIN.MOVEMENT_AUTHORITY.Message { NID_MESSAGE => 3, L_MESSAGE => 0, T_TRAIN => Messages.MESSAGE.TIME_ACCESSORS.Export_T_TRAIN(Kernel.DateAndTime.CurrentTime), M_ACK => 0, NID_LRBG => 26010, LEVEL_2_3_MOVEMENT_AUTHORITY => Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.Message { NID_PACKET => 8, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 400, Q_SCALE => Messages.Q_SCALE._10_m_scaleC, V_LOA => 5, T_LOA => 150, N_ITER => 3, Sequence1 => [Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.SubStructure1 { L_SECTION => 17, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, D_SECTIONTIMERSTOPLOC => 0, T_SECTIONTIMER => 0 }, Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.SubStructure1 { L_SECTION => 20, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, D_SECTIONTIMERSTOPLOC => 0, T_SECTIONTIMER => 0 }, Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.SubStructure1 { L_SECTION => 14, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.Section_Timer_information_to_follow, D_SECTIONTIMERSTOPLOC => 25, T_SECTIONTIMER => 70 }], L_ENDSECTION => 80, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0, Q_ENDTIMER => Messages.Q_ENDTIMER.No_End_section_timer_information, T_ENDTIMER => 0, D_ENDTIMERSTARTLOC => 0, Q_DANGERPOINT => Messages.Q_DANGERPOINT.No_danger_point_information, D_DP => 0, V_RELEASEDP => 0, Q_OVERLAP => Messages.Q_OVERLAP.No_overlap_information, D_STARTOL => 0, T_OL => 0, D_OL => 0, V_RELEASEOL => 0 }, Sequence1 => [] }, SR_AUTHORISATION => EMPTY, RECOGNITION_OF_EXIT_FROM_TRIP_MODE => EMPTY, ACKNOWLEDGEMENT_OF_TRAIN_DATA => EMPTY, REQUEST_TO_SHORTEN_MA => EMPTY, CONDITIONAL_EMERGENCY_STOP => EMPTY, UNCONDITIONAL_EMERGENCY_STOP => EMPTY, REVOCATION_OF_EMERGENCY_STOP => EMPTY, GENERAL_MESSAGE => EMPTY, SH_REFUSED => EMPTY, SH_AUTHORISED => EMPTY, MA_WITH_SHIFTED_LOCATION_REFERENCE => EMPTY, TRACK_AHEAD_FREE_REQUEST => EMPTY, INFILL_MA => EMPTY, TRAIN_REJECTED => EMPTY, RIU_SYSTEM_VERSION => EMPTY, INITIATION_OF_A_COMMUNICATION_SESSION => EMPTY, ACKNOWLEDGEMENT_OF_TERMINATION_OF_A_COMMUNICATION_SESSION => EMPTY, TRAIN_ACCEPTED => EMPTY, SOM_POSITION_REPORT_CONFIRMED_BY_RBC => EMPTY, ASSIGNMENT_OF_COORDINATE_SYSTEM => EMPTY, BitField => '' }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal, BitField => '' }
expect efs: Available ( Kernel.MA.MA )
expect efs: Available(Kernel.MA.MA.Sections)
step Check EOA + section info
sub Sub-step1
expect efs: Kernel.MA.EOA.EOA().Location == 995.0
expect efs: (FIRST X IN Kernel.MA.MA.Sections).TimeOut == EMPTY
expect efs: (FIRST X IN Kernel.MA.MA.Sections).Length == 55.0
expect efs: Kernel.MA.EOA.EOA().Speed == 25.0
sequence MA update - MA shortening
case MA shortening
clause E5 done 3.8.5.1.3 ; efs 3.8.5.1.3
clause E5 done 3.8.5.2.4 ; efs 3.8.5.2.4
clause E5 done 3.8.5.1.4 ; efs 3.8.5.1.4
step Setup MA with LOA
sub Initialize test environment
init 100.0 FS
# the defaults of the EFS model (TrainDataValuesStruct, TIU)
set train.data_state unknown
