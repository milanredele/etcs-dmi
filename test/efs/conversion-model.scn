set train.length 300.0
sub Sub-step2 - Data check
expect T_brake_service_cm0 == 14.08
expect efs: Kernel.TrainData.BrakingParameters.ConversionModel.ServiceBrakes.T_brake_basic_sb () == 14.08
expect T_brake_service_cmt == 16.3328
step Freight train in G, train length > 900m, target speed equals 0
sub Sub-step1 - Setup
set train.brake_position freight_g
set train.length 1300.0
sub Sub-step2 - Data check
expect T_brake_service_cm0 == 45.08
expect efs: Kernel.TrainData.BrakingParameters.ConversionModel.ServiceBrakes.T_brake_basic_sb () == 45.08
expect T_brake_service_cmt == 52.2928
