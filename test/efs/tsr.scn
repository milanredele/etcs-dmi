case Provide several TSRs
clause - absent 3.11.5.2 ; efs 3.11.5.2
clause E3 done 3.11.5.4 ; efs 3.11.5.4
step Provide the first TSR
sub Sub-step1
set odo.position 3050.0
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9616, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 2.0, Position => 3000.0, UnderReadingAmountOdo => 3.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set tsrs 
taint odo
efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainOrientation <- OrientationEnum.Nominal
sub Sub-step2
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | TEMPORARY_SPEED_RESTRICTION NID_PACKET=65 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_TSR=15 D_TSR=4000 L_TSR=1500 Q_FRONT=1 V_TSR=5
sub Sub-step3
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1
step Check the first TSR
sub Sub-step1
expect efs: Kernel.TSR.SpeedRestrictions ( 3000.0 ) == BaseTypes.Speed.MaxSpeed
expect TSR 4000.0 == 25.0
expect efs: Kernel.TSR.SpeedRestrictions ( 5500.0 ) == BaseTypes.Speed.MaxSpeed
expect TSR 5499.0 == 25.0
expect efs: ( COUNT X IN Kernel.TSR.TSRs ) == 1 @ deadline=1
step Provide the second TSR
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2125 Q_LINK=1 | TEMPORARY_SPEED_RESTRICTION NID_PACKET=65 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_TSR=16 D_TSR=3000 L_TSR=3000 Q_FRONT=1 V_TSR=10
sub Sub-step2
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2125 Q_LINK=1
step Check the second TSR
sub Sub-step1
expect efs: Kernel.TSR.SpeedRestrictions ( 2000.0 ) == BaseTypes.Speed.MaxSpeed
expect TSR 3000.0 == 50.0
expect TSR 4000.0 == 25.0
expect TSR 5500.0 == 50.0
expect efs: Kernel.TSR.SpeedRestrictions ( 6000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: ( COUNT X IN Kernel.TSR.TSRs ) == 2 @ deadline=1
case Revoke a TSR
clause E3 done 3.11.5.5 ; efs 3.11.5.5
clause E3 done 3.11.5.8 ; efs 3.11.5.8
step Provide revocation of the first TSR
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | TEMPORARY_SPEED_RESTRICTION_REVOCATION NID_PACKET=66 Q_DIR=2 L_PACKET=400 NID_TSR=15
sub Sub-step2
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=0
step Check TSR revoked
sub Sub-step1
expect TSR 4000.0 == 50.0
expect TSR 5000.0 == 50.0
expect efs: Kernel.TSR.SpeedRestrictions ( 6000.0 ) == BaseTypes.Speed.MaxSpeed
expect TSR 3000.0 == 50.0
expect efs: ( COUNT X IN Kernel.TSR.TSRs ) == 1 @ deadline=1
case Train passes the TSR
clause - absent Entry 3.A3.1.1.27 ; efs Entry 3.A3.1.1.27
clause E4 todo A.3.6.2.1 ; efs 3.A3.6.2.1
step Train has almost passed the TSR
sub SubStep1
taint odo
efs: Odometry.NominalDistance <- (FIRST X IN Kernel.TSR.TSRs).Location + BaseTypes.LengthToDistance ((FIRST X IN Kernel.TSR.TSRs).Length) + BTM.LRBG.LRBG().Position.Position + Kernel.DistanceToKeepInfoInTheRear + Kernel.TrainPosition.FrontEndPosition ( PointOfInterest=>DistanceIntervalEnum.Nom ) - Kernel.TrainPosition.RearEndPosition ( PointOfInterest=>DistanceIntervalEnum.Min ) - 1.0
step The TSR is not revoked
sub SubStep1
expect efs: ( COUNT X IN Kernel.TSR.TSRs ) == 1 @ deadline=1
step Train passed the TSR
sub Sub-step1
taint odo
efs: Odometry.NominalDistance <- (FIRST X IN Kernel.TSR.TSRs).Location + BaseTypes.LengthToDistance ((FIRST X IN Kernel.TSR.TSRs).Length) + BTM.LRBG.LRBG().Position.Position + Kernel.DistanceToKeepInfoInTheRear + Kernel.TrainPosition.FrontEndPosition ( PointOfInterest=>DistanceIntervalEnum.Nom ) - Kernel.TrainPosition.RearEndPosition ( PointOfInterest=>DistanceIntervalEnum.Min )
step Check TSR is revoked
sub Sub-step1
expect efs: Kernel.TSR.SpeedRestrictions ( 3000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.TSR.SpeedRestrictions ( 6000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.TSR.SpeedRestrictions ( 4000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.TSR.SpeedRestrictions ( 5000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: ( COUNT X IN Kernel.TSR.TSRs ) == 0 @ deadline=1
