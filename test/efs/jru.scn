end init
step Ensure that there is no JRU messages
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.NTC_SELECTED == EMPTY @ deadline=5.5
expect efs: FORALL X IN JRU.Messages | X.GENERAL_MESSAGE == EMPTY @ deadline=1
step Level changes
sub SubStep1
efs: Kernel.Level.Value.Value <- LevelEnum.L1
efs: Kernel.Level.DataState <- DataStateEnum.Valid
expect efs: THERE_IS X IN JRU.Messages | X.GENERAL_MESSAGE != EMPTY @ deadline=1
step Ensure that the first JRU GENERAL message has been sent
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.GENERAL_MESSAGE == EMPTY @ deadline=1
expect efs: FORALL X IN JRU.Messages | X.NTC_SELECTED == EMPTY @ deadline=5.5
step Level changes again
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.GENERAL_MESSAGE == EMPTY @ deadline=1
sub Sub-step2
efs: Kernel.Level.DataState <- DataStateEnum.Valid
efs: Kernel.Level.Value.Value <- LevelEnum.LNTC
efs: Kernel.Level.Value.NTC <- 254
expect efs: THERE_IS X IN JRU.Messages | X.GENERAL_MESSAGE != EMPTY @ deadline=1
expect efs: FORALL X IN JRU.Messages | X.NTC_SELECTED == EMPTY @ deadline=1
step Ensure that no JRU GENERAL message has been sent
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.NTC_SELECTED == EMPTY @ deadline=1
expect efs: FORALL X IN JRU.Messages | X.GENERAL_MESSAGE == EMPTY @ deadline=1
