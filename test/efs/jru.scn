efs: Kernel.Level.Value.Value <- LevelEnum.L1
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct { TargetSpeed => 0.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 3000.0, TimeOut => EMPTY }] }
step Ensure that there is no JRU messages
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.GENERAL_MESSAGE == EMPTY @ deadline=5.5
step Mode Changes
sub SubStep1
efs: Testing.SetFSMode(False)
expect efs: JRU.LastMode != Kernel.Mode @ deadline=1
expect efs: THERE_IS X IN JRU.Messages | X.GENERAL_MESSAGE.HEADER.MODE == JRU.Header.ToJRUMode( mode=>Kernel.Mode ) @ deadline=1
expect efs: THERE_IS X IN JRU.Messages | X.GENERAL_MESSAGE.HEADER.MODE == JRU.Header.ToJRUMode( mode=>ModeEnum.FS ) @ deadline=1
step Ensure that the first JRU GENERAL message has been sent
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.GENERAL_MESSAGE == EMPTY @ deadline=1
