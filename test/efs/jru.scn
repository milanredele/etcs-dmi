sub SubStep1
efs: INSERT Kernel.BrakeCommands.BrakeCommandStruct{ Reason => Kernel.BrakeCommands.BrakeReasonEnum.TextMessageAckTimeOut, StartTime => Kernel.DateAndTime.Now() } IN Kernel.BrakeCommands.EmergencyBrakeCommands
