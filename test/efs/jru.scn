step Traction Status Changes
sub SubStep1
efs: TIU.TractionIsOn <- True
expect efs: THERE_IS X IN JRU.Messages | X.TRACTION_STATUS != EMPTY @ deadline=1
step Verification that the Messages has been sent
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.TRACTION_STATUS == EMPTY @ deadline=1
step The Traction Status variable changes again
sub SubStep1
efs: TIU.TractionIsOn <- False
expect efs: THERE_IS X IN JRU.Messages | X.TRACTION_STATUS != EMPTY @ deadline=1
step Verify the Message has benn succesfully sent
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.TRACTION_STATUS == EMPTY @ deadline=1
