step Change the National System Isolation value again
sub SubStep1
efs: TIU.NTCIsolated <- False
expect efs: THERE_IS X IN JRU.Messages | X.NATIONAL_SYSTEM_ISOLATION != EMPTY @ deadline=1
step Verify the Message has been succesfully sent
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.NATIONAL_SYSTEM_ISOLATION == EMPTY @ deadline=1
