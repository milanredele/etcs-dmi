set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
expect efs: JRU.Messages == [] @ deadline=1
step Verification there is no Service Brake Command on the JRU
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.SERVICE_BRAKE_COMMAND_STATE == EMPTY @ deadline=1
expect efs: JRU.Messages == [] @ deadline=1
step Service brake is applied
sub SubStep1
efs: INSERT Kernel.BrakeCommands.BrakeCommandStruct { Reason => Kernel.BrakeCommands.BrakeReasonEnum.TrainDataChanged, StartTime => Kernel.DateAndTime.Now() } IN Kernel.BrakeCommands.ServiceBrakeCommands
expect efs: THERE_IS X IN JRU.Messages | X.SERVICE_BRAKE_COMMAND_STATE != EMPTY @ deadline=1
expect efs: THERE_IS X IN JRU.Messages | X.SERVICE_BRAKE_COMMAND_STATE.M_BRAKE_COMMAND_STATE == Messages.JRU.M_BRAKE_COMMAND_STATE.Commanded @ deadline=1
step Verification the JRU Service Brake Command is Empty
sub SubStep1
expect efs: JRU.Messages == [] @ deadline=1
expect efs: FORALL X IN JRU.Messages | X.SERVICE_BRAKE_COMMAND_STATE == EMPTY @ deadline=1
step Service Brake Changes again
sub SubStep1
efs: Kernel.BrakeCommands.ServiceBrakeCommands <- []
expect efs: THERE_IS X IN JRU.Messages | X.SERVICE_BRAKE_COMMAND_STATE != EMPTY @ deadline=1
expect efs: THERE_IS X IN JRU.Messages | X.SERVICE_BRAKE_COMMAND_STATE.M_BRAKE_COMMAND_STATE == Messages.JRU.M_BRAKE_COMMAND_STATE.Not_commanded @ deadline=1
sequence Telegram From Balise when a Telegram From Balise has been received
