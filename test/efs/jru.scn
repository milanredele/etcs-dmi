step Start the procedure Train data verification in the SM of the Kernel
sub SubStep1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.StartOfMission.S12
efs: DMI.MasterDMI().In_TrainDataEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_TrainData.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
step Finish the procedure verification of train data on the kernel and checkl the message has been sent
sub SubStep1
efs: DMI.MasterDMI().In_TrainData.InputInformation.RequestStatus <- RequestEnum.Response
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.StartOfMission.D12 @ deadline=1
expect efs: Kernel.TrainData.TrainData.DataState == DataStateEnum.Valid @ deadline=1
expect efs: THERE_IS X IN JRU.Messages | X.TRAIN_DATA != EMPTY @ deadline=1
