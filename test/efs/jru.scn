expect efs: JRU.GeneralMessage.TimerElapsed() @ deadline=0.1
step Ensure the period has passed again
sub SubStep1
expect efs: FORALL X IN JRU.Messages | X.GENERAL_MESSAGE == EMPTY @ deadline=1
expect efs: NOT JRU.GeneralMessage.TimerElapsed() @ kind=continuous deadline=4.4
step Ensure that the JRU GENERAL message is sent after the second period
sub SubStep1
expect efs: JRU.GeneralMessage.TimerElapsed() @ deadline=0.1
expect efs: THERE_IS X IN JRU.Messages | X.GENERAL_MESSAGE != EMPTY @ deadline=0.1
