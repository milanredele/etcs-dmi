set train.sb_model 7 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 0 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.length 197.0
