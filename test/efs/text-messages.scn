ICTION => EMPTY, INHIBITION_OF_BALISE_GROUP_MESSAGE_CONSISTENCY_REACTION => EMPTY, DEFAULT_BALISE_LOOP_OR_RIU_INFORMATION => EMPTY, DATA_USED_BY_APPLICATIONS_OUTSIDE_THE_ERTMS_ETCS_SYSTEM => EMPTY, VIRTUAL_BALISE_COVER_ORDER => EMPTY, LSSMA_DISPLAY_TOGGLE_ORDER => EMPTY, GENERIC_LS_FUNCTION_MARKER => EMPTY, END_OF_INFORMATION => EMPTY } }, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY], BitField => '' }
sub Check the text is stored but not displayed
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ blocking=FALSE
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 0 @ blocking=FALSE
sub The train is before the display location
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + 394.0
sub Check the text message is not displayed
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ blocking=FALSE
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 0 @ blocking=FALSE
sub The train reaches the display location
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + 1.0
sub Check the text is displayed
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ blocking=FALSE
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 1 @ blocking=FALSE
sub The train is before the end display location
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + 99.9
sub Check the text is still displayed
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ blocking=FALSE
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 1 @ blocking=FALSE
sub The train reaches the end display location
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + 1.0
sub Check the text is not displayed anymore
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 0 @ blocking=FALSE
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 0 @ blocking=FALSE
case Plain text message limited by time
clause - absent 3.12.3.1.1 ; efs 3.12.3.1.1
clause - absent 3.12.3.4.3 ; efs 3.12.3.4.3
clause - absent 3.12.3.4.3 b) ; efs 3.12.3.4.3.b
clause E4 todo 3.12.3.4.3.1 ; efs 3.12.3.4.3.1
step Setup
