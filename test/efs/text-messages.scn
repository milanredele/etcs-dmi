efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainOrientation <- OrientationEnum.Nominal
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 278, BGOrientation => Default.OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 3.0, Position => 1080.0, UnderReadingAmountOdo => 3.0 }, Timestamp => DateAndTimeStruct { Year => 2012, Month => 12, Day => 20, Hour => 20, Minute => 12, Second => 20, TTS => 600 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.position 2000.0
efs: DMI.MasterDMI().Out_PlainTextInformation.OutputInformation.DisplayRequested <- False
step Reception of plain text message depending on distance
sub Reception of the balise group
taint track nv ma
efs: BTM.Message.SystemVersion2 <- Messages.EUROBALISE.Message { Q_UPDOWN => Messages.Q_UPDOWN.Up_link_telegram, M_VERSION => Messages.M_VERSION.Version_2_0__introduced_in_SRS_3_0_0, Q_MEDIA => Messages.Q_MEDIA.Balise, N_PIG => Messages.N_PIG._1C, N_TOTAL => Messages.N_TOTAL._1_balise_in_groupC, M_DUP => Messages.M_DUP.No_duplicates, M_MCOUNT => 4, NID_C => 20, NID_BG => 280, Q_LINK => Messages.Q_LINK.Linked, Sequence1 => [Messages.EUROBALISE.SubStructure1 { TRACK_TO_TRAIN => Messages.PACKET.TRACK_TO_TRAIN.Message { PACKET_FOR_SENDING_PLAIN_TEXT_MESSAGES => Messages.PACKET.TRACK_TO_TRAIN.PACKET_FOR_SENDING_PLAIN_TEXT_MESSAGES.Message { Q_DIR => Messages.Q_DIR.Both_directions, Sequence1 => [Messages.PACKET.TRACK_TO_TRAIN.PACKET_FOR_SENDING_PLAIN_TEXT_MESSAGES.SubStructure1 { X_TEXT => 'T' }, Messages.PACKET.TRACK_TO_TRAIN.PACKET_FOR_SENDING_PLAIN_TEXT_MESSAGES.SubStructure1 { X_TEXT => 'e' }, Messages.PACKET.TRACK_TO_TRAIN.PACKET_FOR_SENDING_PLAIN_TEXT_MESSAGES.SubStructure1 { X_TEXT => 'x' }, Messages.PACKET.TRACK_TO_TRAIN.PACKET_FOR_SENDING_PLAIN_TEXT_MESSAGES.SubStructure1 { X_TEXT => 't' }, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY], NID_PACKET => 72, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, Q_TEXTCLASS => Messages.Q_TEXTCLASS.Auxiliary_Information, Q_TEXTDISPLAY => Messages.Q_TEXTDISPLAY.No__display_as_soon_as___until_one_of_the_events_is_fulfilled, D_TEXTDISPLAY => 400, M_MODETEXTDISPLAY_0 => Messages.M_MODETEXTDISPLAY.The_display_of_the_text_shall_not_be_limited_by_the_mode, M_LEVELTEXTDISPLAY_0 => Messages.M_LEVELTEXTDISPLAY.The_display_of_the_text_shall_not_be_limited_by_the_level, NID_NTC_0 => 20, L_TEXTDISPLAY => 100, T_TEXTDISPLAY => 1000, M_MODETEXTDISPLAY_1 => Messages.M_MODETEXTDISPLAY.The_display_of_the_text_shall_not_be_limited_by_the_mode, M_LEVELTEXTDISPLAY_1 => Messages.M_LEVELTEXTDISPLAY.The_display_of_the_text_shall_not_be_limited_by_the_level, NID_NTC_1 => 0, Q_TEXTCONFIRM => Messages.Q_TEXTCONFIRM.No_confirmation_required, Q_CONF