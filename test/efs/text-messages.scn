NS_OUTSIDE_THE_ERTMS_ETCS_SYSTEM => EMPTY, VIRTUAL_BALISE_COVER_ORDER => EMPTY, LSSMA_DISPLAY_TOGGLE_ORDER => EMPTY, GENERIC_LS_FUNCTION_MARKER => EMPTY, END_OF_INFORMATION => EMPTY } }, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY], BitField => '' }
sub Check the text is stored but not displayed
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ blocking=FALSE
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 0 @ blocking=FALSE
sub The mode changes
efs: Testing.SetUNMode( HandleModeChange => False )
sub Check the text is not displayed
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 0 @ blocking=FALSE
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ blocking=FALSE
sub The level changes
efs: Kernel.Level.Value.Value <- Default.LevelEnum.L0
sub Check the text is not displayed
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 0 @ blocking=FALSE
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ blocking=FALSE
sub The train achieves the display location
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + 400.0
sub Check the text is displayed
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 1 @ blocking=FALSE
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ blocking=FALSE
sub The train reaches the display stop location
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + 100.0
sub Check the text is still displayed
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 1 @ blocking=FALSE
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ deadline=1
sub The timer expires
efs: Kernel.DateAndTime.CurrentTime <- Kernel.DateAndTime.CurrentTime + 20.0
sub Check the text is still displayed
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 1 @ blocking=FALSE
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 1 @ deadline=1
sub The level changes
efs: Kernel.Level.Value.Value <- Default.LevelEnum.L1
sub Check the text is not displayed anymore
expect efs: COUNT X IN DMI.MasterDMI().Out_PlainTextInformation.Messages == 0 @ blocking=FALSE
expect efs: COUNT X IN Kernel.TextMessages.PlainTextMessages == 0 @ deadline=1
