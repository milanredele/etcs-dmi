sequence Packet 72
case Packet 72 - Packet for sending plain text messages
clause - absent Entry 6.6.3.2.3.1.27 ; efs Entry 6.6.3.2.3.1.27
clause - absent 6.6.3.2.3.8 ; efs 6.6.3.2.3.8
step Setup
sub Sub-step1
init 100.0 SR
# the defaults of the EFS model (TrainDataValuesStruct, TIU)
set train.data_state unknown
set train.length 400.0
set train.v_max 150.0
set train.lambda na
set train.brake_position passenger_p
set train.m_rotating_nom na
set train.interface regenerative none
set train.interface eddy_current none
set train.interface magnetic_shoe none
set train.interface ep none
set train.sb_command false
set train.sb_feedback false
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.eb_models clear
set train.sb_models clear
set train.nsb clear
set train.t_brake_emergency clear
set train.t_brake_service clear
set train.kn_plus clear
set train.kn_minus clear
set tiu.active regenerative true
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active ep true
set tiu.additional true
set config.additional_brake_allowed false
set track_conditions
set gradients
set adhesion
set adhesion.driver_slippery false
set tsrs
set odo.speed 0.0
set odo.accel 0.0
set nv defaults
# the EFS test environment (Testing.InitializeTestEnvironment)
set odo.accuracy D_ura=0.0 D_ora=0.0 V_ura=0.0 V_ora=0.0
# InitializeTrainData_ERA
# efs: BTM.ActiveAntennaPosition <- 5.0
set config.additional_brake_allowed true
set train.brake_position passenger_p
set train.eb_models clear
set train.eb_model 2 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 4 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 1 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 6 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 3 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 5 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 7 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 0 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.m_rotating_nom na
set train.v_max 220.0
set train.sb_command true
set train.sb_models clear
set train.sb_model 2 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 4 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 1 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 6 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 3 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 5 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 7 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 0 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.length 197.0
# efs: Kernel.TrainData.TrainData.Value.LoadingGauge <- Messages.M_LOADINGGAUGE.G1
# efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- 2
# efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [Kernel.TrainData.TractionSystemStruct{ Voltage => Messages.M_VOLTAGE.AC_15_kV_16_7_Hz, Country => 85 }]
# InitializeBrakingParameters
set train.kdry 7 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kdry 5 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 7 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 5 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.eb_step 7 0 0.0 1.0
set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
