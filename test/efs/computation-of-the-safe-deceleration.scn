expect Kv_int 300.0 < 0.9663
expect Kv_int 50.0 < 0.5752
expect Kv_int 75.0 < 0.5752
step A_P23 <= A_ebmax
sub Sub-step1
set nv A_NVP23 0.7
expect Kv_int 0.0 == 0.28
expect Kv_int 25.0 == 0.47
expect Kv_int 50.0 == 0.58
expect Kv_int 75.0 == 0.58
