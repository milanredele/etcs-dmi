expect Kv_int 150.0 == 0.78
expect Kv_int 200.0 == 0.97
expect Kv_int 300.0 == 0.97
case Check Kv_int values from National Values (Freight train)
clause - absent 3.13.2.3.7.11 ; efs 3.13.2.3.7.11
clause - absent 3.13.2.3.7.11.1 ; efs 3.13.2.3.7.11.1
clause - absent 3.13.2.3.7.11.3 ; efs 3.13.2.3.7.11.3
