# efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- 2
# efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [Kernel.TrainData.TractionSystemStruct{ Voltage => Messages.M_VOLTAGE.AC_15_kV_16_7_Hz, Country => 85 }]
# InitializeBrakingParameters
set train.kdry 7 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kdry 5 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 7 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 5 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.eb_step 7 0 0.0 1.0
set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
step Setup
sub Sub-step1
set gradients 
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct{ NID_BG=> 9616, BGOrientation=> OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Timestamp => Kernel.DateAndTime.Now(), Position=> BTM.PositionStruct{ OverReadingAmountOdo => 0.0, Position => 4000.0, UnderReadingAmountOdo => 0.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.position 4200.0
efs: Testing.InitializeLinkings( [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 200.0, BaliseGroupIdentifier => 2124, CountryIdentifier => 140 },BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 0.0, BaliseGroupIdentifier => 2125, CountryIdentifier => 140 }] )
efs: Kernel.Level.Value.Value <- LevelEnum.L1
step Receive gradient profile
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | GRADIENT_PROFILE NID_PACKET=21 Q_DIR=1 L_PACKET=400 Q_SCALE=1 D_GRADIENT=4000 Q_GDIR=1 G_A=2 N_ITER=3 D_GRADIENT=2000 Q_GDIR=0 G_A=1 D_GRADIENT=1000 Q_GDIR=0 G_A=4 D_GRADIENT=5000 Q_GDIR=1 G_A=255
expect efs: (FIRST X IN Kernel.TrackDescription.Gradient.Gradients).Location == 4000.0
expect efs: (COUNT X IN Kernel.TrackDescription.Gradient.Gradients) == 4 @ deadline=1
expect efs: (LAST X IN Kernel.TrackDescription.Gradient.Gradients).Location == 12000.0 @ deadline=1
step Receive new gradient profile with no overwriting
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2125 Q_LINK=1 | GRADIENT_PROFILE NID_PACKET=21 Q_DIR=1 L_PACKET=400 Q_SCALE=1 D_GRADIENT=13000 Q_GDIR=1 G_A=3 N_ITER=1 D_GRADIENT=1000 Q_GDIR=0 G_A=2
sub Sub-step2
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2125 Q_LINK=1
step Check that no overwriting has occured
sub Sub-step1
expect efs: ( FIRST X IN Kernel.TrackDescription.Gradient.Gradients).Location == 4000.0 @ deadline=1
expect efs: (COUNT X IN Kernel.TrackDescription.Gradient.Gradients) == 6 @ deadline=1
expect efs: (LAST X IN Kernel.TrackDescription.Gradient.Gradients).Location == 14000.0 @ deadline=1
