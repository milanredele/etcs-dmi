end init
sub Disable override request
efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus <- Default.RequestEnum.Disabled
sub Set train data
set train.data_state valid
sub Set speed
set odo.speed 20.0
taint nv
efs: Kernel.NationalValues.CurrentNV().SpeedLimitForTriggeringTheOverrideFunction <- 20.0
step Check override is proposed
sub Check override is proposed
expect efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
step Train Data condition is not satisfied anymore
sub Train data condition is not satisfied anymore
set train.data_state invalid
step Check override is not proposed anymore
sub Check override is not proposed anymore
expect efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
