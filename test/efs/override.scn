sub Setup for BG reception
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 255, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Timestamp => Kernel.DateAndTime.Now(), Position => BTM.PositionStruct { OverReadingAmountOdo => 2.0, Position => 0.0, UnderReadingAmountOdo => 2.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.position 0.0
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{ TargetSpeed => 0.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 2000.0, TimeOut => EMPTY }] }
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
sub Set Train Data and speed
efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus <- Default.RequestEnum.Disabled
taint nv
efs: Kernel.NationalValues.CurrentNV().SpeedLimitForTriggeringTheOverrideFunction <- 20.0
set odo.speed 12.0
set train.data_state valid
sub Check override is proposed
expect efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Check EoA value
expect efs: Kernel.MA.EOA.EOA().Location == 2000.0 @ deadline=1
sub Trigger Override
efs: DMI.MasterDMI().In_OverrideRequest.ProvideDriverResponse()
step Former EoA is deleted when Stop in SR is received
sub Check former EoA value
expect efs: Kernel.Override.OverrideSupervision.FormerEOA == 2000.0 @ deadline=1
expect efs: Kernel.Mode == ModeEnum.SR @ deadline=1
sub Provide Stop in SR information
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=1 NID_C=80 NID_BG=256 Q_LINK=0 | STOP_IF_IN_STAFF_RESPONSIBLE Q_SRSTOP=0 NID_PACKET=137 Q_DIR=2 L_PACKET=0
set odo.position 250.0
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 256, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 2.0, Position => 250.0, UnderReadingAmountOdo => 2.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
sub Check former EoA is deleted
expect efs: Kernel.Override.OverrideSupervision.FormerEOA == BaseTypes.Distance.Infinity @ deadline=1
sequence Once Override is triggered
case Trigger Override
clause E4 done 5.8.2.1 ; efs 5.8.2.1
clause E4 done 5.8.2.1 a) ; efs 5.8.2.1.a
clause E4 done 5.8.2.1 b) ; efs 5.8.2.1.b
clause E4 done 5.8.2.1 c) ; efs 5.8.2.1.c
clause E4 done 5.8.2.3 ; efs 5.8.2.3
clause - absent 5.8.3.4 ; efs 5.8.3.4
clause - absent 5.8.3.5 ; efs 5.8.3.5
clause E4 done 5.8.3.7 ; efs 5.8.3.7
step Setup
