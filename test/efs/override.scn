sub Setup for MA reception
taint ma track
efs: Testing.InitializeElementsForMA()
efs: Kernel.Level.Value.Value <- Default.LevelEnum.L2
efs: Testing.InitializeEURORADIO()
sub Set Train Data and speed
efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus <- Default.RequestEnum.Disabled
taint nv
efs: Kernel.NationalValues.CurrentNV().SpeedLimitForTriggeringTheOverrideFunction <- 20.0
set odo.speed 12.0
set train.data_state valid
sub Check override is proposed
expect efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Trigger Override
efs: DMI.MasterDMI().In_OverrideRequest.ProvideDriverResponse()
step Check end of Override when MA is received from the RBC
sub Check Override is activate
expect efs: Kernel.Override.OverrideIsActive() @ deadline=1
sub MA is received from the RBC
efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message { SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message { MOVEMENT_AUTHORITY => Messages.MESSAGE.TRACK_TO_TRAIN.MOVEMENT_AUTHORITY.Message { NID_MESSAGE => 0, L_MESSAGE => 0, T_TRAIN => Messages.MESSAGE.TIME_ACCESSORS.Export_T_TRAIN(Kernel.DateAndTime.CurrentTime), M_ACK => Messages.M_ACK.No_acknowledgement_required, NID_LRBG => 9627, LEVEL_2_3_MOVEMENT_AUTHORITY => Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.Message { NID_PACKET => 15, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._10_cm_scaleC, V_LOA => 0, T_LOA => 0, N_ITER => 1, Sequence1 => [Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.SubStructure1 { L_SECTION => 100, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0 }], L_ENDSECTION => 1000, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0, Q_ENDTIMER => Messages.Q_ENDTIMER.No_End_section_timer_information, T_ENDTIMER => 0, D_ENDTIMERSTARTLOC => 0, Q_DANGERPOINT => Messages.Q_DANGERPOINT.No_danger_point_information, D_DP => 0, V_RELEASEDP => 0, Q_OVERLAP => Messages.Q_OVERLAP.No_overlap_information, D_STARTOL => 0, T_OL => 0, D_OL => 0, V_RELEASEOL => 0 }, Sequence1 => [] }, SR_AUTHORISATION => EMPTY, RECOGNITION_OF_EXIT_FROM_TRIP_MODE => EMPTY, ACKNOWLEDGEMENT_OF_TRAIN_DATA => EMPTY, REQUEST_TO_SHORTEN_MA => EMPTY, CONDITIONAL_EMERGENCY_STOP => EMPTY, UNCONDITIONAL_EMERGENCY_STOP => EMPTY, REVOCATION_OF_EMERGENCY_STOP => EMPTY, GENERAL_MESSAGE => EMPTY, SH_REFUSED => EMPTY, SH_AUTHORISED => EMPTY, MA_WITH_SHIFTED_LOCATION_REFERENCE => EMPTY, TRACK_AHEAD_FREE_REQUEST => EMPTY, INFILL_MA => EMPTY, TRAIN_REJECTED => EMPTY, RIU_SYSTEM_VERSION => EMPTY, INITIATION_OF_A_COMMUNICATION_SESSION => EMPTY, ACKNOWLEDGEMENT_OF_TERMINATION_OF_A_COMMUNICATION_SESSION => EMPTY, TRAIN_ACCEPTED => EMPTY, SOM_POSITION_REPORT_CONFIRMED_BY_RBC => EMPTY, ASSIGNMENT_OF_COORDINATE_SYSTEM => EMPTY, BitField => '' }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal, BitField => '' }
set odo.position 4150.0
