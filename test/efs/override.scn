sub Setup for BG reception
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 255, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Timestamp => Kernel.DateAndTime.Now(), Position => BTM.PositionStruct { OverReadingAmountOdo => 2.0, Position => 0.0, UnderReadingAmountOdo => 2.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.position 0.0
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{ TargetSpeed => 0.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 2000.0, TimeOut => EMPTY }] }
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
sub Set Train Data and speed
efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus <- Default.RequestEnum.Disabled
taint nv
efs: Kernel.NationalValues.CurrentNV().SpeedLimitForTriggeringTheOverrideFunction <- 20.0
set odo.speed 12.0
set train.data_state valid
sub Check override is proposed
expect efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Trigger Override
efs: DMI.MasterDMI().In_OverrideRequest.ProvideDriverResponse()
step Check end of Override when proceed information is passed
sub Check Override is activate
expect efs: Kernel.Override.OverrideIsActive() @ deadline=1
expect efs: Kernel.Mode == ModeEnum.SR @ deadline=1
