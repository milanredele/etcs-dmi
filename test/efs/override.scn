sub Set Train Data and speed
efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus <- Default.RequestEnum.Disabled
taint nv
efs: Kernel.NationalValues.CurrentNV().SpeedLimitForTriggeringTheOverrideFunction <- 20.0
set odo.speed 12.0
set train.data_state valid
set nv D_NVOVTRP 600.0
sub Check override is proposed
expect efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Check EoA location
set odo.position 4300.0
expect efs: Kernel.MA.EOA.EOA().Location == 4500.0 @ deadline=1
sub Trigger Override
efs: DMI.MasterDMI().In_OverrideRequest.ProvideDriverResponse()
step Check train trip is inhibited
sub Check Override is active
expect efs: Kernel.Override.OverrideIsActive() == True @ deadline=1
sub Overpass EoA
set odo.position 4520.0
expect efs: Kernel.Override.OverrideSupervision.FormerEOA < Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Min) @ deadline=1
sub Check mode is not trip
expect efs: Kernel.Mode == ModeEnum.SR @ kind=continuous deadline=1
