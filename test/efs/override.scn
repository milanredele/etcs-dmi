sub Set Train Data and speed
efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus <- Default.RequestEnum.Disabled
taint nv
efs: Kernel.NationalValues.CurrentNV().SpeedLimitForTriggeringTheOverrideFunction <- 20.0
set odo.speed 12.0
set train.data_state valid
sub Check override is proposed
expect efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Add emergency stops
efs: Kernel.BrakeCommands.EmergencyStops <- [ Kernel.BrakeCommands.EmergencyStopStruct { IsConditional => Boolean.True, Id => 2, StopLocation => 200.0 }, Kernel.BrakeCommands.EmergencyStopStruct { IsConditional => Boolean.True, Id => 7, StopLocation => 140.0 } ]
expect efs: COUNT X IN Kernel.BrakeCommands.EmergencyStops == 2 @ deadline=1
sub Check SR information cannot be modified even at standstill
set odo.speed 0.0
expect efs: DMI.MasterDMI().In_SRModeSpeedLimitAndDistanceEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
expect efs: DMI.MasterDMI().In_SRModeSpeedLimitAndDistance.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
sub Check "override active" is not displayed
expect efs: NOT DMI.MasterDMI().Out_OverrideStatus.OutputInformation.DisplayRequested @ deadline=1
step Trigger Override
sub Provide driver selection + check time and distance supervision information
efs: DMI.MasterDMI().In_OverrideRequest.ProvideDriverResponse()
expect efs: Kernel.Override.OverrideSupervision.StartLocation == 100.0 @ deadline=1
expect efs: Kernel.Override.OverrideSupervision.StartTime == Kernel.DateAndTime.CurrentTime @ deadline=1
sub Check procedure is Override and emergency stops are deleted
expect efs: Kernel.Mode == ModeEnum.SR @ deadline=1
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedureSM.Override @ deadline=1
sub Check emergeny stops are deleted
expect efs: COUNT X IN Kernel.BrakeCommands.EmergencyStops == 0 @ deadline=1
sub Check "override active" is indicated to the driver
expect efs: DMI.MasterDMI().Out_OverrideStatus.OutputInformation.DisplayRequested == True @ deadline=1
sub Check driver may ask modification of SR mode information
expect efs: DMI.MasterDMI().In_SRModeSpeedLimitAndDistanceEntryRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
expect efs: DMI.MasterDMI().In_SRModeSpeedLimitAndDistance.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
sub Check driver may modify the SR mode information
efs: DMI.MasterDMI().In_SRModeSpeedLimitAndDistanceEntryRequest.ProvideDriverResponse()
expect efs: DMI.MasterDMI().In_SRModeSpeedLimitAndDistance.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
expect efs: DMI.MasterDMI().In_SRModeSpeedLimitAndDistanceEntryRequest.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
sub Check former EoA
expect efs: Kernel.Override.OverrideSupervision.FormerEOA == 140.0 @ deadline=1
step Trigger Override again
sub Move the train
set odo.position 120.0
expect efs: Kernel.Override.OverrideIsActive() @ deadline=1
expect efs: DMI.MasterDMI().In_OverrideRequest.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Trigger Override again + check time and distance information restarted
efs: DMI.MasterDMI().In_OverrideRequest.ProvideDriverResponse()
expect efs: Kernel.Override.OverrideSupervision.StartLocation == 120.0 @ deadline=1
expect efs: Kernel.Override.OverrideSupervision.StartTime == Kernel.DateAndTime.CurrentTime @ deadline=1
sub Check former EoA did not change
expect efs: Kernel.Override.OverrideSupervision.FormerEOA == 140.0 @ deadline=1
step Check EoA is used as a Trip condition when Override is no longer active
sub Exit from Override
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + Kernel.NationalValues.CurrentNV().DistForTrainTripSuppressionWhenOverrideIsTriggered + 1.0
expect efs: NOT Kernel.Override.OverrideIsActive() @ deadline=1
expect efs: Kernel.Mode == ModeEnum.SR @ deadline=1
expect efs: Kernel.Override.OverrideSupervision.FormerEOA == 140.0 @ deadline=1
sub Approach the former EoA: no trip
set odo.position 4999.0
expect efs: Kernel.Mode == ModeEnum.SR @ deadline=1
sub Overpass the former EoA: trip
set odo.position 4500.0
expect efs: Kernel.Mode == ModeEnum.TR @ deadline=1
sequence Selection of Override: All conditions satisfied
case All conditions satisfied
clause E4 done 5.8.2.1 ; efs 5.8.2.1
clause E4 done 5.8.2.1 a) ; efs 5.8.2.1.a
clause E4 done 5.8.2.1 b) ; efs 5.8.2.1.b
clause E4 done 5.8.2.1 c) ; efs 5.8.2.1.c
clause E4 done 5.8.2.3 ; efs 5.8.2.3
