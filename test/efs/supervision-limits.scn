expect efs: DistanceForSpeed ( Function => FUNCTION d : Default.BaseTypes.Distance => Kernel.SpeedAndDistanceMonitoring.DecelerationCurves.EBD_Target ( Distance => d, aTarget => FIRST X IN TARGETS (Kernel.MRSP.SpeedRestrictions) ), Speed => 34.416 ) >= 2224.748
expect efs: DistanceForSpeed ( Function => FUNCTION d : Default.BaseTypes.Distance => Kernel.SpeedAndDistanceMonitoring.DecelerationCurves.EBD_Target ( Distance => d, aTarget => FIRST X IN TARGETS (Kernel.MRSP.SpeedRestrictions) ), Speed => 34.416 ) <= 2224.749
step Remove TSRs
sub Sub-step1
set tsrs 
case d_SBI1
clause E3 done 3.13.9.3.3.1 ; efs 3.13.9.3.3.1
clause - absent 3.13.9.3.1.3 ; efs 3.13.9.3.1.3
clause - absent 3.13.9.3.1.1 ; efs 3.13.9.3.1.1
