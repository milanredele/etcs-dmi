efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { Position => BTM.PositionStruct { Position => 0.0, UnderReadingAmountOdo => 4.0, OverReadingAmountOdo => 2.0 }, NID_BG => 1515, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, LocationAccuracy => 1.0 }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
