expect efs: DistanceForSpeed ( Function => Testing.Display.SBD, Speed => 34.72 ) <= 4186.55
expect efs: Kernel.SpeedAndDistanceMonitoring.TargetSpeedMonitoring.d_SBI1 ( Vest => 34.72 ) <= 4179.6
expect efs: Kernel.SpeedAndDistanceMonitoring.TargetSpeedMonitoring.d_SBI1 ( Vest => 34.72 ) >= 4169.0
case d_SBI2
