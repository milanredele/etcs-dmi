expect efs: Kernel.SpeedAndDistanceMonitoring.TargetSpeedMonitoring.d_EBI ( Vest => 30.0, aTarget => FIRST X IN TARGETS (Kernel.MRSP.SpeedRestrictions) ) > 2230.0 AND Kernel.SpeedAndDistanceMonitoring.TargetSpeedMonitoring.d_EBI ( Vest => 30.0, aTarget => FIRST X IN TARGETS (Kernel.MRSP.SpeedRestrictions) ) < 2231.0
expect Dbec 30.0 20.0 in 16.0 17.0
