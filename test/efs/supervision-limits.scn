step Check Vsbi1
sub Sub-step1
set odo.position 2000.0
set odo.speed 74.0
efs: Testing.SetUndesiredMovementReferences(2000.0)
expect efs: Kernel.SpeedAndDistanceMonitoring.TargetSpeedMonitoring.Vsbi1( Destfront => 10000.0 , aTargetSpeed => 0.0 ) == 0.0
expect efs: Kernel.SpeedAndDistanceMonitoring.TargetSpeedMonitoring.Vsbi1( Destfront => Kernel.TrainPosition.FrontEndPosition ( DistanceIntervalEnum.Nom ), aTargetSpeed => 0.0 ) <= 40.3474
expect efs: Kernel.SpeedAndDistanceMonitoring.TargetSpeedMonitoring.Vsbi1( Destfront => Kernel.TrainPosition.FrontEndPosition ( DistanceIntervalEnum.Nom ), aTargetSpeed => 0.0 ) >= 40.0
expect efs: Kernel.TrainPosition.FrontEndPosition ( DistanceIntervalEnum.Nom ) + Odometry.EstimatedSpeed * Kernel.SpeedAndDistanceMonitoring.TargetSpeedMonitoring.T_bs1( aTargetSpeed => 0.0 ) >= 2000.0
expect efs: Kernel.TrainPosition.FrontEndPosition ( DistanceIntervalEnum.Nom ) == 2000.0
case Vsbi2
