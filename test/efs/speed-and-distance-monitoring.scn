set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
step Setup
sub Sub-step1
set odo.accel 1.2
set gradients 1400.0:4.0 1600.0:0.0
set odo.position 1000.0
set train.data_state valid
efs: Kernel.TrainData.TrainData.Value.TractionSystems <- []
set train.traction_model 14.0 2.0
set train.traction_cut_off true
set train.m_rotating_nom 0.0
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct { TargetSpeed => 0.0, Sections => [Kernel.MA.Sections.SectionStruct { TimeOut => Kernel.MA.MATimers.TimeOutStruct { TimeOut => Timer.TimerStruct{ StartTime => BaseTypes.Time.NA, Duration => 800.0 }, Distance => 0.0 }, Length => 0.0 }], EndSection => Kernel.MA.EndSectionStruct { EndSectionTimeOut => Kernel.MA.MATimers.TimeOutStruct { TimeOut => Timer.TimerStruct{ StartTime => BaseTypes.Time.NA, Duration => 1000.0 }, Distance => 0.0 }, DangerPoint => Kernel.MA.SvL.DangerPointStruct { Distance => 0.0, ReleaseSpeed => 0.0 }, Overlap => Kernel.MA.SvL.OverlapStruct { Distance => 0.0, TimerDistance => 0.0, ReleaseSpeed => 0.0, TimeOut => Timer.TimerStruct{ StartTime => BaseTypes.Time.NA, Duration => 500.0 } } }, TargetSpeedTimeOut => 900.0 }
set train.v_max 180.0
set odo.speed 40.0
case Traction model
clause E3 done 3.13.2.2.2.1 ; efs 3.13.2.2.2.1
clause - absent 3.13.2.2.2.2 ; efs 3.13.2.2.2.2
step T_traction without gradient
sub Sub-step1
expect efs: Kernel.TrainData.BrakingParameters.A_traction ( Odometry.EstimatedAcceleration, Kernel.TrackDescription.Gradient.A_gradient ( Odometry.NominalDistance ) ) == 1.2
expect T_traction_cut_off == 18.8
step T_traction with gradient
sub Sub-step1
set odo.position 1500.0
expect T_traction_cut_off == 19.34936
expect efs: Kernel.TrainData.BrakingParameters.A_traction ( Odometry.EstimatedAcceleration, Kernel.TrackDescription.Gradient.A_gradient ( Odometry.NominalDistance ) ) == 1.23924
expect efs: Kernel.TrackDescription.Gradient.A_gradient ( Odometry.NominalDistance ) == 0.03924
case Brake build up time, T_be and T_bs
clause E3 done 3.13.2.2.3.2.8 ; efs 3.13.2.2.3.2.8
clause - absent 3.13.2.2.3.2.7 ; efs 3.13.2.2.3.2.7
clause E3 done 3.13.2.2.3.2.5 ; efs 3.13.2.2.3.2.5
clause - absent 3.13.2.2.3.2.3 c) ; efs 3.13.2.2.3.2.3.c
clause E3 done 3.13.2.2.3.2.2 ; efs 3.13.2.2.3.2.2
clause - absent 3.13.2.2.3.2.1 ; efs 3.13.2.2.3.2.1
clause - absent 3.13.6.2.2.2 a) ; efs 3.13.6.2.2.2.a
clause - absent 3.13.6.2.2.2 b) ; efs 3.13.6.2.2.2.b
clause - absent 3.13.6.2.2.2 c) ; efs 3.13.6.2.2.2.c
clause E3 done 3.13.6.2.2.3 ; efs 3.13.6.2.2.3
clause - absent 3.13.6.3.2.3 a) ; efs 3.13.6.3.2.3.a
clause - absent 3.13.6.3.2.3 b) ; efs 3.13.6.3.2.3.b
clause E3 done 3.13.6.3.2.4 ; efs 3.13.6.3.2.4
step Setup
sub Sub-step1
set train.t_brake_emergency clear
set train.t_brake_emergency 2 0.4
set train.t_brake_emergency 6 0.78
set train.t_brake_emergency 3 1.2
set train.t_brake_emergency 10 0.12
set train.t_brake_emergency 5 0.54
set train.t_brake_emergency 12 0.64
set train.t_brake_emergency 9 1.25
set train.t_brake_emergency 7 0.47
set train.t_brake_emergency 14 0.6
set train.t_brake_emergency 11 0.11
set train.t_brake_emergency 13 0.98
set train.t_brake_emergency 15 1.7
set train.t_brake_emergency 4 1.82
set train.t_brake_emergency 1 0.96
set train.t_brake_emergency 8 0.85
set train.t_brake_service clear
set train.t_brake_service 2 1.16
set train.t_brake_service 6 0.48
set train.t_brake_service 3 2.01
set train.t_brake_service 10 0.72
set train.t_brake_service 5 0.28
set train.t_brake_service 12 0.56
set train.t_brake_service 9 1.63
set train.t_brake_service 7 0.45
set train.t_brake_service 14 1.4
set train.t_brake_service 11 1.8
set train.t_brake_service 13 0.78
set train.t_brake_service 15 0.21
set train.t_brake_service 4 0.55
set train.t_brake_service 1 1.15
set train.t_brake_service 8 0.46
set train.interface eddy_current both
set train.interface ep both
set train.interface magnetic_shoe eb
set train.interface regenerative none
set train.brake_position passenger_p
set tiu.active regenerative true
set tiu.active magnetic_shoe true
set tiu.active ep true
set tiu.active eddy_current true
expect T_brake_emergency == 0.6
expect T_brake_service == 0.72
expect T_be 0.0 == 0.6
expect T_bs 0.0 == 0.72
step Disable Eddy Current brake
sub Sub-step1
set train.interface eddy_current none
set tiu.active eddy_current true
expect T_brake_service == 0.46
expect T_brake_emergency == 0.64
expect T_be 0.0 == 0.64
expect T_bs 0.0 == 0.46
step Disable Electro pneumatic brake for EB
sub Sub-step1
set train.interface ep sb
set tiu.active ep true
expect T_brake_service == 0.46
xfail not clear-cut, reported: 3.13.2.2.6.2 (3.4.0 = 4.0) does not say which T_brake_emergency applies when the status of the Ep brake does not affect it (interface for the service brake only): EFS takes the Ep brake as not in use, ours (EVC_Braking.Build) as in use, the shorter T_be
expect T_brake_emergency == 1.82
xfail not clear-cut, reported: 3.13.2.2.6.2 (3.4.0 = 4.0) does not say which T_brake_emergency applies when the status of the Ep brake does not affect it (interface for the service brake only): EFS takes the Ep brake as not in use, ours (EVC_Braking.Build) as in use, the shorter T_be
expect T_be 0.0 == 1.82
expect T_bs 0.0 == 0.46
step Conversion model is used
sub Sub-step1
set train.t_brake_emergency empty
set train.length 160.0
set train.lambda 147.0
set train.eb_models empty
set train.sb_models empty
step Compute T_brake_emergency
sub Sub-step1
call ConversionModel.Initialize
expect T_be 0.0 == 5.522
