case Axle load with resuming of initial states received
clause E1 done 7.5.1.32 ; efs 7.5.1.32
step Axle load with resuming of initial states received
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2142 Q_LINK=1 | AXLE_LOAD_SPEED_PROFILE NID_PACKET=88 Q_DIR=1 L_PACKET=400 Q_SCALE=1 Q_TRACKINIT=1 D_TRACKINIT=400 D_AXLELOAD=0 L_AXLELOAD=0 Q_FRONT=0
set odo.position 400.0
step Check axle load profile information
sub Sub-step1
expect efs: Kernel.TrackDescription.AxleLoad.ASP.InitialState == Messages.Q_TRACKINIT.Empty_profile__initial_states_to_be_resumed
expect efs: Kernel.TrackDescription.AxleLoad.SpeedRestrictions ( 650.0 ) == 40.0
expect efs: Kernel.TrackDescription.AxleLoad.SpeedRestrictions ( 610.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.TrackDescription.AxleLoad.SpeedRestrictions ( 1000.0 ) == 80.0
step Initial states resuming distance achieved
