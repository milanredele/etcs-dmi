set gradients 0.0:0.0 800.0:4.0 1300.0:-2.0 1600.0:indefinite
set train.kn_minus 0:0.0:0.21 1:50.0:0.34 2:100.0:0.39 3:180.0:0.42 4:240.0:0.49
set train.kn_plus 0:0.0:0.17 1:40.0:0.28 2:80.0:0.35 3:150.0:0.41 4:250.0:0.52
step Check KnMin
sub Sub-step1
expect Kn_minus 0.0 == 0.21
xfail 3.13.2.2.9.2.3 (3.4.0 = 4.0): at a step boundary V1 Kn_0 applies (0 <= V <= V1); EFS takes the step above
expect Kn_minus 100.0 == 0.39
expect Kn_minus 150.0 == 0.39
expect Kn_minus 250.0 == 0.49
xfail 3.13.2.2.9.2.3 (3.4.0 = 4.0): at a step boundary V1 Kn_0 applies (0 <= V <= V1); EFS takes the step above
expect Kn_minus 50.0 == 0.34
step Check KnPlus
sub Sub-step1
expect Kn_plus 0.0 == 0.17
expect Kn_plus 100.0 == 0.35
xfail 3.13.2.2.9.2.3 (3.4.0 = 4.0): at a step boundary V1 Kn_0 applies (0 <= V <= V1); EFS takes the step above
expect Kn_plus 150.0 == 0.41
xfail 3.13.2.2.9.2.3 (3.4.0 = 4.0): at a step boundary V1 Kn_0 applies (0 <= V <= V1); EFS takes the step above
expect Kn_plus 250.0 == 0.52
expect Kn_plus 50.0 == 0.28
step Check GradientInfoProfile_NonCompensated
sub Sub-step1
expect efs: Kernel.TrackDescription.Gradient.GradientInfoProfile_NonCompensated ( GradientInfo => FIRST X IN Kernel.TrackDescription.Gradient.Gradients, Distance => 500.0, TrainLength => Kernel.TrainData.TrainData.Value.TrainLength ) == 0.0
expect efs: Kernel.TrackDescription.Gradient.GradientInfoProfile_NonCompensated ( GradientInfo => LAST X IN Kernel.TrackDescription.Gradient.Gradients | X.Location < 1200.0, Distance => 1200.0, TrainLength => Kernel.TrainData.TrainData.Value.TrainLength ) == 4.0
expect efs: Kernel.TrackDescription.Gradient.GradientInfoProfile_NonCompensated ( GradientInfo => FIRST X IN Kernel.TrackDescription.Gradient.Gradients, Distance => 1740.0, TrainLength => Kernel.TrainData.TrainData.Value.TrainLength ) == BaseTypes.Gradient.Indefinite
step Check GradientInfoProfileSummary_NonCompensated
sub Sub-step1
expect efs: Kernel.TrackDescription.Gradient.GradientInfoProfileSummary_NonCompensated ( 500.0 ) == 0.0
expect efs: Kernel.TrackDescription.Gradient.GradientInfoProfileSummary_NonCompensated ( 1200.0 ) == 4.0
expect efs: Kernel.TrackDescription.Gradient.GradientInfoProfileSummary_NonCompensated ( 1300.0 ) == -2.0
expect efs: Kernel.TrackDescription.Gradient.GradientInfoProfileSummary_NonCompensated ( 1739.0 ) == -2.0
expect efs: Kernel.TrackDescription.Gradient.GradientInfoProfileSummary_NonCompensated ( 1740.0 ) == BaseTypes.Gradient.Indefinite
step Check GradientProfile_NonCompensated
sub Sub-step1
expect efs: Kernel.TrackDescription.Gradient.GradientProfile_NonCompensated ( d => 500.0, V => 0.0 ) == 0.0
expect efs: Kernel.TrackDescription.Gradient.GradientProfile_NonCompensated ( d => 1740.0, V => 0.0 ) == 0.0
expect efs: Kernel.TrackDescription.Gradient.GradientProfile_NonCompensated ( d => 1200.0, V => 0.0 ) == 0.68
expect efs: Kernel.TrackDescription.Gradient.GradientProfile_NonCompensated ( d => 1200.0, V => 100.0 ) == 1.4
expect efs: Kernel.TrackDescription.Gradient.GradientProfile_NonCompensated ( d => 1300.0, V => 0.0 ) == -0.42
expect efs: Kernel.TrackDescription.Gradient.GradientProfile_NonCompensated ( d => 1300.0, V => 100.0 ) == -0.78
case Check A_normal_service
clause E3 done 3.13.6.4.3 ; efs 3.13.6.4.3
clause - absent 3.13.6.4.2 c) ; efs 3.13.6.4.2.c
step Check A_normal_service
sub Sub-step1
expect efs: Kernel.TrainData.BrakingParameters.A_normal_service ( d => 500.0, V => 0.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) == 0.94
expect efs: Kernel.TrainData.BrakingParameters.A_normal_service ( d => 500.0, V => 100.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) == 0.76
expect efs: Kernel.TrainData.BrakingParameters.A_normal_service ( d => 700.0, V => 0.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) == 0.9
expect efs: Kernel.TrainData.BrakingParameters.A_normal_service ( d => 700.0, V => 100.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) == 0.84
expect efs: Kernel.TrainData.BrakingParameters.A_normal_service ( d => 941.0, V => 0.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) > 0.2541 AND Kernel.TrainData.BrakingParameters.A_normal_service ( d => 941.0, V => 0.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) < 0.2542
expect efs: Kernel.TrainData.BrakingParameters.A_normal_service ( d => 941.0, V => 100.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) < -0.5258 AND Kernel.TrainData.BrakingParameters.A_normal_service ( d => 941.0, V => 100.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) > -0.5259
expect efs: Kernel.TrainData.BrakingParameters.A_normal_service ( d => 1300.0, V => 0.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) > 1.34076 AND Kernel.TrainData.BrakingParameters.A_normal_service ( d => 1300.0, V => 0.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) < 1.34077
expect efs: Kernel.TrainData.BrakingParameters.A_normal_service ( d => 1300.0, V => 100.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) > 1.52076 AND Kernel.TrainData.BrakingParameters.A_normal_service ( d => 1300.0, V => 100.0, aTarget => Testing.DecelerationCurves.SupervisedTarget() ) < 1.52077
