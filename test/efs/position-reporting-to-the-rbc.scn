efs: BTM.LRBG.PreviousBaliseGroups <- [ BTM.LRBG.PreviousBaliseGroupStruct { IsLRBG => True, BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG=>9614, BGOrientation => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 1039.0, Position => 1040.0, UnderReadingAmountOdo => 1042.0 } } },BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct{ NID_BG => 9616, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Timestamp => Kernel.DateAndTime.Now(), Position => BTM.PositionStruct{ OverReadingAmountOdo => 11.0, Position => 1080.0, UnderReadingAmountOdo => 11.0 } }, IsLRBG => True, IsSingle => False } ]
set odo.accuracy D_ora=20.0
