sub Sub-step2
set odo.accuracy D_ura=11.0
set odo.accuracy D_ora=14.0
taint odo
efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainRunningDirection <- OrientationEnum.Reverse
taint odo
efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainOrientation <- OrientationEnum.Reverse
taint odo
efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainFrontEndPosition <- OrientationEnum.Nominal
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
efs: BTM.LRBG.PreviousBaliseGroups <- [ BTM.LRBG.PreviousBaliseGroupStruct { IsLRBG => True, BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG=>9614, BGOrientation => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 1039.0, Position => 1040.0, UnderReadingAmountOdo => 1042.0 } } },BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct{ NID_BG => 9616, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Timestamp => Kernel.DateAndTime.Now(), Position => BTM.PositionStruct{ OverReadingAmountOdo => 7.0, Position => 1080.0, UnderReadingAmountOdo => 6.0 } }, IsLRBG => True, IsSingle => False } ]
set odo.position 1080.0
efs: Testing.InitializeEURORADIO()
case The train reaches standstill
clause E2 done 3.6.5.1.4 a) ; efs 3.6.5.1.4.a
clause E2 done 3.6.5.1.4.1 ; efs 3.6.5.1.4.1
clause E2 done 3.4.2.3.3.1 ; efs 3.4.2.3.3.1
step One BG - Step1: Setup
sub Sub-step1
set odo.speed 1.0
efs: (FIRST X IN BTM.LRBG.PreviousBaliseGroups | X.BaliseGroup == BTM.LRBG.LRBG()).BaliseGroup.BGOrientation <- Default.OrientationEnum.Nominal
step One BG - Step2: Train reaches standstill
sub Sub-step1
set odo.speed 0.0
expect efs: EURORADIO.Messages.PositionReport.SendReportDueToStandstillReached() == True
expect efs: EURORADIO.Messages.PositionReport.SendReportNow() == True
expect efs: Available((LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.TRAIN_POSITION_REPORT.POSITION_REPORT.POSITION_REPORT)
expect efs: NOT Available((LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.TRAIN_POSITION_REPORT.POSITION_REPORT.POSITION_REPORT_BASED_ON_TWO_BALISE_GROUPS)
step Two BGs - Step1: Setup
sub Sub-step1
set odo.speed 1.0
efs: (FIRST X IN BTM.LRBG.PreviousBaliseGroups | X.BaliseGroup == BTM.LRBG.LRBG()).BaliseGroup.BGOrientation <- Default.OrientationEnum.Unknown
step Two BGs - Step2: Train reaches standstill
sub Sub-step1
set odo.speed 0.0
expect efs: Available((LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.TRAIN_POSITION_REPORT.POSITION_REPORT.POSITION_REPORT_BASED_ON_TWO_BALISE_GROUPS)
expect efs: EURORADIO.Messages.PositionReport.SendReportNow() == True
expect efs: EURORADIO.Messages.PositionReport.SendReportDueToStandstillReached() == True
expect efs: NOT Available((LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.TRAIN_POSITION_REPORT.POSITION_REPORT.POSITION_REPORT)
