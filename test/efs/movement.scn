sequence Nominal direction of travel
case In FS
clause - other 1.1.42.3 ; Design choices
clause - other 1.1.42.3.1 ; Design choices
step Setup
sub Initialize test environment
efs: Testing.InitializeTestEnvironment( aTrainPosition => 500.0, aMode => Default.ModeEnum.FS )
step Move forwards (direction controller nominal)
sub SubStep1
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance + 150.0
expect efs: Kernel.Mode == ModeEnum.FS @ deadline=1
expect efs: NOT TIU.Brakes.BrakeCommanded() @ deadline=1
step Move backwards (direction controller nominal)
sub SubStep1
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance - 150.0
set odo.speed -2.0
expect efs: TIU.Brakes.BrakeCommanded() @ deadline=1
expect efs: Kernel.Mode == ModeEnum.FS @ deadline=1
sub SubStep2
set odo.speed 0.0
expect efs: DMI.MasterDMI().In_AcknForRollAwayProtection.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub SubStep3
efs: DMI.MasterDMI().In_AcknForRollAwayProtection.InputInformation.RequestStatus <- Default.RequestEnum.Response
sub SubStep4
efs: Kernel.DateAndTime.CurrentTime <- Kernel.DateAndTime.CurrentTime + 1.0
sub SubStep5
efs: DMI.MasterDMI().In_AcknForReverseMovementProtection.InputInformation.RequestStatus <- Default.RequestEnum.Response
expect efs: NOT TIU.Brakes.BrakeCommanded() @ deadline=1
step Move backwards (direction controller reverse)
sub SubStep1
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance - 150.0
efs: TIU.DirectionControllerInformation <- TIU.DirectionControllerEnum.Backward
set odo.speed -2.0
expect efs: TIU.Brakes.BrakeCommanded() @ deadline=1
expect efs: Kernel.Mode == ModeEnum.FS @ deadline=1
sub SubStep2
set odo.speed 0.0
expect efs: DMI.MasterDMI().In_AcknForReverseMovementProtection.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub SubStep3
efs: DMI.MasterDMI().In_AcknForReverseMovementProtection.InputInformation.RequestStatus <- Default.RequestEnum.Response
expect efs: NOT TIU.Brakes.BrakeCommanded() @ deadline=1
