step Setup
sub Initialize test environment
efs: Testing.InitializeTestEnvironment( aTrainPosition => 0.0, aMode => Default.ModeEnum.FS )
step Test reception of odometry message in nominal direction
sub Receive odometry message
taint odo
efs: Odometry.Message <- STM.Messages.OdometerMulticastMessageStruct{ NID_PACKET => 8, L_PACKET => 0, V_MAX => 240, V_EST => 200, V_MIN => 160, D_MAX => 2500, D_EST => 2000, D_MIN => 1500, T_ODO => 2, D_RES => 1 }
