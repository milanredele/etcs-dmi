efs: Odometry.Message <- STM.Messages.OdometerMulticastMessageStruct{ NID_PACKET => 8, L_PACKET => 0, V_MAX => -240, V_EST => -200, V_MIN => -160, D_MAX => -1500, D_EST => -2000, D_MIN => -2500, T_ODO => 2, D_RES => 1 }
