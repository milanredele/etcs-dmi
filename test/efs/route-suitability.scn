set train.sb_model 7 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 0 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.length 197.0
# efs: Kernel.TrainData.TrainData.Value.LoadingGauge <- Messages.M_LOADINGGAUGE.G1
# efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- 2
# efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [Kernel.TrainData.TractionSystemStruct{ Voltage => Messages.M_VOLTAGE.AC_15_kV_16_7_Hz, Country => 85 }]
# InitializeBrakingParameters
set train.kdry 7 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kdry 5 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 7 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 5 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.eb_step 7 0 0.0 1.0
set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
sub SubStep 2 - Setup for the BG
efs: BTM.LRBG.PreviousBaliseGroups <- [BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 255, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Timestamp => Kernel.DateAndTime.Now(), Position => BTM.PositionStruct { OverReadingAmountOdo => 2.0, Position => 0.0, UnderReadingAmountOdo => 2.0 } }, IsLRBG => True, IsSingle => False }]
set odo.position 0.0
taint odo
efs: Kernel.TrainPosition.Position.DataState <- DataStateEnum.Valid
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{ TargetSpeed => 0.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 2000.0, TimeOut => EMPTY }], TargetSpeedTimeOut => 0.0 }
sub SubStep 3 - Set the train data
set train.data_state valid
efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- Messages.M_AXLELOADCAT.D4
efs: Kernel.TrainData.TrainData.Value.LoadingGauge <- Messages.M_LOADINGGAUGE.GB
efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [ Kernel.TrainData.TractionSystemStruct { Voltage => Messages.M_VOLTAGE.AC_25_kV_50_Hz, Country => 80 } , Kernel.TrainData.TractionSystemStruct { Voltage => Messages.M_VOLTAGE.DC_3_kV, Country => 80 } ]
sub SubStep 4 - Set previous train data
taint train
efs: Kernel.TrainData.PreviousTrainData <- Kernel.TrainData.TrainData.Value
step Receive a message from the balise
sub SubStep 1 - The message gets sent
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=1 NID_C=80 NID_BG=256 Q_LINK=0 | ROUTE_SUITABILITY_DATA NID_PACKET=70 Q_DIR=2 L_PACKET=1 Q_SCALE=1 Q_TRACKINIT=0 D_SUITABILITY=500 Q_SUITABILITY=0 M_LINEGAUGE=4 N_ITER=2 D_SUITABILITY=1000 Q_SUITABILITY=1 M_AXLELOADCAT=9 D_SUITABILITY=2000 Q_SUITABILITY=2 M_VOLTAGE=1 NID_CTRACTION=80
set odo.position 250.0
step Expectations
sub SubStep 1 - Check that the message was stored
expect efs: (LAST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).NidCTraction == 80 @ deadline=1
expect efs: (COUNT X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items) == 3 @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).Location == 745.0 @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).LineGauge == Messages.M_LINEGAUGE.GB @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).Type == Messages.Q_SUITABILITY.Loading_gauge_profile @ deadline=1
expect efs: (LAST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).Location == 3745.0 @ deadline=1
expect efs: (LAST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).TractionSystem == Messages.M_VOLTAGE.AC_25_kV_50_Hz @ deadline=1
expect efs: (LAST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).Type == Messages.Q_SUITABILITY.Traction_system @ deadline=1
expect efs: Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.InitialState == 0 @ deadline=1
expect efs: THERE_IS X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items | (X.Location == 1745.0 AND X.Type == Messages.Q_SUITABILITY.Max_axle_load AND X.MaxAxleLoad == Messages.M_AXLELOADCAT.D4) @ deadline=1
sub Sub-step 2 - Check that inconsistencies are correctly identified
expect efs: ( FORALL X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items | Kernel.TrackDescription.RouteSuitability.IsUnsuitable ( anItem=> X ) == Boolean.False ) @ deadline=1
sequence Handle route suitability from the RBC
case Receive and store a route suitability message from the RBC
clause - absent 3.12.2.2 ; efs 3.12.2.2
step Initialize train data
sub SubStep 1 - Initialize test environment
init 100.0 OS
# the defaults of the EFS model (TrainDataValuesStruct, TIU)
set train.data_state unknown
set train.length 400.0
