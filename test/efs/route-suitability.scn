sub SubStep 2 - Setup
set odo.position 250.0
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 256, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 2.0, Position => 250.0, UnderReadingAmountOdo => 2.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
efs: Kernel.Level <- Kernel.LevelData{ Value => LevelDataStruct{ NTC => NID_NTC.NOT_APPLICABLE, Value => LevelEnum.L2 }, DataState => DataStateEnum.Valid }
sub SubStep 3 - Start radio connection
efs: Testing.InitializeEURORADIO()
sub SubStep 4 - Give the train some data
efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [ Kernel.TrainData.TractionSystemStruct { Voltage => Messages.M_VOLTAGE.AC_25_kV_50_Hz, Country => 80 } , Kernel.TrainData.TractionSystemStruct { Voltage => Messages.M_VOLTAGE.DC_3_kV, Country => 80 } ]
efs: Kernel.TrainData.TrainData.Value.LoadingGauge <- Messages.M_LOADINGGAUGE.GB
efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- Messages.M_AXLELOADCAT.D4
set train.data_state valid
sub SubStep 5 - Set previous train data
taint train
efs: Kernel.TrainData.PreviousTrainData <- Kernel.TrainData.TrainData.Value
step Receive a message from the RBC
sub SubStep1
efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message { SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message { GENERAL_MESSAGE => Messages.MESSAGE.TRACK_TO_TRAIN.GENERAL_MESSAGE.Message { NID_MESSAGE => 24, L_MESSAGE => 0, T_TRAIN => Messages.MESSAGE.TIME_ACCESSORS.Export_T_TRAIN(Kernel.DateAndTime.CurrentTime), M_ACK => Messages.M_ACK.No_acknowledgement_required, NID_LRBG => 256, Sequence1 => [ Messages.MESSAGE.TRACK_TO_TRAIN.GENERAL_MESSAGE.SubStructure1{ ROUTE_SUITABILITY_DATA => Messages.PACKET.TRACK_TO_TRAIN.ROUTE_SUITABILITY_DATA.Message { NID_PACKET => 70, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 1, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, Q_TRACKINIT => 0, D_SUITABILITY => 500, Q_SUITABILITY => Messages.Q_SUITABILITY.Loading_gauge_profile, M_LINEGAUGE => Messages.M_LINEGAUGE.GB, N_ITER => 2, Sequence1 => [ Messages.PACKET.TRACK_TO_TRAIN.ROUTE_SUITABILITY_DATA.SubStructure1{ D_SUITABILITY => 1000, Q_SUITABILITY => Messages.Q_SUITABILITY.Max_axle_load, M_AXLELOADCAT => Messages.M_AXLELOADCAT.D4 } , Messages.PACKET.TRACK_TO_TRAIN.ROUTE_SUITABILITY_DATA.SubStructure1{ D_SUITABILITY => 2000, Q_SUITABILITY => Messages.Q_SUITABILITY.Traction_system, M_VOLTAGE => Messages.M_VOLTAGE.AC_25_kV_50_Hz, NID_CTRACTION => 80 } ] } } ] } }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal }
step Expectations
sub SubStep 1 - Check that the message was stored
expect efs: (LAST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).NidCTraction == 80 @ deadline=1
expect efs: (COUNT X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items) == 3 @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).Location == 500.0 @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).LineGauge == Messages.M_LINEGAUGE.GB @ deadline=1
expect efs: (FIRST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).Type == Messages.Q_SUITABILITY.Loading_gauge_profile @ deadline=1
expect efs: (LAST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).Location == 3500.0 @ deadline=1
expect efs: (LAST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).TractionSystem == Messages.M_VOLTAGE.AC_25_kV_50_Hz @ deadline=1
expect efs: (LAST X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items).Type == Messages.Q_SUITABILITY.Traction_system @ deadline=1
expect efs: Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.InitialState == 0 @ deadline=1
expect efs: THERE_IS X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items | (X.Location == 1500.0 AND X.Type == Messages.Q_SUITABILITY.Max_axle_load AND X.MaxAxleLoad == Messages.M_AXLELOADCAT.D4) @ deadline=1
sub Sub-step 2 - Check that inconsistencies are correctly identified
expect efs: ( FORALL X IN Kernel.TrackDescription.RouteSuitability.RouteSuitabilityProfile.Items | Kernel.TrackDescription.RouteSuitability.IsUnsuitable ( anItem=> X ) == Boolean.False ) @ deadline=1
