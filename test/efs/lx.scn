sub Sub-step1
taint odo
efs: Odometry.NominalDistance <- BTM.LRBG.LRBG().Position.Position + (FIRST X IN Kernel.LX.MRSPLevelCrossings).Location + (FIRST X IN Kernel.LX.MRSPLevelCrossings).Length + BaseTypes.LengthToDistance(Kernel.TrainPosition.ConfidenceInterval.ConfidenceInterval(ConfidenceIntervalEnum.L_DOUBTOVER)) + 1.0
sub Sub-step2
expect efs: COUNT X IN Kernel.LX.MRSPLevelCrossings == 1 @ deadline=1
expect efs: COUNT X IN Kernel.LX.SupervisedLevelCrossings == 0 @ deadline=1
expect efs: DMI.MasterDMI().Out_LXStatusNotProtected.OutputInformation.DisplayRequested == False @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition( PointOfInterest=>DistanceIntervalEnum.Min ) >= (FIRST X IN Kernel.LX.MRSPLevelCrossings).Location + (FIRST X IN Kernel.LX.MRSPLevelCrossings).Length @ deadline=1
