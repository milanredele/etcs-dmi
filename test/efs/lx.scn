expect efs: (COUNT X IN Kernel.LX.MRSPLevelCrossings) == 1 @ deadline=1
expect efs: (FIRST X IN Kernel.LX.MRSPLevelCrossings).Location == 4000.0 @ deadline=1
sequence Non protected LX received, no stopping required
case Non protected LX received, no stopping required
clause - absent 3.11.2.2 i) ; efs 3.11.2.2.i
clause - absent 3.12.5.2 ; efs 3.12.5.2
clause - absent 3.11.9.1 ; efs 3.11.9.1
