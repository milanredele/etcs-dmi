step A protected level crossing is received
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_CROSSING_INFORMATION NID_PACKET=88 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_LX=18 D_LX=3000 L_LX=50 Q_LXSTATUS=0 V_LX=0 Q_STOPLX=0 L_STOPLX=0
taint track
efs: Kernel.LX.SupervisedLevelCrossings <- []
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9621, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 27.0, Position => 3000.0, UnderReadingAmountOdo => 24.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.position 3500.0
taint odo
efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainOrientation <- OrientationEnum.Nominal
set odo.accuracy D_ura=42.0 D_ora=38.0 V_ora=0.0 V_ura=0.0
expect efs: (COUNT X IN Kernel.LX.MRSPLevelCrossings) == 1
expect efs: Kernel.LX.SpeedRestrictions ( 1000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 3000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 3020.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 4000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: (COUNT X IN Kernel.LX.SupervisedLevelCrossings) == 0 @ deadline=1
step A non protected level crossing is received
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2126 Q_LINK=1 | LEVEL_CROSSING_INFORMATION NID_PACKET=88 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_LX=20 D_LX=2000 L_LX=100 Q_LXSTATUS=1 V_LX=8 Q_STOPLX=0 L_STOPLX=0
expect efs: Kernel.LX.SpeedRestrictions ( 1000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2099.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 3000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 3020.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 4000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: (COUNT X IN Kernel.LX.MRSPLevelCrossings) == 1 @ deadline=1
expect efs: (COUNT X IN Kernel.LX.SupervisedLevelCrossings) == 1 @ deadline=1
step A non protected level crossing is received
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2128 Q_LINK=1 | LEVEL_CROSSING_INFORMATION NID_PACKET=88 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_LX=22 D_LX=2500 L_LX=40 Q_LXSTATUS=1 V_LX=4 Q_STOPLX=1 L_STOPLX=50
expect efs: Kernel.LX.SpeedRestrictions ( 1000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2099.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2450.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2500.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2539.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2540.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 3000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 3020.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 4000.0 ) == BaseTypes.Speed.MaxSpeed
expect efs: (COUNT X IN Kernel.LX.SupervisedLevelCrossings) == 2 @ deadline=1
expect efs: (COUNT X IN Kernel.LX.MRSPLevelCrossings) == 1 @ deadline=1
step The train reaches LX supervision location
sub Sub-step1
taint odo
efs: Odometry.NominalDistance <- BTM.LRBG.LRBG().Position.Position + 1990.0
expect efs: (COUNT X IN Kernel.LX.MRSPLevelCrossings) == 2 @ deadline=1
expect efs: (COUNT X IN Kernel.LX.SupervisedLevelCrossings) == 1 @ deadline=1
step Train stops in the stopping location
sub Sub-step1
taint odo
efs: Odometry.NominalDistance <- BTM.LRBG.LRBG().Position.Position + 2452.0
set odo.speed 0.0
expect efs: (COUNT X IN Kernel.LX.SupervisedLevelCrossings) == 0 @ deadline=1
expect efs: (COUNT X IN Kernel.LX.MRSPLevelCrossings) == 3 @ deadline=1
