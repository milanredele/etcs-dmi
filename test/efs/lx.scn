telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_CROSSING_INFORMATION NID_PACKET=88 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_LX=18 D_LX=4000 L_LX=50 Q_LXSTATUS=0 V_LX=0 Q_STOPLX=0 L_STOPLX=0
