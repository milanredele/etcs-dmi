expect efs: Kernel.LX.SpeedRestrictions ( 1200.0 ) >= 50.
expect efs: Kernel.LX.SpeedRestrictions ( 1400.0 ) >= 50.0
expect efs: Kernel.LX.SpeedRestrictions ( 1440.0 ) >= BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 1500.0 ) >= BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 2000.0 ) >= BaseTypes.Speed.MaxSpeed
expect efs: (COUNT X IN Kernel.LX.MRSPLevelCrossings) == 1 @ deadline=1
expect efs: (COUNT X IN Kernel.LX.SupervisedLevelCrossings) == 0 @ deadline=1
