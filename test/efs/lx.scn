sub SubStep2
efs: Testing.SetFSMode( HandleModeChange => False )
step A non protected level crossing is received
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2126 Q_LINK=1 | LEVEL_CROSSING_INFORMATION NID_PACKET=88 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_LX=20 D_LX=800 L_LX=100 Q_LXSTATUS=1 V_LX=8 Q_STOPLX=0 L_STOPLX=0
taint track
efs: Kernel.LX.SupervisedLevelCrossings <- []
set odo.position 2500.0
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9618, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo=>6.0, Position=>2000.0, UnderReadingAmountOdo=>2.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
taint odo
efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainOrientation <- OrientationEnum.Nominal
set odo.accuracy D_ura=15.0 D_ora=14.0 V_ora=0.0 V_ura=0.0
expect efs: (COUNT X IN Kernel.LX.SupervisedLevelCrossings) == 1
expect efs: (COUNT X IN Kernel.LX.MRSPLevelCrossings) == 0 @ deadline=1
step LX data check
sub Sub-step1
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).Id == 20
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).Location == 800.0
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).Length == 100.0
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).IsProtected == False
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).Speed == 40.0
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).StoppingRequired == False
step Speed restrictions check
sub Sub-step1
expect efs: Kernel.LX.SpeedRestrictions ( 899.0 ) >= BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 500.0 ) >= BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 900.0 ) >= BaseTypes.Speed.MaxSpeed
expect efs: Kernel.LX.SpeedRestrictions ( 800.0 ) >= BaseTypes.Speed.MaxSpeed
