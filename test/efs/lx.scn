sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2128 Q_LINK=1 | LEVEL_CROSSING_INFORMATION NID_PACKET=88 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_LX=22 D_LX=1200 L_LX=240 Q_LXSTATUS=1 V_LX=10 Q_STOPLX=1 L_STOPLX=70
taint track
efs: Kernel.LX.SupervisedLevelCrossings <- []
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9619, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo=>16.0, Position=>2200.0, UnderReadingAmountOdo=>14.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.position 2700.0
taint odo
efs: Kernel.TrainPosition.Position.DirectionalPositionInformation.TrainOrientation <- OrientationEnum.Nominal
set odo.accuracy D_ura=24.0 D_ora=29.0 V_ora=0.0 V_ura=0.0
