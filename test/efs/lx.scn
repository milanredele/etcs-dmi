expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).Id == 22
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).Location == 1200.0
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).Length == 240.0
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).IsProtected == False
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).Speed == 50.0
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).StoppingRequired == True
expect efs: (FIRST X IN Kernel.LX.SupervisedLevelCrossings).StoppingAreaLength == 70.0
step Speed restrictions check
