set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
sub SubStep2
efs: Kernel.Level.Value.Value <- LevelEnum.L2
case Offer driver selection
clause E4 partial 5.11.2.2 S140 ; efs Entry 5.11.2.2.S140.1
step Offer driver selection, valid train data
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S140.RequestDriverSelection
set train.data_state valid
efs: DMI.MasterDMI().In_Start.InputInformation.RequestStatus <- RequestEnum.Disabled
efs: DMI.MasterDMI().In_ShuntingRequest.InputInformation.RequestStatus <- RequestEnum.Disabled
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S140.DriverSelectionRequested
expect efs: DMI.MasterDMI().In_Start.InputInformation.RequestStatus == RequestEnum.Request
expect efs: DMI.MasterDMI().In_ShuntingRequest.InputInformation.RequestStatus == RequestEnum.Request
step Offer driver selection, invalid train data
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S140.RequestDriverSelection
set train.data_state invalid
efs: DMI.MasterDMI().In_Start.InputInformation.RequestStatus <- RequestEnum.Disabled
efs: DMI.MasterDMI().In_ShuntingRequest.InputInformation.RequestStatus <- RequestEnum.Disabled
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S140.DriverSelectionRequested
expect efs: DMI.MasterDMI().In_Start.InputInformation.RequestStatus == RequestEnum.Disabled
expect efs: DMI.MasterDMI().In_ShuntingRequest.InputInformation.RequestStatus == RequestEnum.Request
case Driver selects Start, level 1
clause E4 partial 5.11.2.2 S140 ; efs Entry 5.11.2.2.S140.2
step Start selected, level 1
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S140.DriverSelectionRequested
efs: DMI.MasterDMI().In_Start.ProvideDriverResponse()
efs: Kernel.Level.Value.Value <- LevelEnum.L1
efs: Kernel.Level.DataState <- DataStateEnum.Valid
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S160
expect efs: DMI.MasterDMI().In_Start.InputInformation.RequestStatus == RequestEnum.Disabled
case Driver selects Start, level 2 or 3
clause E4 partial 5.11.2.2 S140 ; efs Entry 5.11.2.2.S140.3
step Start selected, level 2
sub Sub-step1
efs: Kernel.Level.Value.Value <- LevelEnum.L2
efs: Kernel.Level.DataState <- DataStateEnum.Valid
efs: DMI.MasterDMI().In_Start.ProvideDriverResponse()
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S140.DriverSelectionRequested
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S150
expect efs: DMI.MasterDMI().In_Start.InputInformation.RequestStatus == RequestEnum.Disabled
step Start selected, level 3
sub Sub-step1
efs: Kernel.Level.Value.Value <- LevelEnum.L3
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S140.DriverSelectionRequested
efs: Kernel.Level.DataState <- DataStateEnum.Valid
efs: DMI.MasterDMI().In_Start.ProvideDriverResponse()
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S150
expect efs: DMI.MasterDMI().In_Start.InputInformation.RequestStatus == RequestEnum.Disabled
case Driver selects SH
clause E4 partial 5.11.2.2 S140 ; efs Entry 5.11.2.2.S140.4
step SH selected
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S140.DriverSelectionRequested
efs: DMI.MasterDMI().In_ShuntingRequest.ProvideDriverResponse()
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.ShuntingInitiatedByDriver
sequence S150: MA request to the RBC
case Setup
step Setup
sub Sub-step1
init 100.0 PT
# the defaults of the EFS model (TrainDataValuesStruct, TIU)
set train.data_state unknown
set train.length 400.0
set train.v_max 150.0
set train.lambda na
set train.brake_position passenger_p
set train.m_rotating_nom na
set train.interface regenerative none
set train.interface eddy_current none
set train.interface magnetic_shoe none
set train.interface ep none
set train.sb_command false
set train.sb_feedback false
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.eb_models clear
set train.sb_models clear
set train.nsb clear
set train.t_brake_emergency clear
set train.t_brake_service clear
set train.kn_plus clear
set train.kn_minus clear
set tiu.active regenerative true
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active ep true
set tiu.additional true
set config.additional_brake_allowed false
set track_conditions
set gradients
set adhesion
set adhesion.driver_slippery false
set tsrs
set odo.speed 0.0
set odo.accel 0.0
set nv defaults
# the EFS test environment (Testing.InitializeTestEnvironment)
set odo.accuracy D_ura=0.0 D_ora=0.0 V_ura=0.0 V_ora=0.0
# InitializeTrainData_ERA
# efs: BTM.ActiveAntennaPosition <- 5.0
set config.additional_brake_allowed true
set train.brake_position passenger_p
set train.eb_models clear
set train.eb_model 2 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 4 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 1 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 6 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 3 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 5 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 7 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 0 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.m_rotating_nom na
set train.v_max 220.0
set train.sb_command true
set train.sb_models clear
set train.sb_model 2 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 4 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 1 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 6 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 3 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 5 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 7 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 0 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.length 197.0
# efs: Kernel.TrainData.TrainData.Value.LoadingGauge <- Messages.M_LOADINGGAUGE.G1
# efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- 2
# efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [Kernel.TrainData.TractionSystemStruct{ Voltage => Messages.M_VOLTAGE.AC_15_kV_16_7_Hz, Country => 85 }]
# InitializeBrakingParameters
set train.kdry 7 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kdry 5 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 7 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 5 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.eb_step 7 0 0.0 1.0
set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
efs: Kernel.Level.Value <- Default.LevelDataStruct{ NTC => NID_NTC.NOT_APPLICABLE, Value => LevelEnum.L2 }
sub SubStep2
efs: Testing.InitializeTerminals()
case Send MA request to the RBC and wait
clause E4 deferred 5.11.2.2 S150 ; efs Entry 5.11.2.2.S150.1
clause - absent 3.8.2.1 ; efs 3.8.2.1
step Send MA request to the RBC and wait
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S150.SendMARequest
efs: EURORADIO.RBCConnection.CurrentRBCConnection().CommunicationSession <- EURORADIO.RBCConnection.RBCStruct.CommunicationSessionStateSM.Established
efs: EURORADIO.RBCConnection.CurrentRBCConnection().SafeRadioConnection.ConnectionState <- EURORADIO.RBCConnection.SafeRadioConnection.SafeRadioConnectionStruct.ConnectionStateSM.Established
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S150.MARequestSent
expect efs: (LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.MA_REQUEST.T_TRAIN == Messages.MESSAGE.TIME_ACCESSORS.Export_T_TRAIN(Kernel.DateAndTime.CurrentTime ) @ deadline=1
expect efs: (LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.MA_REQUEST.Q_MARQSTREASON == Messages.Q_MARQSTREASON.Start_selected_by_driver @ deadline=1
expect efs: (LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.MA_REQUEST.POSITION_REPORT != EMPTY @ deadline=1
expect efs: (LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.MA_REQUEST.NID_MESSAGE == 132 @ deadline=1
expect efs: (LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.MA_REQUEST.NID_ENGINE == Kernel.NidEngine @ deadline=1
expect efs: (LAST message IN EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut).SystemVersion2.MA_REQUEST != EMPTY @ deadline=1
expect efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageOut != [] @ deadline=1
case SR authorisation received
clause E4 deferred 5.11.2.2 S150 ; efs Entry 5.11.2.2.S150.2
step SR authorisation received
sub Sub-step1
efs: Kernel.Modes.StaffResponsible.SRAuthorisation <- Kernel.Modes.StaffResponsible.SRStruct { Location => 1000.0, BGs => [] }
taint ma
efs: Kernel.MA.MA <- EMPTY
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S150.MARequestSent
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S160
step Clean up
sub SubStep1
efs: Kernel.Modes.StaffResponsible.DeleteSRAuthorisation()
case MA allowing OS/LS/SH received
clause E4 deferred 5.11.2.2 S150 ; efs Entry 5.11.2.2.S150.3
step MA allowing OS received
sub Sub-step1
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{}
taint ma
efs: Kernel.MA.ModeProfile.Profile <- [ Kernel.MA.ModeProfile.ModeProfileStruct { AcknLength => 0.0, Location => 0.0, Length => 1000.0, Mode => ModeEnum.ModeProfile.OS, Speed => 40.0, SupervisionQualifier => Messages.Q_MAMODE.as_both_the_EOA_and_SvL__instead_of_the_EOA_and_SvL_given_by_the_MA } ]
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S150.MARequestSent
efs: Kernel.Level.Value.Value <- LevelEnum.L2
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S170
step MA allowing LS received
sub Sub-step1
taint ma
efs: Kernel.MA.ModeProfile.Profile <- [ Kernel.MA.ModeProfile.ModeProfileStruct { AcknLength => 0.0, Location => 0.0, Length => 1000.0, Mode => ModeEnum.ModeProfile.LS, Speed => 40.0, SupervisionQualifier => Messages.Q_MAMODE.as_both_the_EOA_and_SvL__instead_of_the_EOA_and_SvL_given_by_the_MA } ]
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{}
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S150.MARequestSent
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S170
step MA allowing SH received
sub Sub-step1
taint ma
efs: Kernel.MA.ModeProfile.Profile <- [ Kernel.MA.ModeProfile.ModeProfileStruct { AcknLength => 0.0, Location => 0.0, Length => 1000.0, Mode => ModeEnum.ModeProfile.SH, Speed => 40.0, SupervisionQualifier => Messages.Q_MAMODE.as_both_the_EOA_and_SvL__instead_of_the_EOA_and_SvL_given_by_the_MA } ]
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{}
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S150.MARequestSent
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.TrainTrip.S170
case MA allowing FS received
clause E4 deferred 5.11.2.2 S150 ; efs Entry 5.11.2.2.S150.4
step MA allowing FS received
sub Sub-step1
efs: Kernel.ActiveProcedure <- Kernel.ActiveProcedure.TrainTrip.S150.MARequestSent
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{ TargetSpeed => 0.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 1000.0, TimeOut => EMPTY }] }
taint ma
efs: Kernel.MA.ModeProfile.Profile <- []
set gradients 0.0:-0.1
taint track
efs: Kernel.TrackDescription.StaticSpeedProfile.SSP <- [ Kernel.TrackDescription.StaticSpeedProfile.StaticSpeedRestrictionStruct { BasicSpeed => 70.0, Categories => [], Location => 0.0, TrainLengthDelay =>Messages.Q_FRONT.Train_length_delay_on_validity_end_point_of_profile_element } ]
expect efs: Kernel.Mode == ModeEnum.FS
expect efs: Kernel.ActiveProcedure in Kernel.ActiveProcedure.NoProcedure
