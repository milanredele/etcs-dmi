step Setup
sub Sub-step1
init 100.0 SB
# the defaults of the EFS model (TrainDataValuesStruct, TIU)
set train.data_state unknown
set train.length 400.0
set train.v_max 150.0
set train.lambda na
set train.brake_position passenger_p
set train.m_rotating_nom na
set train.interface regenerative none
set train.interface eddy_current none
set train.interface magnetic_shoe none
set train.interface ep none
set train.sb_command false
set train.sb_feedback false
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.eb_models clear
set train.sb_models clear
set train.nsb clear
set train.t_brake_emergency clear
set train.t_brake_service clear
set train.kn_plus clear
set train.kn_minus clear
set tiu.active regenerative true
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active ep true
set tiu.additional true
set config.additional_brake_allowed false
set track_conditions
set gradients
set adhesion
set adhesion.driver_slippery false
set tsrs
set odo.speed 0.0
set odo.accel 0.0
set nv defaults
# the EFS test environment (Testing.InitializeTestEnvironment)
set odo.accuracy D_ura=0.0 D_ora=0.0 V_ura=0.0 V_ora=0.0
# InitializeTrainData_ERA
# efs: BTM.ActiveAntennaPosition <- 5.0
set config.additional_brake_allowed true
set train.brake_position passenger_p
set train.eb_models clear
set train.eb_model 2 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 4 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 1 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 6 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 3 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 5 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 7 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 0 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.m_rotating_nom na
set train.v_max 220.0
set train.sb_command true
set train.sb_models clear
set train.sb_model 2 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 4 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 1 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 6 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 3 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 5 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 7 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 0 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.length 197.0
# efs: Kernel.TrainData.TrainData.Value.LoadingGauge <- Messages.M_LOADINGGAUGE.G1
# efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- 2
# efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [Kernel.TrainData.TractionSystemStruct{ Voltage => Messages.M_VOLTAGE.AC_15_kV_16_7_Hz, Country => 85 }]
# InitializeBrakingParameters
set train.kdry 7 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kdry 5 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 7 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 5 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.eb_step 7 0 0.0 1.0
set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
sub SubStep2
set train.data_state valid
efs: BTM.LRBG.PreviousBaliseGroups <- []
efs: Kernel.Level.Value.Value <- LevelEnum.L1
set odo.position 0.0
expect efs: (COUNT X IN BTM.Linking.Linkings) == 0
step Linking packet received
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=9618 Q_LINK=0 | LINKING NID_PACKET=5 Q_DIR=1 L_PACKET=400 Q_SCALE=1 D_LINK=3500 Q_NEWCOUNTRY=0 NID_BG=9620 Q_LINKORIENTATION=1 Q_LINKREACTION=1 Q_LOCACC=1 N_ITER=1 D_LINK=4500 Q_NEWCOUNTRY=0 NID_BG=9622 Q_LINKORIENTATION=1 Q_LINKREACTION=1 Q_LOCACC=1 NID_C=0 NID_C=0
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9618, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 0.0, Position => 2000.0, UnderReadingAmountOdo => 0.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
set odo.position 3000.0
sub Sub-step2
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=9618 Q_LINK=0
expect efs: (COUNT X IN BTM.Linking.Linkings) == 2
expect efs: (FIRST X IN BTM.Linking.Linkings).BaliseGroupIdentifier == 9620 @ deadline=1
expect efs: (FIRST X IN BTM.Linking.Linkings).Distance == 4495.0 @ deadline=1
expect efs: (LAST X IN BTM.Linking.Linkings).BaliseGroupIdentifier == 9622 @ deadline=1
expect efs: (LAST X IN BTM.Linking.Linkings).Distance == 4500.0 @ deadline=1
step Another balise with linking information received
sub Sub-step1 - First balise of unlinked balise group received
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=9618 Q_LINK=0 | LINKING NID_PACKET=5 Q_DIR=1 L_PACKET=400 Q_SCALE=1 D_LINK=1500 Q_NEWCOUNTRY=0 NID_BG=9620 Q_LINKORIENTATION=1 Q_LINKREACTION=1 Q_LOCACC=1 N_ITER=0
sub Sub-step2 - Second balise of unlinked balise group received
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=9618 Q_LINK=0
expect efs: (COUNT X IN BTM.Linking.Linkings) == 1 @ deadline=1
expect efs: (FIRST X IN BTM.Linking.Linkings).Distance == 2495.0 @ deadline=1
expect efs: (FIRST X IN BTM.Linking.Linkings).BaliseGroupIdentifier == 9620 @ deadline=1
sequence Receive Linking Information
case Receive a single linking packet
clause - absent 3.4.4.2.1.1 ; efs 3.4.4.2.1.1
clause - absent 3.4.4.2.1 ; efs 3.4.4.2.1
clause - absent 3.4.4.2.1 a) ; efs 3.4.4.2.1.a
clause - absent 3.4.4.2.1 b) ; efs 3.4.4.2.1.b
clause - absent 3.4.4.2.1 c) ; efs 3.4.4.2.1.c
clause - absent 3.4.4.2.1 d) ; efs 3.4.4.2.1.d
clause - absent 3.4.4.2.1 e) ; efs 3.4.4.2.1.e
step Setup
sub Sub-step1
init 2000.0 SR
# the defaults of the EFS model (TrainDataValuesStruct, TIU)
set train.data_state unknown
set train.length 400.0
set train.v_max 150.0
set train.lambda na
set train.brake_position passenger_p
set train.m_rotating_nom na
set train.interface regenerative none
set train.interface eddy_current none
set train.interface magnetic_shoe none
set train.interface ep none
set train.sb_command false
set train.sb_feedback false
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.eb_models clear
set train.sb_models clear
set train.nsb clear
set train.t_brake_emergency clear
set train.t_brake_service clear
set train.kn_plus clear
set train.kn_minus clear
set tiu.active regenerative true
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active ep true
set tiu.additional true
set config.additional_brake_allowed false
set track_conditions
set gradients
set adhesion
set adhesion.driver_slippery false
set tsrs
set odo.speed 0.0
set odo.accel 0.0
set nv defaults
# the EFS test environment (Testing.InitializeTestEnvironment)
set odo.accuracy D_ura=0.0 D_ora=0.0 V_ura=0.0 V_ora=0.0
# InitializeTrainData_ERA
# efs: BTM.ActiveAntennaPosition <- 5.0
set config.additional_brake_allowed true
set train.brake_position passenger_p
set train.eb_models clear
set train.eb_model 2 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 4 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 1 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 6 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 3 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 5 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 7 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.eb_model 0 0:0.0:1.07 1:160.0:0.8 2:inf:0.0
set train.m_rotating_nom na
set train.v_max 220.0
set train.sb_command true
set train.sb_models clear
set train.sb_model 2 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 4 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 1 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 6 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 3 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 5 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 7 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.sb_model 0 0:0.0:0.92 1:160.0:0.69 2:inf:0.0
set train.traction_cut_off false
set train.traction_model 0.0 0.0
set train.length 197.0
# efs: Kernel.TrainData.TrainData.Value.LoadingGauge <- Messages.M_LOADINGGAUGE.G1
# efs: Kernel.TrainData.TrainData.Value.AxleLoadCategory <- 2
# efs: Kernel.TrainData.TrainData.Value.TractionSystems <- [Kernel.TrainData.TractionSystemStruct{ Voltage => Messages.M_VOLTAGE.AC_15_kV_16_7_Hz, Country => 85 }]
# InitializeBrakingParameters
set train.kdry 7 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kdry 5 9 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 7 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.kwet 5 0:1.0 1:1.0 2:1.0 3:1.0 4:1.0 5:1.0 6:1.0
set train.eb_step 7 0 0.0 1.0
set train.eb_step 7 1 inf 1.0
set train.eb_step 5 0 0.0 0.8
set train.eb_step 5 1 inf 0.8
set train.interface eddy_current both
set train.interface magnetic_shoe eb
set train.interface regenerative both
set train.sb_step 3 0 0.0 1.0
set train.sb_step 3 1 inf 1.0
set train.sb_step 1 0 0.0 1.0
set train.sb_step 1 1 inf 1.0
set train.t_brake_emergency 7 2.5
set train.t_brake_emergency 5 2.0
set train.t_brake_service 3 2.5
set train.t_brake_service 1 2.0
set tiu.active eddy_current true
set tiu.active magnetic_shoe true
set tiu.active regenerative true
call ConversionModel.Initialize
# InitializeTrainData_BNS
set train.nsb clear
set train.nsb_a_sb01 0.4
set train.nsb_a_sb12 0.7
set train.nsb_model p 0 0:0.0:0.8 1:60.0:0.6 2:120.0:0.4 3:200.0:0.2
set train.nsb_model p 1 0:0.0:0.9 1:25.0:0.8 2:40.0:0.64 3:75.0:0.5 4:100.0:0.35 5:150.0:0.2 6:200.0:0.14
set train.nsb_model p 2 0:0.0:0.6 1:80.0:0.2 2:200.0:0.1
set train.nsb_model g 0 0:0.0:0.8 1:50.0:0.72 2:80.0:0.6 3:120.0:0.45 4:180.0:0.32 5:250.0:0.3
set train.nsb_model g 1 0:0.0:0.82 1:50.0:0.7 2:70.0:0.68 3:100.0:0.51 4:150.0:0.34 5:200.0:0.27
set train.nsb_model g 2 0:0.0:0.94 1:40.0:0.8 2:75.0:0.65 3:100.0:0.5 4:150.0:0.4 5:200.0:0.35 6:250.0:0.3
# Initialize
set nv data_state valid
set nv defaults
set nv M_NVEBCL 9
set nv A_NVMAXREDADH1 1.0
set nv A_NVMAXREDADH2 0.7
set nv A_NVMAXREDADH3 0.7
set nv Q_NVINHSMICPERM 1
set nv Q_NVSBTSMPERM 1
set nv M_NVAVADH 0.0
end init
sub Sub-step2
efs: BTM.LRBG.PreviousBaliseGroups <- [ BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 9618, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 0.0, Position => 2000.0, UnderReadingAmountOdo => 0.0 } }, IsLRBG => True, IsSingle => False } ]
efs: Testing.SetOSMode(False)
expect efs: (COUNT X IN BTM.Linking.Linkings) == 0
step Linking packet received
sub Move
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=1 NID_BG=9618 Q_LINK=0 | LINKING NID_PACKET=5 Q_DIR=1 L_PACKET=400 Q_SCALE=1 D_LINK=3500 Q_NEWCOUNTRY=0 NID_BG=10000 Q_LINKORIENTATION=1 Q_LINKREACTION=1 Q_LOCACC=1 N_ITER=0
set odo.position 3000.0
set odo.speed 40.0
sub Check LRBG
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=4 NID_C=1 NID_BG=9618 Q_LINK=0
expect efs: (COUNT X IN BTM.Linking.Linkings) == 1
expect efs: (FIRST X IN BTM.Linking.Linkings).BaliseGroupIdentifier == 10000 @ deadline=1
expect efs: (FIRST X IN BTM.Linking.Linkings).Distance == 4495.0 @ deadline=1
expect efs: BTM.AntennaDistance( aPointOfInterest => Default.DistanceIntervalEnum.Min ) <= BTM.Linking.CurrentLinking().Distance + BTM.Linking.CurrentLinking().LocationAccuracy @ deadline=1
sub Detect New BG
telegram balise Q_UPDOWN=1 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=0 NID_C=1 NID_BG=1338 Q_LINK=1
sub Check LRBG Update
expect efs: (FIRST X IN BTM.Linking.Linkings).Orientation == OrientationEnum.Nominal @ deadline=1
expect efs: (FIRST X IN BTM.Linking.Linkings).Reaction == BTM.Linking.LinkingReaction.CommandServiceBrake @ deadline=1
step See a linked balise rear of window
sub Sub-step1
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 10000, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 0.0, Position => 3100.0, UnderReadingAmountOdo => 0.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=1 NID_C=1 NID_BG=10000 Q_LINK=1 | SYSTEM_VERSION_ORDER NID_PACKET=2 Q_DIR=1 M_VERSION=32
set odo.position 3200.0
expect efs: TIU.Brakes.BrakeCommanded()
step Purge obsolete linking info
sub Sub-step1 - Receive first telegram of unlinked balise group
set odo.position 12600.0
efs: INSERT BTM.LRBG.PreviousBaliseGroupStruct{ BaliseGroup => BTM.LRBG.BaliseGroupStruct { NID_BG => 10001, BGOrientation => OrientationEnum.Nominal, TrainRunningDirection => OrientationEnum.Nominal, Position => BTM.PositionStruct { OverReadingAmountOdo => 0.0, Position => 9000.0, UnderReadingAmountOdo => 0.0 } }, IsLRBG => True, IsSingle => False } IN BTM.LRBG.PreviousBaliseGroups
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=1 NID_C=140 NID_BG=10001 Q_LINK=0 | SYSTEM_VERSION_ORDER NID_PACKET=2 Q_DIR=1 M_VERSION=32
sub Sub-step2 - Receive second telegram of unlinked balise group
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=1 NID_C=140 NID_BG=10001 Q_LINK=0
expect efs: (COUNT X IN BTM.Linking.Linkings) == 0
sequence Single repositioning BG does not trigger RAMS supervision
case Receive repositioning information
clause E6 todo 3.16.2.7.2.1 ; efs 3.16.2.7.2.1
clause E6 todo 3.16.2.7.2.2 ; efs 3.16.2.7.2.2
step Setup
sub Initialize test environment
efs: Testing.InitializeTestEnvironment( aTrainPosition => 100.0, aMode => Default.ModeEnum.FS )
sub Set linkings
efs: Testing.InitializeLinkings( aLinkings => [BTM.Linking.LinkingDataStruct{ LocationAccuracy => 5.0, Orientation => OrientationEnum.Nominal, Reaction => BTM.Linking.LinkingReaction.NoReaction, Distance => 100.0, BaliseGroupIdentifier => Messages.NID_BG.NID_UNKNOWN, CountryIdentifier => 81 }] )
step Receive BG and check the brake command
sub First part of the BG
telegram balise Q_UPDOWN=0 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=81 NID_BG=1050 Q_LINK=1 | REPOSITIONING_INFORMATION NID_PACKET=16 Q_DIR=1 L_PACKET=0 Q_SCALE=1 L_SECTION=400
sub Second part of the BG
telegram balise Q_UPDOWN=0 M_VERSION=32 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=81 NID_BG=1050 Q_LINK=1
sub Check the RAMS brake
expect efs: NOT THERE_IS brake IN Kernel.BrakeCommands.ServiceBrakeCommands | brake.Reason == Kernel.BrakeCommands.BrakeReasonEnum.RAMSSupervision @ deadline=1
