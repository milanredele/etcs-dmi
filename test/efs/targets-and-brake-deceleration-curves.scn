taint track
efs: Kernel.TrackDescription.StaticSpeedProfile.SSP <- [Kernel.TrackDescription.StaticSpeedProfile.StaticSpeedRestrictionStruct{ Location => 0.0, BasicSpeed => 70.0, TrainLengthDelay => Messages.Q_FRONT.No_train_length_delay_on_validity_end_point_of_profile_element, Categories => [] }, Kernel.TrackDescription.StaticSpeedProfile.StaticSpeedRestrictionStruct{ Location => 450.0, BasicSpeed => 50.0, TrainLengthDelay => Messages.Q_FRONT.No_train_length_delay_on_validity_end_point_of_profile_element, Categories => [] }, Kernel.TrackDescription.StaticSpeedProfile.StaticSpeedRestrictionStruct{ Location => 500.0, BasicSpeed => 70.0, TrainLengthDelay => Messages.Q_FRONT.No_train_length_delay_on_validity_end_point_of_profile_element, Categories => [] }]
step Initial checks
sub SubStep1
expect efs: Kernel.SpeedAndDistanceMonitoring.GetMonitoringType() == Kernel.SpeedAndDistanceMonitoring.MonitoringType.CSM @ deadline=1
step Move forwards to PIM
sub SubStep1
set odo.position 20.0
expect efs: Kernel.SpeedAndDistanceMonitoring.GetMonitoringType() == Kernel.SpeedAndDistanceMonitoring.MonitoringType.PIM @ deadline=1
step Move forwards to TSM
sub SubStep1
set odo.position 160.0
expect efs: Kernel.SpeedAndDistanceMonitoring.GetMonitoringType() == Kernel.SpeedAndDistanceMonitoring.MonitoringType.TSM @ deadline=1
step Move past target
sub SubStep1
set odo.position 450.0
expect efs: Kernel.SpeedAndDistanceMonitoring.GetMonitoringType() == Kernel.SpeedAndDistanceMonitoring.MonitoringType.CSM @ deadline=1
sequence LOA greater than MRSP
case No target supervision at LOA
step Setup
sub SubStep1
efs: Testing.InitializeTestEnvironment( aTrainPosition => 0.0, aMode => Default.ModeEnum.FS )
sub SubStep2
taint track
efs: Kernel.TrackDescription.StaticSpeedProfile.SSP <- [Kernel.TrackDescription.StaticSpeedProfile.StaticSpeedRestrictionStruct{ Location => 0.0, BasicSpeed => 30.0, TrainLengthDelay => Messages.Q_FRONT.No_train_length_delay_on_validity_end_point_of_profile_element, Categories => [] }]
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{ TargetSpeed => 40.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 500.0, TimeOut => EMPTY }], EndSection => Kernel.MA.EndSectionStruct{ EndSectionTimeOut => EMPTY, DangerPoint => EMPTY, Overlap => EMPTY } }
step Check supervised targets
sub SubStep1
expect efs: Kernel.SpeedAndDistanceMonitoring.Display.DisplayIndicationLocationAtMRSPSpeed() == False @ deadline=1
