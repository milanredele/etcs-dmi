case Receive MA
clause - absent 3.11.2.2 e) ; efs 3.11.2.2.e
step Provide MA
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_1_MOVEMENT_AUTHORITY NID_PACKET=8 Q_DIR=2 L_PACKET=400 Q_SCALE=1 V_MAIN=14 V_EMA=0 T_EMA=200 N_ITER=4 L_SECTION=1200 Q_SECTIONTIMER=1 T_SECTIONTIMER=40 D_SECTIONTIMERSTOPLOC=20 L_SECTION=1400 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 L_SECTION=1000 Q_SECTIONTIMER=1 T_SECTIONTIMER=20 D_SECTIONTIMERSTOPLOC=25 L_SECTION=1400 Q_SECTIONTIMER=1 T_SECTIONTIMER=25 D_SECTIONTIMERSTOPLOC=40 L_ENDSECTION=1000 Q_SECTIONTIMER=0 T_SECTIONTIMER=0 D_SECTIONTIMERSTOPLOC=0 Q_ENDTIMER=0 T_ENDTIMER=0 D_ENDTIMERSTARTLOC=0 Q_DANGERPOINT=1 D_DP=1000 V_RELEASEDP=8 Q_OVERLAP=1 D_STARTOL=100 T_OL=40 D_OL=1500 V_RELEASEOL=7
expect ceiling_P 4000.0 == 70.0
expect ceiling_P 6000.0 == 0.0
expect ceiling_P 8000.0 == 0.0
expect ceiling_P 2000.0 == 70.0
expect ceiling_P 7000.0 == 0.0
case Receive TSR
clause - absent 3.11.2.2 c) ; efs 3.11.2.2.c
step Provide TSR
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | TEMPORARY_SPEED_RESTRICTION NID_PACKET=8 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_TSR=115 D_TSR=4000 L_TSR=2500 Q_FRONT=1 V_TSR=5
expect ceiling_P 4000.0 == 25.0
expect ceiling_P 7000.0 == 0.0
expect ceiling_P 8000.0 == 0.0
expect ceiling_P 2000.0 == 70.0
expect efs: Kernel.SpeedAndDistanceMonitoring.Display.PermittedSpeed () == 70.0
case Receive LX
clause - absent 3.11.2.2 i) ; efs 3.11.2.2.i
step Provide LX
sub Sub-step1
telegram balise Q_UPDOWN=1 M_VERSION=32 Q_MEDIA=0 N_PIG=0 N_TOTAL=0 M_DUP=0 M_MCOUNT=4 NID_C=140 NID_BG=2124 Q_LINK=1 | LEVEL_CROSSING_INFORMATION NID_PACKET=88 Q_DIR=2 L_PACKET=400 Q_SCALE=1 NID_LX=20 D_LX=2000 L_LX=250 Q_LXSTATUS=1 V_LX=4 Q_STOPLX=0 L_STOPLX=0
expect ceiling_P 4000.0 == 25.0
expect ceiling_P 7000.0 == 0.0
expect ceiling_P 8000.0 == 0.0
case Compute MREBDT
step Update the traction model
sub Sub-step1
set odo.accel 0.4
set train.traction_model 14.0 2.0
set train.traction_cut_off true
expect Vdelta0 == 0.0
expect Vdelta2 0.0 == 0.0
expect T_berem 0.0 == 0.0
