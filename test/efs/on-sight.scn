efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message { SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message { MOVEMENT_AUTHORITY => Messages.MESSAGE.TRACK_TO_TRAIN.MOVEMENT_AUTHORITY.Message { NID_MESSAGE => 0, L_MESSAGE => 0, T_TRAIN => Messages.MESSAGE.TIME_ACCESSORS.Export_T_TRAIN(Kernel.DateAndTime.CurrentTime), M_ACK => Messages.M_ACK.No_acknowledgement_required, NID_LRBG => 1986, LEVEL_2_3_MOVEMENT_AUTHORITY => Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.Message { NID_PACKET => 15, Q_DIR => Messages.Q_DIR.Nominal, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, V_LOA => 0, T_LOA => 0, N_ITER => 1, Sequence1 => [ Messages.PACKET.TRACK_TO_TRAIN.LEVEL_2_3_MOVEMENT_AUTHORITY.SubStructure1 { L_SECTION => 100, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0 } ], L_ENDSECTION => 1000, Q_SECTIONTIMER => Messages.Q_SECTIONTIMER.No_Section_Timer_information, T_SECTIONTIMER => 0, D_SECTIONTIMERSTOPLOC => 0, Q_ENDTIMER => Messages.Q_ENDTIMER.No_End_section_timer_information, T_ENDTIMER => 0, D_ENDTIMERSTARTLOC => 0, Q_DANGERPOINT => Messages.Q_DANGERPOINT.No_danger_point_information, D_DP => 0, V_RELEASEDP => 0, Q_OVERLAP => Messages.Q_OVERLAP.No_overlap_information, D_STARTOL => 0, T_OL => 0, D_OL => 0, V_RELEASEOL => 0 }, Sequence1 =>[ Messages.MESSAGE.TRACK_TO_TRAIN.MOVEMENT_AUTHORITY.SubStructure1 { MODE_PROFILE=>Messages.PACKET.TRACK_TO_TRAIN.MODE_PROFILE.Message { D_MAMODE=>100, L_ACKMAMODE=>500, L_MAMODE=>100, L_PACKET=>0, M_MAMODE=>Messages.M_MAMODE.On_Sight, N_ITER=>0, NID_PACKET=>80, Q_DIR=> Messages.Q_DIR.Nominal, Q_MAMODE=> Messages.Q_MAMODE.as_both_the_EOA_and_SvL__instead_of_the_EOA_and_SvL_given_by_the_MA, Q_SCALE=>Messages.Q_SCALE._1_m_scaleC, V_MAMODE=>1, Sequence1=>[] } } ] } }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal }
