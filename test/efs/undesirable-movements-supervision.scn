sub SubStep2
set odo.speed -1.0
efs: BTM.LRBG.PreviousBaliseGroups <- []
expect efs: Kernel.UndesirableMovement.ReverseMovementReferencePosition == Odometry.NominalDistance @ deadline=1
step Reverse movement allowed
sub SubStep1
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance - 0.5 * Kernel.NationalValues.CurrentNV().DistToBeAllowedForReversingInPostTripMode
set odo.speed -1.0
efs: TIU.DirectionControllerInformation <- TIU.DirectionControllerEnum.Backward
expect efs: Kernel.UndesirableMovement.ReverseMovementReferencePosition == 400.0 @ deadline=1 cyclephase=Processing
expect efs: NOT Kernel.UndesirableMovement.ReverseDistanceExceeded() @ deadline=1 cyclephase=Processing
expect efs: Kernel.BrakeCommands.ServiceBrakeCommands == [] @ deadline=1 cyclephase=Processing
expect efs: Kernel.BrakeCommands.EmergencyBrakeCommands == [] @ deadline=1 cyclephase=Processing
expect efs: NOT Kernel.UndesirableMovement.ReverseMovementDetected(Kernel.UndesirableMovement.ReverseMovementReferencePosition) @ deadline=1
step Allowed reverse distance in PT exceeded
sub SubStep1
taint odo
efs: Odometry.NominalDistance <- Odometry.NominalDistance - 1.0 * Kernel.NationalValues.CurrentNV().DistToBeAllowedForReversingInPostTripMode
expect efs: THERE_IS X IN Kernel.BrakeCommands.ServiceBrakeCommands | X.Reason == Kernel.BrakeCommands.BrakeReasonEnum.PTReversingDistanceExceeded @ deadline=1
step Ask for acknowledgement when at standstill
sub Movement
expect efs: DMI.MasterDMI().In_AcknForPostTripDistanceExceeded.InputInformation.RequestStatus == RequestEnum.Disabled AND FORALL X IN DMI.IN.Acknowledgements.Acknowledgements | X.Type != DMI.IN.Acknowledgements.AckTypeEnum.PostTripDistanceExceeded @ deadline=1
sub Standstill
set odo.speed 0.0
expect efs: DMI.MasterDMI().In_AcknForPostTripDistanceExceeded.InputInformation.RequestStatus != RequestEnum.Disabled OR THERE_IS X IN DMI.IN.Acknowledgements.Acknowledgements | X.Type == DMI.IN.Acknowledgements.AckTypeEnum.PlainTextInformation @ deadline=1
step Release brake when acknowledgement is received
sub Acknowledgement received
efs: DMI.MasterDMI().In_AcknForPostTripDistanceExceeded.InputInformation.RequestStatus <- Default.RequestEnum.Response
expect efs: FORALL X IN Kernel.BrakeCommands.ServiceBrakeCommands | X.Reason != Kernel.BrakeCommands.BrakeReasonEnum.PermanentCommandInCurrentMode @ deadline=1
expect efs: DMI.MasterDMI().Out_BrakeReason.OutputInformation.DisplayRequested == False @ deadline=1
