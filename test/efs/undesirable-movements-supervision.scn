expect efs: THERE_IS X IN Kernel.BrakeCommands.ServiceBrakeCommands | X.Reason == Kernel.BrakeCommands.BrakeReasonEnum.RollAwayProtection @ deadline=1
expect efs: DMI.MasterDMI().Out_BrakeReason.OutputInformation.DisplayRequested == True @ deadline=1
step Ask for acknowledgement when at standstill
sub Movement
expect efs: DMI.MasterDMI().In_AcknForRollAwayProtection.InputInformation.RequestStatus == RequestEnum.Disabled AND FORALL X IN DMI.IN.Acknowledgements.Acknowledgements | X.Type != DMI.IN.Acknowledgements.AckTypeEnum.RollAwayProtection @ deadline=1
