sub Sub-step2 - Set MA and level
taint ma
efs: Kernel.MA.MA <- Kernel.MA.MAStruct{ TargetSpeed => 0.0, Sections => [Kernel.MA.Sections.SectionStruct{ Length => 10000.0, TimeOut => EMPTY }] }
efs: Testing.InitializeEURORADIO()
step Receive reversing area + supervision information from balise
sub Sub-step1 - Get the two packets from a balise
telegram balise Q_UPDOWN=1 M_VERSION=17 Q_MEDIA=0 N_PIG=0 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5461 Q_LINK=0 | REVERSING_AREA_INFORMATION NID_PACKET=138 Q_DIR=1 L_PACKET=0 Q_SCALE=1 D_STARTREVERSE=1500 L_REVERSEAREA=350
sub Sub-step2 - Second balise for direction
telegram balise Q_UPDOWN=1 M_VERSION=17 Q_MEDIA=0 N_PIG=1 N_TOTAL=1 M_DUP=0 M_MCOUNT=255 NID_C=85 NID_BG=5461 Q_LINK=0 | REVERSING_SUPERVISION_INFORMATION NID_PACKET=139 Q_DIR=1 L_PACKET=0 Q_SCALE=1 D_REVERSE=500 V_REVERSE=6
expect efs: Kernel.TrackDescription.ReversingArea.ReversingSupervisionInformation == Kernel.TrackDescription.ReversingArea.ReversingSupervisionStruct { MaxDistance => 500.0, Speed => 30.0 } @ deadline=1
expect efs: Kernel.TrackDescription.ReversingArea.ReversingAreaProfile == Kernel.TrackDescription.ReversingArea.ReversingAreaStruct { Location => 1595.0, Length => 350.0 } @ deadline=1
case Receiving new reversing supervision information
clause E6 todo 3.15.4.3 ; efs 3.15.4.3
clause E6 todo 3.15.4.3 ; efs 3.15.4.3.1
step Enter level 2
sub SubStep1
efs: Kernel.Level <- Kernel.LevelData{ Value => LevelDataStruct{ NTC => NID_NTC.NOT_APPLICABLE, Value => LevelEnum.L2 }, DataState => DataStateEnum.Valid }
step New reversing area + supervision information
sub Sub-step1
efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message { SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message{ GENERAL_MESSAGE => Messages.MESSAGE.TRACK_TO_TRAIN.GENERAL_MESSAGE.Message{ NID_MESSAGE => 24, L_MESSAGE => 0, T_TRAIN => 1600, M_ACK => Messages.M_ACK.No_acknowledgement_required, NID_LRBG => 1986, Sequence1 => [ Messages.MESSAGE.TRACK_TO_TRAIN.GENERAL_MESSAGE.SubStructure1{ REVERSING_AREA_INFORMATION => Messages.PACKET.TRACK_TO_TRAIN.REVERSING_AREA_INFORMATION.Message{ NID_PACKET => 138, Q_DIR => Messages.Q_DIR.Both_directions, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, D_STARTREVERSE => 1800, L_REVERSEAREA => 500 } }, Messages.MESSAGE.TRACK_TO_TRAIN.GENERAL_MESSAGE.SubStructure1{ REVERSING_SUPERVISION_INFORMATION => Messages.PACKET.TRACK_TO_TRAIN.REVERSING_SUPERVISION_INFORMATION.Message{ NID_PACKET => 139, Q_DIR => Messages.Q_DIR.Both_directions, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, D_REVERSE => 630, V_REVERSE => 8 } } ] } }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal }
expect efs: Kernel.TrackDescription.ReversingArea.ReversingAreaProfile == Kernel.TrackDescription.ReversingArea.ReversingAreaStruct { Location => 1800.0, Length => 500.0 } @ deadline=1
expect efs: Kernel.TrackDescription.ReversingArea.ReversingSupervisionInformation == Kernel.TrackDescription.ReversingArea.ReversingSupervisionStruct { MaxDistance => 630.0, Speed => 40.0 } @ deadline=1
step New reversing supervision information
sub Sub-step1
efs: EURORADIO.RBCConnection.CurrentRBCConnection().Data.MessageIn <- Messages.EURORADIO.MessageIn.Message { SystemVersion2 => Messages.MESSAGE.TRACK_TO_TRAIN.Message{ GENERAL_MESSAGE => Messages.MESSAGE.TRACK_TO_TRAIN.GENERAL_MESSAGE.Message{ NID_MESSAGE => 24, L_MESSAGE => 0, T_TRAIN => 1532, M_ACK => Messages.M_ACK.No_acknowledgement_required, NID_LRBG => 1986, Sequence1 => [ Messages.MESSAGE.TRACK_TO_TRAIN.GENERAL_MESSAGE.SubStructure1{ REVERSING_SUPERVISION_INFORMATION => Messages.PACKET.TRACK_TO_TRAIN.REVERSING_SUPERVISION_INFORMATION.Message{ NID_PACKET => 139, Q_DIR => Messages.Q_DIR.Both_directions, L_PACKET => 0, Q_SCALE => Messages.Q_SCALE._1_m_scaleC, D_REVERSE => 580, V_REVERSE => 5 } } ] } }, SystemVersion1 => EMPTY, Priority => Messages.EURORADIO.MessagePriorityEnum.Normal }
expect efs: Kernel.TrackDescription.ReversingArea.ReversingSupervisionInformation == Kernel.TrackDescription.ReversingArea.ReversingSupervisionStruct { MaxDistance => 580.0, Speed => 25.0 } @ deadline=1
expect efs: Kernel.TrackDescription.ReversingArea.ReversingAreaProfile == Kernel.TrackDescription.ReversingArea.ReversingAreaStruct { Location => 1800.0, Length => 500.0 } @ deadline=1
case Sections are measured from the estimated front end
clause - absent 3.15.4.2.2 ; efs 3.15.4.2.2
step Location check
sub Sub-step1 - Max safe front end passes start
set odo.position 1790.0
set odo.accuracy D_ora=24.0
set odo.accuracy D_ura=24.0
expect efs: NOT DMI.MasterDMI().Out_ReversingAllowed.OutputInformation.DisplayRequested @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Nom) < Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Max) > Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location @ deadline=1
expect efs: BTM.LRBG.LRBG().Position.Position == 0.0 @ deadline=1
expect efs: Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location == 1800.0 @ deadline=1
expect efs: (BTM.LRBG.LRBG().Position.Position + Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location) == 1800.0 @ deadline=1
sub Sub-step2 - Estimated front end passes start
set odo.position 1810.0
expect efs: DMI.MasterDMI().Out_ReversingAllowed.OutputInformation.DisplayRequested @ deadline=1
expect efs: Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Min) < Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location @ deadline=0.3
expect efs: Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Nom) > Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location @ deadline=1
case At standstill
clause E6 todo 3.15.4.7 ; efs 3.15.4.7
clause E6 todo 3.15.4.4 ; efs 3.15.4.4
clause E4 todo 5.13.1.3 ; efs 5.13.1.3
clause E4 todo 5.13.1.4 ; efs 5.13.1.4
clause E4 todo 5.13.1.5 ; efs 5.13.1.5
step Standstill
sub Sub-step1
set odo.speed 0.0
step Outside of reversing area
sub Sub-step1 - At standstill outside of accepted area
set odo.position 1500.0
efs: 
expect efs: NOT ( DMI.MasterDMI().Out_ReversingAllowed.OutputInformation.DisplayRequested ) @ deadline=0.3
expect efs: Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location == 1800.0 @ deadline=1
sub Sub-step2 - Driver tries reversing
efs: TIU.DirectionControllerInformation <- TIU.DirectionControllerEnum.Backward
expect efs: Kernel.Mode == ModeEnum.FS @ deadline=1
expect efs: DMI.MasterDMI().In_AcknOfRVMode.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
step Inside reversing area
sub Sub-step1 - Train stopped inside reversing area
set odo.position 2100.0
expect efs: DMI.MasterDMI().Out_ReversingAllowed.OutputInformation.DisplayRequested @ deadline=1
expect efs: Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location == 1800.0 @ deadline=1
expect efs: Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Location + Kernel.TrackDescription.ReversingArea.ReversingAreaProfile.Length == 2300.0 @ deadline=1
sub Sub-step2 - Driver tries reversing
efs: TIU.DirectionControllerInformation <- TIU.DirectionControllerEnum.Backward
expect efs: DMI.MasterDMI().In_AcknOfRVMode.InputInformation.RequestStatus == RequestEnum.Request @ deadline=1
sub Sub-step3 - Driver acknowledges RV
efs: DMI.MasterDMI().In_AcknOfRVMode.ProvideDriverResponse()
expect efs: Kernel.Mode == ModeEnum.RV @ deadline=1
step In motion
sub Sub-step1 - Moving in reversing area
set odo.speed 50.0
set odo.position 2100.0
efs: Testing.SetFSMode(False)
expect efs: NOT (DMI.MasterDMI().Out_ReversingAllowed.OutputInformation.DisplayRequested) @ deadline=1
sub Sub-step2 - Driver tries reversing in motion
efs: TIU.DirectionControllerInformation <- TIU.DirectionControllerEnum.Backward
expect efs: DMI.MasterDMI().In_AcknOfRVMode.InputInformation.RequestStatus == RequestEnum.Disabled @ deadline=1
