case Confidence interval
clause - absent 3.6.4.2 ; efs 3.6.4.2
clause - absent 3.6.4.2 a) ; efs 3.6.4.2.a
clause - absent 3.6.4.2 b) ; efs 3.6.4.2.b
step L_DOUBTOVER
sub Sub-step1
expect efs: Kernel.TrainPosition.ConfidenceInterval.ConfidenceInterval(ConfidenceIntervalEnum.L_DOUBTOVER) == 19.0
expect efs: BTM.LRBGLocationAccuracy() == 12.0
expect efs: Kernel.TrainPosition.ConfidenceInterval.OverReadingAmount(Odometry.Accuracy.D_ora) == 7.0
step L_DOUBTUNDER
sub Sub-step1
expect efs: Kernel.TrainPosition.ConfidenceInterval.ConfidenceInterval(ConfidenceIntervalEnum.L_DOUBTUNDER) == 20.0
expect efs: Kernel.TrainPosition.ConfidenceInterval.UnderReadingAmount(Odometry.Accuracy.D_ura) == 8.0
expect efs: BTM.LRBGLocationAccuracy() == 12.0
case Distance from LRBG
step Distance from LRBG
sub Sub-step1
set odo.position 200.0
efs: (FIRST X IN BTM.LRBG.PreviousBaliseGroups | X.BaliseGroup == BTM.LRBG.LRBG()).BaliseGroup.Position.Position <- 40.0
expect efs: Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Nom) == 160.0
case Train front end position
clause - absent 3.6.4.4 a) ; efs 3.6.4.4.a
clause - absent 3.6.4.4 b) ; efs 3.6.4.4.b
clause - absent 3.6.4.4 c) ; efs 3.6.4.4.c
step Estimated front end
sub Sub-step1
set odo.position 1800.0
expect efs: Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Nom) == Odometry.NominalDistance - BTM.LRBG.LRBG().Position.Position
step Maximum safe front end
sub Sub-step1
expect efs: Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Max) == 1780.0
expect efs: BaseTypes.LengthToDistance(Kernel.TrainPosition.ConfidenceInterval.ConfidenceInterval(ConfidenceIntervalEnum.L_DOUBTUNDER)) == 20.0
step Minimum safe front end
sub Sub-step1
expect efs: Kernel.TrainPosition.FrontEndPosition(DistanceIntervalEnum.Min) == 1741.0
expect efs: BaseTypes.LengthToDistance(Kernel.TrainPosition.ConfidenceInterval.ConfidenceInterval(ConfidenceIntervalEnum.L_DOUBTOVER)) == 19.0
case Additional over-reading amount
clause - absent 3.6.4.7.1 ; efs 3.6.4.7.1
step Additional over-reading amount
sub Sub-step1
efs: BTM.LRBG.UnlinkedBGPosition.OverReadingAmountOdo <- 2.0
expect efs: Kernel.TrainPosition.ConfidenceInterval.AdditionalOverReadingAmount() == 6.0
case Additional under-reading amount
clause - absent 3.6.4.7.1 ; efs 3.6.4.7.1
step Additional under-reading amount
sub Sub-step1
efs: BTM.LRBG.UnlinkedBGPosition.UnderReadingAmountOdo <- 2.0
expect efs: Kernel.TrainPosition.ConfidenceInterval.AdditionalUnderReadingAmount() == 7.0
case Additional confidence interval
clause - absent 3.6.4.7.1 ; efs 3.6.4.7.1
step L_DOUBTOVER
sub Sub-step1
expect efs: Kernel.TrainPosition.ConfidenceInterval.AdditionalConfidenceInterval(ConfidenceIntervalEnum.L_DOUBTOVER) == Kernel.TrainPosition.ConfidenceInterval.AdditionalOverReadingAmount() + BTM.LRBGLocationAccuracy()
step L_DOUBTUNDER
sub Sub-step1
expect efs: Kernel.TrainPosition.ConfidenceInterval.AdditionalConfidenceInterval(ConfidenceIntervalEnum.L_DOUBTUNDER) == Kernel.TrainPosition.ConfidenceInterval.AdditionalUnderReadingAmount() + BTM.LRBGLocationAccuracy()
