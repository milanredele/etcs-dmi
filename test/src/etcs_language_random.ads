--  ETCS on-board (EVC)
--  Random valid packets and round trips, for evc_test.
--
--  GENERATED by evc/language/gen_language.py from
--  evc/language/etcs_language.toml. Do not edit: change the TOML and run
--  python3 evc/language/gen_language.py (--check verifies).
--
--  Host only (test/src): not SPARK, not in the on-board. For every
--  packet of the catalogue: fill a record with valid values chosen
--  by mode (the smallest, the largest, random ones: min .. max and
--  the special values of each variable), loops by count mode,
--  every Has_ flag by its condition; encode, decode, compare. The
--  conditions and loops met are recorded for the coverage checks.

with Interfaces;
with ETCS_Bits;
with ETCS_Catalogue;

package ETCS_Language_Random is

   type Value_Mode_T is (Min_Values, Max_Values, Random_Values);
   --  Loops: no item, one item, the maximum for the outermost
   --  loops (one item for the nested ones), a random count
   type Count_Mode_T is (No_Items, One_Item, Max_Items, Random_Items);

   type Result_T is
     (Passed,          -- decoded equals encoded
      Too_Long,        -- more than L_PACKET or the writer can hold
      Encode_Failed,
      Decode_Failed,
      Length_Differs,  -- decoded length is not the encoded length
      Record_Differs);

   procedure Reset (Seed : Interfaces.Unsigned_32);

   --  Fill, encode, decode and compare one packet of Kind
   procedure Round_Trip (Kind   : ETCS_Catalogue.Known_Kind_T;
                         Values : Value_Mode_T;
                         Counts : Count_Mode_T;
                         Result : out Result_T;
                         Bits   : out Natural);

   --  Append a filled packet of Kind to W
   procedure Write_Random (Kind   : ETCS_Catalogue.Known_Kind_T;
                           Values : Value_Mode_T;
                           Counts : Count_Mode_T;
                           W      : in out ETCS_Bits.Writer;
                           OK     : out Boolean);

   Condition_Count : constant := 35;
   function Condition_Name (C : Positive) return String;
   --  The condition was met holding (Value True) or not
   function Condition_Seen (C : Positive; Value : Boolean) return Boolean;

   type Items_T is (None, One, Maximum);
   Loop_Count : constant := 15;
   function Loop_Name (L : Positive) return String;
   --  1 for a loop of the packet, 2 for a loop in a loop, ...
   function Loop_Depth (L : Positive) return Positive;
   function Loop_Seen (L : Positive; Items : Items_T) return Boolean;

   procedure Clear_Coverage;

end ETCS_Language_Random;
